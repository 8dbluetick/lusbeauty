<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg_cream | default: '#FAF7F2' }}">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Lush Beauty">
    <meta name="format-detection" content="telephone=no">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="Shop 100% genuine skincare, cosmetics, luxury designer handbags, fragrances and beauty accessories at Lush Beauty Mart, Nagpur.">
    {% endif %}

    <!-- Pinterest Domain Verification -->
    <meta name="p:domain_verify" content="cd065e03f49b9472cb8465ca29f0fe0c">

    <!-- Google Fonts for Luxury Editorial Feel -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Open Graph Meta Tags -->
    {% render 'meta-tags' %}

    <!-- LocalBusiness Structured Data JSON-LD for Nagpur Store -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BeautySalon",
      "name": "Lush Beauty Mart",
      "image": "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop",
      "@id": "https://lushbeautymart.in",
      "url": "{{ shop.url }}",
      "telephone": "+919119595951",
      "priceRange": "₹₹",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Below Hotel Maitrayee, Near Lad Square, Metro Station Pillar No. 213, 214, North Ambazari Road, Gandhi Nagar",
        "addressLocality": "Nagpur",
        "postalCode": "440010",
        "addressRegion": "Maharashtra",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 21.1396,
        "longitude": 79.0594
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "10:30",
          "closes": "21:30"
        }
      ],
      "sameAs": [
        "https://www.instagram.com/lushbeautymart"
      ]
    }
    </script>

    {{ content_for_header }}

    <script>
      window.theme = window.theme || {};
      window.theme.moneyFormat = {{ shop.money_format | json }};
    </script>

    <!-- Theme Stylesheet -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="lush-theme-body">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      Skip to content
    </a>

    <!-- Top Announcement Bar -->
    {% section 'announcement-bar' %}

    <!-- Sticky Header -->
    {% section 'header' %}

    <!-- Main Content Area -->
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer -->
    {% section 'footer' %}

    <!-- Reusable Cart Drawer -->
    {% render 'cart-drawer' %}

    <!-- Reusable Wishlist Drawer -->
    {% render 'wishlist-drawer' %}

    <!-- Luxury Add-to-Bag Toast Notification -->
    {% render 'toast-notification' %}

    <!-- Quick View Product Modal -->
    {% render 'quick-view-modal' %}

    <!-- Live Predictive Search Modal -->
    {% render 'search-modal' %}

    <!-- Floating Interactive WhatsApp Widget -->
    {% render 'whatsapp-widget' %}

    <!-- Top Reading/Scroll Progress Bar -->
    <div class="scroll-progress-bar" id="ScrollProgressBar" aria-hidden="true"></div>

    <!-- Floating Back-to-Top Button -->
    <button type="button" class="btn-back-to-top" id="BackToTopBtn" title="Back to top" aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <!-- Spin to Win Fortune Wheel (Home Page Only) -->
    {%- if template.name == 'index' -%}
      {{ 'spin-wheel.css' | asset_url | stylesheet_tag }}
      {% section 'spin-wheel-popup' %}
      {{ 'spin-wheel.js' | asset_url | script_tag }}
    {%- endif -%}

    <!-- Loyalty Wallet Stylesheet -->
    {{ 'wallet.css' | asset_url | stylesheet_tag }}

    <!-- Live Order Tracking Stylesheet & Script -->
    {{ 'track-order.css' | asset_url | stylesheet_tag }}
    {{ 'track-order.js' | asset_url | script_tag }}

    <!-- Mobile Native App Bottom Dock (iOS/Android App Navigation) -->
    {% render 'mobile-app-dock' %}

    <!-- Theme JavaScript -->
    {{ 'theme.js' | asset_url | script_tag }}

    <!-- Loyalty Wallet JavaScript -->
    {{ 'wallet.js' | asset_url | script_tag }}
  </body>
</html>
