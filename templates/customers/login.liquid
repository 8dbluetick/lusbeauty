{% comment %}
  Lush Beauty Mart — Customer Login & Password Recovery Template
{% endcomment %}

<div class="customer-auth-wrapper" style="max-width: 480px; margin: 50px auto 80px; padding: 0 16px; min-height: 60vh;">
  <div style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 20px; padding: 36px 28px; box-shadow: 0 8px 30px rgba(31, 22, 16, 0.05); text-align: center;">
    <span style="font-size: 2rem; display: block; margin-bottom: 8px;">👑</span>
    <h1 style="font-family: var(--font-serif); font-size: 1.8rem; font-weight: 800; color: #1F1610; margin-bottom: 6px;">Sign In to Lush</h1>
    <p style="font-size: 0.82rem; color: #6E5E52; margin-bottom: 24px;">Access your loyalty points wallet, order history & exclusive VIP perks.</p>

    <!-- Login Form -->
    <div id="CustomerLoginForm">
      {%- form 'customer_login' -%}
        {%- if form.errors -%}
          <div style="background: #FFEBEE; color: #C62828; padding: 10px 14px; border-radius: 8px; font-size: 0.78rem; font-weight: 700; margin-bottom: 16px; text-align: left;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="margin-bottom: 14px; text-align: left;">
          <label for="CustomerEmail" style="display: block; font-size: 0.75rem; font-weight: 700; color: #1F1610; text-transform: uppercase; margin-bottom: 6px;">Email Address</label>
          <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off" required placeholder="Enter your email" style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box;">
        </div>

        <div style="margin-bottom: 20px; text-align: left;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <label for="CustomerPassword" style="font-size: 0.75rem; font-weight: 700; color: #1F1610; text-transform: uppercase;">Password</label>
            <a href="#recover" onclick="document.getElementById('CustomerLoginForm').style.display='none'; document.getElementById('RecoverPasswordForm').style.display='block'; return false;" style="font-size: 0.72rem; color: #C5A059; font-weight: 700; text-decoration: none;">Forgot password?</a>
          </div>
          <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password" required placeholder="••••••••" style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box;">
        </div>

        <button type="submit" style="width: 100%; padding: 14px; background: #1F1610; color: #C5A059; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; border: none; border-radius: 10px; cursor: pointer; transition: all 0.2s ease;">
          Sign In
        </button>

        <div style="margin-top: 20px; padding-top: 18px; border-top: 1px solid #F3EDE7; font-size: 0.82rem; color: #6E5E52;">
          Don't have an account yet? 
          <a href="/account/register" style="color: #C5A059; font-weight: 800; text-decoration: none;">Create Account →</a>
        </div>
      {%- endform -%}
    </div>

    <!-- Password Recovery Form (Hidden by default) -->
    <div id="RecoverPasswordForm" style="display: none;">
      {%- form 'recover_customer_password' -%}
        {%- if form.errors -%}
          <div style="background: #FFEBEE; color: #C62828; padding: 10px 14px; border-radius: 8px; font-size: 0.78rem; font-weight: 700; margin-bottom: 16px; text-align: left;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div style="margin-bottom: 18px; text-align: left;">
          <label for="RecoverEmail" style="display: block; font-size: 0.75rem; font-weight: 700; color: #1F1610; text-transform: uppercase; margin-bottom: 6px;">Your Registered Email</label>
          <input type="email" name="email" id="RecoverEmail" autocorrect="off" autocapitalize="off" required placeholder="Enter your email" style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box;">
        </div>

        <button type="submit" style="width: 100%; padding: 14px; background: #1F1610; color: #C5A059; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; border: none; border-radius: 10px; cursor: pointer; margin-bottom: 12px;">
          Send Reset Instructions
        </button>

        <a href="#login" onclick="document.getElementById('RecoverPasswordForm').style.display='none'; document.getElementById('CustomerLoginForm').style.display='block'; return false;" style="font-size: 0.78rem; color: #6E5E52; font-weight: 700; text-decoration: underline;">
          Cancel and return to Sign In
        </a>
      {%- endform -%}
    </div>
  </div>
</div>
