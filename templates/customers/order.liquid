{% comment %}
  Lush Beauty Mart — Single Order Details Template
{% endcomment %}

<div class="customer-order-page" style="max-width: 900px; margin: 40px auto 80px; padding: 0 16px; min-height: 60vh;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1.5px solid #EAE3DA;">
    <div>
      <h1 style="font-family: var(--font-serif); font-size: 1.8rem; font-weight: 800; color: #1F1610; margin: 0 0 4px;">Order {{ order.name }}</h1>
      <p style="font-size: 0.82rem; color: #6E5E52; margin: 0;">Placed on {{ order.created_at | date: "%d %B %Y at %I:%M %p" }}</p>
    </div>
    <a href="/account" style="font-size: 0.8rem; font-weight: 800; color: #C5A059; text-decoration: none;">← Back to All Orders</a>
  </div>

  <div style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 16px; overflow: hidden; margin-bottom: 24px;">
    <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
      <thead>
        <tr style="background: #FAF7F2; border-bottom: 1px solid #EAE3DA; text-align: left;">
          <th style="padding: 14px 16px; font-weight: 800; color: #1F1610;">Product</th>
          <th style="padding: 14px 16px; font-weight: 800; color: #1F1610;">SKU</th>
          <th style="padding: 14px 16px; font-weight: 800; color: #1F1610;">Price</th>
          <th style="padding: 14px 16px; font-weight: 800; color: #1F1610;">Qty</th>
          <th style="padding: 14px 16px; font-weight: 800; color: #1F1610; text-align: right;">Total</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr style="border-bottom: 1px solid #F3EDE7;">
            <td style="padding: 14px 16px; font-weight: 700; color: #1F1610;">
              {{ line_item.title }}
            </td>
            <td style="padding: 14px 16px; color: #8A7363; font-family: monospace;">{{ line_item.sku | default: '—' }}</td>
            <td style="padding: 14px 16px;">{{ line_item.price | money }}</td>
            <td style="padding: 14px 16px;">{{ line_item.quantity }}</td>
            <td style="padding: 14px 16px; text-align: right; font-weight: 800; color: #1F1610;">{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
      <tfoot>
        <tr style="border-top: 1px solid #EAE3DA;">
          <td colspan="4" style="padding: 12px 16px; font-weight: 700; text-align: right;">Subtotal:</td>
          <td style="padding: 12px 16px; text-align: right; font-weight: 800;">{{ order.line_items_subtotal_price | money }}</td>
        </tr>
        <tr>
          <td colspan="4" style="padding: 12px 16px; font-weight: 700; text-align: right;">Shipping:</td>
          <td style="padding: 12px 16px; text-align: right; font-weight: 800;">{{ order.shipping_price | money }}</td>
        </tr>
        <tr style="background: #FAF7F2; font-size: 1rem;">
          <td colspan="4" style="padding: 14px 16px; font-weight: 800; color: #1F1610; text-align: right;">Total:</td>
          <td style="padding: 14px 16px; text-align: right; font-weight: 900; color: #C5A059;">{{ order.total_price | money }}</td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
