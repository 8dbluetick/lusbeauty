{% comment %}
  Lush Beauty Mart — Customer Registration / Sign Up Template
{% endcomment %}

<div class="customer-auth-wrapper" style="max-width: 480px; margin: 50px auto 80px; padding: 0 16px; min-height: 60vh;">
  <div style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 20px; padding: 36px 28px; box-shadow: 0 8px 30px rgba(31, 22, 16, 0.05); text-align: center;">
    <span style="font-size: 2rem; display: block; margin-bottom: 8px;">✨</span>
    <h1 style="font-family: var(--font-serif); font-size: 1.8rem; font-weight: 800; color: #1F1610; margin-bottom: 6px;">Create an Account</h1>
    <p style="font-size: 0.82rem; color: #6E5E52; margin-bottom: 24px;">Sign up today & receive <strong>50 Free Lush Points</strong> in your rewards wallet.</p>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div style="background: #FFEBEE; color: #C62828; padding: 10px 14px; border-radius: 8px; font-size: 0.78rem; font-weight: 700; margin-bottom: 16px; text-align: left;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; text-align: left;">
        <div>
          <label for="FirstName" style="display: block; font-size: 0.72rem; font-weight: 700; color: #1F1610; text-transform: uppercase; margin-bottom: 6px;">First Name</label>
          <input type="text" name="customer[first_name]" id="FirstName" placeholder="Priya" required style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box;">
        </div>
        <div>
          <label for="LastName" style="display: block; font-size: 0.72rem; font-weight: 700; color: #1F1610; text-transform: uppercase; margin-bottom: 6px;">Last Name</label>
          <input type="text" name="customer[last_name]" id="LastName" placeholder="Sharma" required style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box;">
        </div>
      </div>

      <div style="margin-bottom: 14px; text-align: left;">
        <label for="RegisterEmail" style="display: block; font-size: 0.72rem; font-weight: 700; color: #1F1610; text-transform: uppercase; margin-bottom: 6px;">Email Address</label>
        <input type="email" name="customer[email]" id="RegisterEmail" placeholder="yourname@gmail.com" required style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box;">
      </div>

      <div style="margin-bottom: 20px; text-align: left;">
        <label for="RegisterPassword" style="display: block; font-size: 0.72rem; font-weight: 700; color: #1F1610; text-transform: uppercase; margin-bottom: 6px;">Create Password</label>
        <input type="password" name="customer[password]" id="RegisterPassword" placeholder="Minimum 6 characters" required minlength="6" style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box;">
      </div>

      <button type="submit" style="width: 100%; padding: 14px; background: #1F1610; color: #C5A059; font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; border: none; border-radius: 10px; cursor: pointer; transition: all 0.2s ease;">
        Create Account & Join VIP
      </button>

      <div style="margin-top: 20px; padding-top: 18px; border-top: 1px solid #F3EDE7; font-size: 0.82rem; color: #6E5E52;">
        Already have an account? 
        <a href="/account/login" style="color: #C5A059; font-weight: 800; text-decoration: none;">Sign In →</a>
      </div>
    {%- endform -%}
  </div>
</div>
