{% comment %}
  Lush Beauty Mart — Luxury Live Order Tracking Section
  Embedded with Official Shadowfax 360 Tracking Portal (https://www.shadowfax.in/track)
{% endcomment %}

<div class="lush-track-page-wrap">
  <div class="page-width track-page-container">
    <!-- Header Hero Banner -->
    <div class="track-hero-card">
      <div class="track-badge-pill">
        <span>🚚 OFFICIAL SHADOWFAX 360 LIVE TRACKING</span>
      </div>
      <h1 class="track-page-title">{{ section.settings.heading | default: 'Track Your Order Live' }}</h1>
      <p class="track-page-subtitle">{{ section.settings.subheading | default: 'Track your shipment directly through the official Shadowfax 360 courier network in real-time.' }}</p>
    </div>

    <!-- Main Embedded Shadowfax Tracker Card -->
    <div class="track-card-main">
      <div class="shadowfax-embedded-container">
        <div class="shadowfax-frame-header">
          <div class="shadowfax-brand-pill">
            <img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1788442633/0x0_usqks6.png" alt="Shadowfax Delivery Partner" height="26">
            <span>Official Express Courier Portal</span>
          </div>
          <a href="https://www.shadowfax.in/track" target="_blank" rel="noopener noreferrer" class="btn-open-external-shadowfax" title="Open in Shadowfax Portal in new window">
            Open in Full Screen ↗
          </a>
        </div>
        <iframe
          src="https://www.shadowfax.in/track"
          title="Shadowfax Live Order Tracking"
          class="shadowfax-track-iframe"
          loading="lazy"
          allow="geolocation"
        ></iframe>
      </div>

      <!-- Quick Order ID & WhatsApp Help Fallback -->
      <div class="track-order-help-strip" style="margin-top: 24px; padding: 20px; background: #FFFFFF; border: 1.5px solid #EAE3DA; border-radius: 16px; text-align: center;">
        <h3 style="font-family: var(--font-serif); font-size: 1.2rem; color: #1F1610; margin: 0 0 8px;">Don't have your Shadowfax AWB number yet?</h3>
        <p style="font-size: 0.85rem; color: #6E5E52; margin: 0 0 16px;">Share your Order ID on WhatsApp and our Nagpur fulfillment desk will instantly share your live courier AWB and status.</p>
        <a href="https://wa.me/919119595951?text=Namaste%20Lush%20Beauty%20Mart!%20%F0%9F%8C%B8%20I%20want%20to%20check%20the%20Shadowfax%20tracking%20status%20of%20my%20order." target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 8px; background: #0F7A42; color: #FFFFFF; padding: 12px 24px; border-radius: 999px; font-size: 0.88rem; font-weight: 700; text-decoration: none;">
          <span>💬 Instant WhatsApp Order Status (+91 91195 95951)</span>
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Track Order Page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Track Your Order Live"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Track your shipment directly through the official Shadowfax 360 courier network in real-time."
    }
  ]
}
{% endschema %}
