<section class="lush-hero-section" style="background: linear-gradient(180deg, {{ section.settings.bg_color | default: '#FAF7F2' }} 0%, #FAF4EB 100%);">
  <div class="hero-bg-glow"></div>

  {%- if section.settings.show_promo_banner and section.settings.promo_banner_image != blank -%}
    <!-- Dedicated Responsive Hero Promotional Banner (Zero-Overlap Flow) -->
    <div class="hero-promo-banner-wrap">
      <div class="page-width hero-promo-container">
        <a href="{{ section.settings.promo_banner_link | default: '/collections/all' }}" class="hero-promo-banner-link" aria-label="{{ section.settings.promo_banner_alt | default: 'Lush Beauty Mart Festive Promotion' | escape }}">
          <img
            src="{{ section.settings.promo_banner_image }}"
            alt="{{ section.settings.promo_banner_alt | default: 'Lush Beauty Mart Luxury Special Offer' | escape }}"
            class="hero-promo-banner-img"
            width="1280"
            height="720"
            loading="eager"
            fetchpriority="high"
          >
        </a>
      </div>
    </div>
  {%- endif -%}

  <div class="page-width hero-container">
    <div class="hero-grid">
      <!-- Left Column: Typography & CTAs -->
      <div class="hero-content">
        <!-- Nagpur Store Pill -->
        {%- if section.settings.badge_text != blank -%}
          <div class="hero-store-pill">
            <span class="pulse-dot"></span>
            <span class="pill-text">{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        <h1 class="hero-headline">
          {{ section.settings.heading | default: "Beauty, Style & Everything You Love." }}
        </h1>

        <p class="hero-subheading">
          {{ section.settings.subheading | default: "Discover dermatological skincare, luxury cosmetics, designer handbags, fragrances and beauty accessories — all under one roof." }}
        </p>

        <div class="hero-cta-group">
          {%- if section.settings.primary_cta_text != blank -%}
            <a href="{{ section.settings.primary_cta_link | default: '/collections/all' }}" class="btn-hero-primary">
              <span>{{ section.settings.primary_cta_text }}</span>
              <span class="btn-arrow">→</span>
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_cta_text != blank -%}
            <a href="{{ section.settings.secondary_cta_link | default: '#store-section' }}" class="btn-hero-secondary">
              <span>{{ section.settings.secondary_cta_text }}</span>
            </a>
          {%- endif -%}
        </div>

        <!-- Trust Badges Strip (Blocks) -->
        <div class="hero-trust-badges">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="trust-badge-item" {{ block.shopify_attributes }}>
                <span class="badge-icon">{{ block.settings.icon }}</span>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="badge-text-link">
                    <span class="badge-text">{{ block.settings.title }}</span>
                  </a>
                {%- else -%}
                  <span class="badge-text">{{ block.settings.title }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="trust-badge-item">
              <span class="badge-icon">🛡️</span>
              <span class="badge-text">100% Genuine Brands</span>
            </div>
            <div class="trust-badge-item">
              <span class="badge-icon">📍</span>
              <span class="badge-text">Nagpur Store</span>
            </div>
            <div class="trust-badge-item">
              <span class="badge-icon">🚇</span>
              <span class="badge-text">Near Metro Pillar 213–214</span>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Right Column: Premium 9:16 Vertical Story Video Hero Media -->
      <div class="hero-media">
        {%- assign show_video = false -%}
        {%- if section.settings.media_type == 'video' or section.settings.media_type == blank -%}
          {%- if section.settings.video_url != blank -%}
            {%- assign show_video = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- if show_video -%}
          <div class="hero-video-card">
            <video
              class="hero-video-media"
              src="{{ section.settings.video_url | default: 'https://res.cloudinary.com/dsqxboxoc/video/upload/v1787312722/angelpeterr__14050530_171336862_qanvrp.mp4' }}"
              autoplay
              muted
              loop
              playsinline
              preload="auto"
            ></video>
          </div>
        {%- else -%}
          <div class="hero-image-card">
            {%- if section.settings.image != blank -%}
              <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" class="hero-img-main" width="800" height="1000">
            {%- else -%}
              <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1000&auto=format&fit=crop" alt="Lush Beauty Mart Collection" class="hero-img-main" width="800" height="1000">
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Promotional Banner (Top of Hero)"
    },
    {
      "type": "checkbox",
      "id": "show_promo_banner",
      "label": "Show Promotional Banner",
      "default": false
    },
    {
      "type": "text",
      "id": "promo_banner_image",
      "label": "Promotional Banner Image URL"
    },
    {
      "type": "url",
      "id": "promo_banner_link",
      "label": "Promotional Banner Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "promo_banner_alt",
      "label": "Banner Alt Text",
      "default": "Lush Beauty Mart Special Collection"
    },
    {
      "type": "header",
      "content": "Hero Content & Messaging"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Location Pill Badge",
      "default": "📍 Nagpur Premier Store • Gandhi Nagar (Near Lad Sq.)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Beauty, Style & Everything You Love."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover dermatological skincare, luxury cosmetics, designer handbags, fragrances and beauty accessories — all under one roof."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary Button Text",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary Button Link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary Button Text",
      "default": "📍 Visit Nagpur Store"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Hero Media (9:16 Video / Image)"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        { "value": "video", "label": "Vertical 9:16 Video" },
        { "value": "image", "label": "Image" }
      ],
      "default": "video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Hero Video URL (MP4 / Cloudinary)",
      "default": "https://res.cloudinary.com/dsqxboxoc/video/upload/v1787312722/angelpeterr__14050530_171336862_qanvrp.mp4"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Hero Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (Emoji)",
          "default": "🛡️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Genuine Brands"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": {
            "icon": "🛡️",
            "title": "100% Genuine Brands"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "📍",
            "title": "Nagpur Store"
          }
        },
        {
          "type": "trust_badge",
          "settings": {
            "icon": "🚇",
            "title": "Near Metro Pillar 213–214"
          }
        }
      ]
    }
  ]
}
{% endschema %}
