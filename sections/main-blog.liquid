{% comment %}
  Lush Beauty Mart — Main Blog & Editorial Journal Section
{% endcomment %}

<div class="main-blog-section" style="max-width: 1200px; margin: 40px auto 80px; padding: 0 16px; min-height: 60vh;">
  <!-- Blog Header -->
  <div style="text-align: center; max-width: 700px; margin: 0 auto 40px;">
    <span style="display: inline-block; padding: 4px 14px; background: rgba(197, 160, 89, 0.15); border: 1px solid rgba(197, 160, 89, 0.35); border-radius: 999px; font-size: 0.72rem; font-weight: 800; color: #8B6F3E; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 10px;">
      🌸 THE LUSH BEAUTY JOURNAL
    </span>
    <h1 style="font-family: var(--font-serif); font-size: 2.2rem; font-weight: 800; color: #1F1610; margin: 0 0 10px;">{{ blog.title }}</h1>
    <p style="font-size: 0.88rem; color: #6E5E52; margin: 0;">Skincare routines, beauty insights, ingredient guides & luxury fragrance edits.</p>
  </div>

  {%- paginate blog.articles by 9 -%}
    {%- if blog.articles.size > 0 -%}
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 28px;">
        {%- for article in blog.articles -%}
          <article style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 18px rgba(31, 22, 16, 0.04);">
            {%- if article.image -%}
              <a href="{{ article.url }}" style="display: block; aspect-ratio: 16/10; overflow: hidden;">
                <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
              </a>
            {%- endif -%}
            <div style="padding: 20px; display: flex; flex-direction: column; flex: 1;">
              <span style="font-size: 0.72rem; color: #8A7363; margin-bottom: 8px;">{{ article.published_at | date: "%B %d, %Y" }}</span>
              <h2 style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 800; color: #1F1610; margin: 0 0 10px; line-height: 1.35;">
                <a href="{{ article.url }}" style="color: #1F1610; text-decoration: none;">{{ article.title }}</a>
              </h2>
              <p style="font-size: 0.8rem; color: #6E5E52; line-height: 1.5; margin: 0 0 16px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {{ article.excerpt_or_content | strip_html }}
              </p>
              <div style="margin-top: auto;">
                <a href="{{ article.url }}" style="font-size: 0.78rem; font-weight: 800; color: #C5A059; text-decoration: none;">Read Full Article →</a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {{ paginate | default_pagination }}
    {%- else -%}
      <div style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 16px; padding: 60px 20px; text-align: center;">
        <span style="font-size: 3rem; display: block; margin-bottom: 12px;">✍️</span>
        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; font-weight: 800; color: #1F1610; margin-bottom: 6px;">Editorial Articles Coming Soon</h3>
        <p style="font-size: 0.85rem; color: #6E5E52; margin-bottom: 20px;">Our beauty editors are crafting authentic guides on Indian skincare & luxury routines.</p>
        <a href="/collections/all" style="display: inline-block; padding: 12px 24px; background: #1F1610; color: #C5A059; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; border-radius: 8px; text-decoration: none;">Explore Products →</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog Posts",
  "settings": []
}
{% endschema %}
