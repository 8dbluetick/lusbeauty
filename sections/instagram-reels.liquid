<section class="lush-reels-section" id="lush-reels-section">
  <div class="page-width">
    <!-- Header -->
    <div class="reels-header-wrap">
      <div class="reels-title-left">
        <div class="reels-pill-badge">
          <span class="reels-camera-icon">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
            </svg>
          </span>
          <span class="pulse-live"></span>
          <span>WATCH ON INSTAGRAM</span>
        </div>
        <h2 class="section-title">{{ section.settings.heading | default: "Trending Reels & Video Stories" }}</h2>
        <p class="section-subtitle">{{ section.settings.subheading | default: "Real unboxings, store walkthroughs, and bridal makeovers straight from our Nagpur showroom." }}</p>
      </div>

      <div class="reels-header-right">
        <div class="reels-nav-buttons">
          <button type="button" class="btn-reel-nav" data-reel-prev aria-label="Previous Reels">←</button>
          <button type="button" class="btn-reel-nav" data-reel-next aria-label="Next Reels">→</button>
        </div>
        <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="btn-insta-profile">
          <span class="insta-gradient-icon">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </span>
          <span>{{ settings.social_instagram_handle | default: "@lushbeautymart" }}</span>
        </a>
      </div>
    </div>

    <!-- Reels Track Carousel -->
    <div class="reels-carousel-track no-scrollbar" id="ReelsTrack" data-reels-track>
      <!-- Reel 1: Explore with Shruti Store Walkthrough (Video) -->
      <div class="reel-card-item group" data-reel-type="video" data-video-src="https://res.cloudinary.com/dsqxboxoc/video/upload/v1787301075/explore.with_shruti_14050530_135038188_yhjyo2.mp4" data-caption="Store Tour & Shopping Experience at Lush Beauty Mart Nagpur with @explore.with_shruti ✨" data-product="Nagpur Showroom Tour">
        <div class="reel-media-wrapper">
          <video
            class="reel-video-element"
            src="https://res.cloudinary.com/dsqxboxoc/video/upload/v1787301075/explore.with_shruti_14050530_135038188_yhjyo2.mp4"
            poster="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300602/lushbeautymart_14050530_135039469_kdl5zs.webp"
            muted
            loop
            playsinline
            preload="metadata"
          ></video>
          <div class="reel-gradient-overlay"></div>

          <!-- Top Reel Badges -->
          <div class="reel-top-badges">
            <span class="badge-reel-live">
              <span class="sound-wave-bars">
                <span></span><span></span><span></span>
              </span>
              <span>VIRAL REEL</span>
            </span>
            <button type="button" class="btn-reel-sound-toggle" aria-label="Toggle sound">
              <span class="icon-sound-muted">🔇</span>
              <span class="icon-sound-on">🔊</span>
            </button>
          </div>

          <!-- Play Center Hover Button -->
          <div class="reel-play-center">
            <div class="reel-play-btn-circle">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="#FFFFFF">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>

          <!-- Reel Bottom Details -->
          <div class="reel-bottom-info">
            <div class="reel-handle-tag">
              <span class="tag-dot"></span>
              <span>@explore.with_shruti × @lushbeautymart</span>
            </div>
            <p class="reel-caption-text">Shopping tour & exclusive finds at Nagpur's biggest beauty hub 🏬</p>
            <div class="reel-action-bar">
              <span class="reel-shop-pill">
                <span>Watch Reel & Visit</span>
                <span class="arrow-right">→</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Reel 2: Angel Peter Glamour Video -->
      <div class="reel-card-item group" data-reel-type="video" data-video-src="https://res.cloudinary.com/dsqxboxoc/video/upload/v1787300962/angelpeterr__14050530_135035349_b9xjrn.mp4" data-caption="Luxury Beauty & Glamour at Lush Beauty Mart Nagpur ✨" data-product="Cosmetics & Skincare">
        <div class="reel-media-wrapper">
          <video
            class="reel-video-element"
            src="https://res.cloudinary.com/dsqxboxoc/video/upload/v1787300962/angelpeterr__14050530_135035349_b9xjrn.mp4"
            poster="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300602/lushbeautymart_14050530_135039469_kdl5zs.webp"
            muted
            loop
            playsinline
            preload="metadata"
          ></video>
          <div class="reel-gradient-overlay"></div>

          <!-- Top Reel Badges -->
          <div class="reel-top-badges">
            <span class="badge-reel-live">
              <span class="sound-wave-bars">
                <span></span><span></span><span></span>
              </span>
              <span>REEL</span>
            </span>
            <button type="button" class="btn-reel-sound-toggle" aria-label="Toggle sound">
              <span class="icon-sound-muted">🔇</span>
              <span class="icon-sound-on">🔊</span>
            </button>
          </div>

          <!-- Play Center Hover Button -->
          <div class="reel-play-center">
            <div class="reel-play-btn-circle">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="#FFFFFF">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>

          <!-- Reel Bottom Details -->
          <div class="reel-bottom-info">
            <div class="reel-handle-tag">
              <span class="tag-dot"></span>
              <span>@angelpeterr_ × @lushbeautymart</span>
            </div>
            <p class="reel-caption-text">Glamour makeup & luxury beauty picks in-store in Nagpur 💫</p>
            <div class="reel-action-bar">
              <span class="reel-shop-pill">
                <span>Watch Reel & Shop</span>
                <span class="arrow-right">→</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Reel 3: Cloudinary WebP Visual Story -->
      <div class="reel-card-item group" data-reel-type="image" data-image-src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300602/lushbeautymart_14050530_135039469_kdl5zs.webp" data-caption="Trending Cosmetics & Bags Spotlight ✨" data-product="Designer Handbags & Lipsticks">
        <div class="reel-media-wrapper">
          <img
            src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300602/lushbeautymart_14050530_135039469_kdl5zs.webp"
            alt="Lush Beauty Mart Nagpur Reel"
            class="reel-image-element"
            loading="lazy"
            width="450"
            height="800"
          >
          <div class="reel-gradient-overlay"></div>

          <div class="reel-top-badges">
            <span class="badge-reel-story">
              <span>✨ STORY</span>
            </span>
          </div>

          <div class="reel-play-center">
            <div class="reel-play-btn-circle">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="#FFFFFF">
                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
              </svg>
            </div>
          </div>

          <div class="reel-bottom-info">
            <div class="reel-handle-tag">
              <span class="tag-dot"></span>
              <span>@lushbeautymart</span>
            </div>
            <p class="reel-caption-text">Unboxing premium cosmetics & designer handbags in-store ✨</p>
            <div class="reel-action-bar">
              <span class="reel-shop-pill">
                <span>View Story</span>
                <span class="arrow-right">→</span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Reel 4: Luxury Designer Bags & Clutches -->
      <div class="reel-card-item group" data-reel-type="image" data-image-src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?q=80&w=800&auto=format&fit=crop" data-caption="Designer Handbags & Party Clutches ✨" data-product="Designer Handbag">
        <div class="reel-media-wrapper">
          <img
            src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?q=80&w=800&auto=format&fit=crop"
            alt="Designer Handbag Reel"
            class="reel-image-element"
            loading="lazy"
            width="450"
            height="800"
          >
          <div class="reel-gradient-overlay"></div>

          <div class="reel-top-badges">
            <span class="badge-reel-story">
              <span>👜 BAGS</span>
            </span>
          </div>

          <div class="reel-play-center">
            <div class="reel-play-btn-circle">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="#FFFFFF">
                <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
              </svg>
            </div>
          </div>

          <div class="reel-bottom-info">
            <div class="reel-handle-tag">
              <span class="tag-dot"></span>
              <span>@lushbeautymart</span>
            </div>
            <p class="reel-caption-text">Luxury tote bags & clutches for party and festive season ✨</p>
            <div class="reel-action-bar">
              <span class="reel-shop-pill">
                <span>View Story</span>
                <span class="arrow-right">→</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Full-Screen Interactive Reel Modal Viewer -->
  <div class="reel-modal-overlay" id="ReelModalOverlay" aria-hidden="true">
    <div class="reel-modal-backdrop" id="BtnCloseReelModal"></div>
    <div class="reel-modal-dialog">
      <button type="button" class="btn-close-reel-modal" id="BtnCloseReelModalX" aria-label="Close Reel">&times;</button>
      <div class="reel-modal-player-card">
        <div class="reel-modal-media-holder" id="ReelModalMediaHolder">
          <!-- Dynamic Video or Image Injected Here -->
        </div>

        <div class="reel-modal-sidebar">
          <div class="reel-modal-author">
            <div class="reel-avatar-ring">
              <span class="reel-avatar-letter">L</span>
            </div>
            <div>
              <h4 class="reel-modal-user">lushbeautymart</h4>
              <p class="reel-modal-loc">Nagpur Store • Lad Square</p>
            </div>
          </div>

          <div class="reel-modal-caption-box">
            <p id="ReelModalCaption" class="reel-modal-caption"></p>
          </div>

          <div class="reel-modal-product-cta">
            <span class="cta-tag">FEATURED IN THIS REEL</span>
            <h5 id="ReelModalProduct" class="cta-product-title">Nagpur Store Collection</h5>
            <div class="reel-cta-buttons">
              <a href="/collections/all" class="btn-reel-shop-now">
                <span>Shop This Look</span>
                <span>→</span>
              </a>
              <a href="https://wa.me/{{ settings.store_whatsapp | default: '919119595951' }}?text={{ 'Hi Lush Beauty Mart! I saw your reel on your website and want to inquire about this product.' | url_encode }}" target="_blank" rel="noopener noreferrer" class="btn-reel-whatsapp">
                <span>Inquire on WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram Reels & Stories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Reels & Video Stories"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real unboxings, store walkthroughs, and bridal makeovers straight from our Nagpur showroom."
    }
  ],
  "presets": [
    {
      "name": "Instagram Reels & Stories"
    }
  ]
}
{% endschema %}
