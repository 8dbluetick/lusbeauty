          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Are all the cosmetics and skincare products 100% genuine?",
            "answer": "Yes, absolutely! We source 100% authentic, verified products directly from authorized brand distributors with genuine batch codes and manufacturer seals."
          }
        },
        {
