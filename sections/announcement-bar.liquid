<div class="lush-announcement-bar">
  <div class="page-width announcement-container">
    <div class="announcement-messages">
      <span class="announcement-item">
        <span class="announcement-dot"></span>
        <span>Nagpur Store • Lad Square</span>
      </span>
      <span class="announcement-sep">•</span>
      <span class="announcement-item">
        <span>Free Delivery in Nagpur on ₹499+</span>
      </span>
      <span class="announcement-sep">•</span>
      <span class="announcement-item">
        <span>100% Genuine Brands</span>
      </span>
      <span class="announcement-sep">•</span>
      <span class="announcement-item">
        <a href="https://wa.me/{{ settings.store_whatsapp | default: '9191195951' }}" target="_blank" rel="noopener noreferrer" class="announcement-link">WhatsApp Ordering</a>
      </span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": []
}
{% endschema %}
