{%- if section.settings.show_announcement -%}
  <div class="lush-announcement-bar" style="background-color: {{ section.settings.bg_color | default: '#1F1610' }}; color: {{ section.settings.text_color | default: '#F7EFE1' }};">
    <div class="announcement-marquee-track" style="animation-duration: {{ section.settings.speed | default: 28 }}s;">
      <!-- Group 1 -->
      <div class="marquee-content">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <span class="marquee-item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="marquee-icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="marquee-link">{{ block.settings.text }}</a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
            <span class="marquee-sep">✦</span>
          {%- endfor -%}
        {%- else -%}
          <span class="marquee-item"><span class="marquee-icon">🚚</span> FREE EXPRESS DELIVERY IN NAGPUR ON ₹999+</span>
          <span class="marquee-sep">✦</span>
          <span class="marquee-item"><span class="marquee-icon">🛡️</span> 100% GENUINE BRANDS</span>
          <span class="marquee-sep">✦</span>
          <span class="marquee-item"><span class="marquee-icon">🏬</span> NAGPUR STORE • NEAR LAD SQ. (METRO PILLAR 213–214)</span>
          <span class="marquee-sep">✦</span>
          <span class="marquee-item"><span class="marquee-icon">👑</span> ROYAL BRIDAL & ARTIFICIAL JEWELLERY</span>
          <span class="marquee-sep">✦</span>
          <span class="marquee-item"><span class="marquee-icon">💬</span> INSTANT WHATSAPP ORDER: +91 91195 95951</span>
          <span class="marquee-sep">✦</span>
        {%- endif -%}
      </div>

      <!-- Group 2 (Duplicate for Seamless Infinite Loop) -->
      <div class="marquee-content" aria-hidden="true">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <span class="marquee-item">
              {%- if block.settings.icon != blank -%}
                <span class="marquee-icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="marquee-link">{{ block.settings.text }}</a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
            <span class="marquee-sep">✦</span>
          {%- endfor -%}
        {%- else -%}
          <span class="marquee-item"><span class="marquee-icon">🚚</span> FREE EXPRESS DELIVERY IN NAGPUR ON ₹999+</span>
          <span class="marquee-sep">✦</span>
          <span class="marquee-item"><span class="marquee-icon">🛡️</span> 100% GENUINE BRANDS</span>
          <span class="marquee-sep">✦</span>
          <span class="marquee-item"><span class="marquee-icon">🏬</span> NAGPUR STORE • NEAR LAD SQ. (METRO PILLAR 213–214)</span>
          <span class="marquee-sep">✦</span>
          <span class="marquee-item"><span class="marquee-icon">👑</span> ROYAL BRIDAL & ARTIFICIAL JEWELLERY</span>
          <span class="marquee-sep">✦</span>
          <span class="marquee-item"><span class="marquee-icon">💬</span> INSTANT WHATSAPP ORDER: +91 91195 95951</span>
          <span class="marquee-sep">✦</span>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Enable Running Announcement Bar",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 15,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scroll Speed (Seconds)",
      "default": 28
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1F1610"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#F7EFE1"
    }
  ],
  "blocks": [
    {
      "type": "announcement_item",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / Emoji",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Message Text",
          "default": "FREE EXPRESS DELIVERY IN NAGPUR ON ₹999+"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement_item",
          "settings": {
            "icon": "🚚",
            "text": "FREE EXPRESS DELIVERY IN NAGPUR ON ₹999+"
          }
        },
        {
          "type": "announcement_item",
          "settings": {
            "icon": "🛡️",
            "text": "100% GENUINE BRANDS"
          }
        },
        {
          "type": "announcement_item",
          "settings": {
            "icon": "🏬",
            "text": "NAGPUR STORE • NEAR LAD SQ. (METRO PILLAR 213–214)"
          }
        },
        {
          "type": "announcement_item",
          "settings": {
            "icon": "👑",
            "text": "ROYAL BRIDAL & ARTIFICIAL JEWELLERY"
          }
        },
        {
          "type": "announcement_item",
          "settings": {
            "icon": "💬",
            "text": "INSTANT WHATSAPP ORDER: +91 91195 95951"
          }
        }
      ]
    }
  ]
}
{% endschema %}
