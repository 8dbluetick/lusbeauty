<div class="lush-main-product-section" data-product-id="{{ product.id }}" id="ProductSection-{{ product.id }}">
  <div class="page-width pdp-container">
    <!-- 1. Breadcrumbs / Navigation -->
    <nav class="product-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="bc-sep">/</span>
      <a href="/collections/all">Shop</a>
      {%- if product.collections.first -%}
        <span class="bc-sep">/</span>
        <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
      {%- endif -%}
      <span class="bc-sep">/</span>
      <span class="bc-current" aria-current="page">{{ product.title | truncate: 35 }}</span>
    </nav>

    {%- assign current_variant = product.selected_or_first_available_variant -%}
    {%- assign featured_img = current_variant.featured_image | default: product.featured_media | default: product.featured_image | default: product.media.first | default: product.images.first -%}

    <div class="main-product-grid">
      <!-- ====================================================================
           LEFT COLUMN: PRODUCT IMAGE GALLERY (APP-LIKE SWIPE ON MOBILE)
           ==================================================================== -->
      <div class="product-gallery-panel">
        <div class="main-image-viewport" id="ProductGalleryViewport">
          <!-- Discount Badge on Gallery -->
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {%- assign disc = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            <span class="badge-stage-discount" data-stage-discount>{{ disc }}% OFF</span>
          {%- else -%}
            <span class="badge-stage-discount" data-stage-discount style="display: none;"></span>
          {%- endif -%}

          <!-- Mobile Image Counter Badge e.g. "1 / 4" -->
          {%- if product.media.size > 1 -%}
            <div class="pdp-gallery-counter" id="PdpGalleryCounter">
              <span id="PdpCurrentSlide">1</span> / <span>{{ product.media.size }}</span>
            </div>
          {%- endif -%}

          <!-- Zoom / Expand Hint Button -->
          <button type="button" class="btn-gallery-zoom" id="BtnOpenLightbox" aria-label="Open fullscreen image viewer" title="Tap to zoom">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 3 21 3 21 9"></polyline>
              <polyline points="9 21 3 21 3 15"></polyline>
              <line x1="21" y1="3" x2="14" y2="10"></line>
              <line x1="3" y1="21" x2="10" y2="14"></line>
            </svg>
          </button>

          <!-- Mobile Swipeable Image Track / Desktop Hero Container -->
          <div class="pdp-media-track no-scrollbar" id="PdpMediaTrack">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <div class="pdp-media-slide {% if forloop.first %}active{% endif %}" data-media-index="{{ forloop.index }}" data-media-id="{{ media.id }}">
                  <img
                    {% if forloop.first %}id="ProductMainImg"{% endif %}
                    src="{{ media | image_url: width: 900 }}"
                    srcset="{{ media | image_url: width: 450 }} 450w, {{ media | image_url: width: 750 }} 750w, {{ media | image_url: width: 1050 }} 1050w"
                    sizes="(max-width: 767px) 100vw, 50vw"
                    alt="{{ media.alt | default: product.title | escape }}"
                    class="pdp-slide-img"
                    width="900"
                    height="900"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    decoding="async"
                  >
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="pdp-media-slide active">
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg pdp-slide-img' }}
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Desktop Thumbnail Strip (Horizontal Scroll / Grid) -->
        {%- if product.media.size > 1 -%}
          <div class="pdp-thumbnails-strip no-scrollbar" id="PdpThumbnailsStrip">
            {%- for media in product.media -%}
              <button
                type="button"
                class="pdp-thumb-btn {% if forloop.first %}active{% endif %}"
                data-target-index="{{ forloop.index }}"
                aria-label="View product image {{ forloop.index }}"
              >
                <img
                  src="{{ media | image_url: width: 140 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  class="pdp-thumb-img"
                  width="64"
                  height="64"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- ====================================================================
           RIGHT COLUMN: PRODUCT DETAILS & PURCHASING PANEL (DYNAMIC BLOCKS)
           ==================================================================== -->
      <div class="product-info-panel">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="pdp-app-block-item" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

            {%- when 'vendor_actions' -%}
              <!-- Brand Header Row with Share & Wishlist -->
              <div class="product-header-meta" {{ block.shopify_attributes }}>
                <div class="product-brand-badge-wrap">
                  <span class="pdp-brand-name">{{ product.vendor | default: shop.name | default: 'LUSH BEAUTY MART' | upcase }}</span>
                  <span class="pdp-verified-badge">✓ GENUINE</span>
                </div>

                <div class="product-header-actions-wrap">
                  <!-- Share Product Pill Button -->
                  <button
                    type="button"
                    class="btn-pdp-share-pill"
                    data-share-btn
                    data-share-title="{{ product.title | escape }}"
                    data-share-url="{{ shop.url }}{{ product.url }}"
                    title="Share this product"
                    aria-label="Share this product"
                  >
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="18" cy="5" r="3"></circle>
                      <circle cx="6" cy="12" r="3"></circle>
                      <circle cx="18" cy="19" r="3"></circle>
                      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                    </svg>
                    <span>Share</span>
                  </button>

                  <!-- Wishlist Product Pill Button -->
                  <button
                    type="button"
                    class="btn-pdp-share-pill btn-pdp-wishlist"
                    data-wishlist-toggle="{{ product.id }}"
                    data-product-id="{{ product.id }}"
                    data-product-title="{{ product.title | escape }}"
                    data-product-url="{{ shop.url }}{{ product.url }}"
                    data-product-image="{{ product.featured_image | image_url: width: 300 }}"
                    data-product-price="{{ product.price | money }}"
                    data-product-vendor="{{ product.vendor | default: shop.name | escape }}"
                    title="Save to Wishlist"
                    aria-label="Save to Wishlist"
                  >
                    <svg class="icon-heart" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                    <span>Wishlist</span>
                  </button>
                </div>
              </div>

            {%- when 'title' -%}
              <!-- Product Title -->
              <h1 class="product-page-title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'price' -%}
              <!-- Price Card with Live Variant Binding -->
              <div class="product-price-card" data-price-card {{ block.shopify_attributes }}>
                <div class="price-row-main">
                  <span class="price-big" data-product-price>{{ current_variant.price | money }}</span>
                  <span class="price-mrp-big" data-compare-price {% unless current_variant.compare_at_price > current_variant.price %}style="display: none;"{% endunless %}>
                    {{ current_variant.compare_at_price | money }}
                  </span>
                  <span class="badge-saved" data-save-badge {% unless current_variant.compare_at_price > current_variant.price %}style="display: none;"{% endunless %}>
                    {%- if current_variant.compare_at_price > current_variant.price -%}
                      Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
                    {%- endif -%}
                  </span>
                </div>
                <p class="tax-shipping-note">
                  <span>Inclusive of all taxes</span> • <span>Free Nagpur Express Delivery on orders above ₹999</span>
                </p>
              </div>

            {%- when 'rating' -%}
              <!-- Star Rating / Reviews Block with Judge.me Integration -->
              <div class="pdp-rating-below-price" {{ block.shopify_attributes }}>
                <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'>
                  {{ product.metafields.judgeme.badge }}
                </div>
                <div class="pdp-rating-stars-group">
                  <span class="pdp-stars">★★★★★</span>
                  {%- if product.metafields.reviews.rating.value != blank -%}
                    <span class="pdp-rating-score">{{ product.metafields.reviews.rating.value | round: 1 }}</span>
                    {%- if product.metafields.reviews.rating_count != blank -%}
                      <span class="pdp-reviews-count">({{ product.metafields.reviews.rating_count }} Reviews)</span>
                    {%- endif -%}
                  {%- else -%}
                    <span class="pdp-rating-score">4.9</span>
                    <span class="pdp-reviews-count">(128+ Reviews)</span>
                  {%- endif -%}
                </div>
                <span class="pdp-rating-divider">•</span>
                <span class="pdp-stock-badge">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  In Stock & Ready to Dispatch
                </span>
              </div>

            {%- when 'judgeme_badge' -%}
              <!-- Dedicated Judge.me Star Badge Block -->
              <div class="pdp-judgeme-badge-wrap" {{ block.shopify_attributes }}>
                <div class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}'>
                  {{ product.metafields.judgeme.badge }}
                </div>
              </div>

            {%- when 'judgeme_reviews' -%}
              <!-- Dedicated Judge.me Full Reviews Widget Block -->
              <div class="pdp-judgeme-reviews-wrap" {{ block.shopify_attributes }}>
                <div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}'>
                  {{ product.metafields.judgeme.widget }}
                </div>
              </div>

            {%- when 'description' -%}
              <!-- Product Description Card (Styled like Price Block) -->
              {%- if product.description != blank -%}
                <div class="product-description-card" {{ block.shopify_attributes }}>
                  <div class="description-card-header">
                    <span class="desc-card-icon">{{ block.settings.icon | default: '🌿' }}</span>
                    <h3 class="desc-card-title">{{ block.settings.heading | default: 'Product Description & Details' }}</h3>
                  </div>
                  <div class="product-description-rte">
                    {{ product.description }}
                  </div>
                </div>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              <!-- Variant / Option Selector Pills -->
              {%- unless product.has_only_default_variant -%}
                <div class="product-variants-wrap" data-variant-selectors {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <div class="variant-option-group" data-option-group="{{ option.position }}">
                      <div class="variant-label-row">
                        <label class="variant-label" for="Option-{{ option.position }}">
                          Select {{ option.name }}:
                          <strong class="selected-option-value" data-selected-val-for="{{ option.position }}">{{ option.selected_value }}</strong>
                        </label>
                      </div>
                      <div class="variant-pill-row">
                        {%- for value in option.values -%}
                          <label class="variant-pill-label">
                            <input
                              type="radio"
                              name="option-{{ option.position }}"
                              value="{{ value | escape }}"
                              {% if option.selected_value == value %}checked{% endif %}
                              class="variant-radio"
                              data-option-position="{{ option.position }}"
                              data-option-name="{{ option.name | escape }}"
                            >
                            <span class="variant-pill-btn">{{ value }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <!-- Quantity Stepper & Main Action Buttons -->
              <div class="pdp-buy-buttons-block" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: 'MainProductForm', class: 'product-form' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" id="ProductVariantId">

                  <!-- Quantity Selector Stepper -->
                  <div class="quantity-row">
                    <label class="qty-title" for="ProductQuantityInput">Quantity:</label>
                    <div class="qty-selector">
                      <button type="button" class="qty-btn" id="BtnQtyMinus" aria-label="Decrease quantity">−</button>
                      <input type="number" name="quantity" id="ProductQuantityInput" value="1" min="1" class="qty-input" aria-label="Quantity">
                      <button type="button" class="qty-btn" id="BtnQtyPlus" aria-label="Increase quantity">+</button>
                    </div>
                  </div>

                  <!-- Main Action Buttons with Hierarchy -->
                  <div class="product-cta-group" id="ProductMainCtaRow">
                    <button type="submit" name="add" class="btn-pdp-primary-add" id="BtnAddBag" {% unless current_variant.available %}disabled{% endunless %}>
                      <span data-add-to-cart-text>{% if current_variant.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}</span>
                    </button>

                    <button type="button" class="btn-pdp-secondary-buy" id="BtnBuyNow" {% unless current_variant.available %}style="display: none;"{% endunless %}>
                      <span>BUY NOW</span>
                    </button>

                    <!-- Tertiary Action: Direct WhatsApp Enquiry -->
                    {%- assign wa_enquiry_text = 'Namaste Lush Beauty Mart Nagpur! 🌸 I want to order: ' | append: product.title | append: ' (' | append: current_variant.price | money | append: '). Is this available for pickup / delivery?' -%}
                    <a href="https://wa.me/{{ settings.store_whatsapp | default: '919119595951' }}?text={{ wa_enquiry_text | url_encode }}" target="_blank" rel="noopener noreferrer" class="btn-pdp-tertiary-whatsapp">
                      <span>💬 Order / Enquire on WhatsApp</span>
                    </a>
                  </div>

                  <!-- Quick Share Links Bar -->
                  <div class="pdp-share-strip">
                    <span class="share-strip-label">Share Product:</span>
                    <div class="share-strip-buttons">
                      <button
                        type="button"
                        class="btn-share-icon btn-share-native"
                        data-share-btn
                        data-share-title="{{ product.title | escape }}"
                        data-share-url="{{ shop.url }}{{ product.url }}"
                        title="Share product"
                        aria-label="Share product"
                      >
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="18" cy="5" r="3"></circle>
                          <circle cx="6" cy="12" r="3"></circle>
                          <circle cx="18" cy="19" r="3"></circle>
                          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                        </svg>
                        <span>Share</span>
                      </button>

                      {%- assign share_wa_text = 'Check out this beauty product at Lush Beauty Mart Nagpur: ' | append: product.title | append: ' - ' | append: shop.url | append: product.url -%}
                      <a
                        href="https://api.whatsapp.com/send?text={{ share_wa_text | url_encode }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-share-icon btn-share-wa"
                        title="Share on WhatsApp"
                        aria-label="Share on WhatsApp"
                      >
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/>
                        </svg>
                        <span>WhatsApp</span>
                      </a>

                      <button
                        type="button"
                        class="btn-share-icon btn-copy-link"
                        data-copy-link="{{ shop.url }}{{ product.url }}"
                        title="Copy Product Link"
                        aria-label="Copy Product Link"
                      >
                        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <span>Copy Link</span>
                      </button>
                    </div>
                  </div>
                {%- endform -%}
              </div>

            {%- when 'delivery_checker' -%}
              <!-- Real Shiprocket-Backed Delivery Serviceability Section -->
              <div class="pdp-delivery-box" id="ShiprocketDeliveryBox" data-product-price="{{ current_variant.price }}" data-product-weight="{{ product.variants.first.weight | default: 500 }}" {{ block.shopify_attributes }}>
                <div class="delivery-box-header">
                  <span class="delivery-box-icon">🚚</span>
                  <span class="delivery-box-title">{{ block.settings.title | default: 'Check Delivery Availability' }}</span>
                </div>
                <div class="delivery-input-row">
                  <input type="text" id="DeliveryPincodeInput" maxlength="6" placeholder="Enter 6-digit Pincode (e.g. 440010)" class="pincode-input" aria-label="Delivery Pincode" inputmode="numeric" pattern="[0-9]*">
                  <button type="button" id="BtnCheckPincode" class="btn-pincode-check">
                    <span class="btn-pincode-label">CHECK</span>
                    <span class="btn-pincode-loader" style="display: none;"></span>
                  </button>
                </div>
                <div id="PincodeResult" class="pincode-result-msg" style="display: none;"></div>
                <div class="delivery-default-perks" id="DeliveryDefaultPerks">
                  <div class="perk-item">
                    <span class="perk-dot">⚡</span>
                    <span><strong>Nagpur Local:</strong> Same-Day / Next-Day Delivery & Lad Sq. Pickup</span>
                  </div>
                  <div class="perk-item">
                    <span class="perk-dot">🚚</span>
                    <span><strong>Pan-India Shipping:</strong> 3–5 Days tracked courier dispatch via Shiprocket</span>
                  </div>
                </div>
              </div>

            {%- when 'trust_badges' -%}
              <!-- Trust & Authenticity Badges Strip -->
              <div class="pdp-trust-strip" {{ block.shopify_attributes }}>
                <div class="pdp-trust-item">
                  <span class="trust-icon">🛡️</span>
                  <div class="trust-text">
                    <strong>100% Genuine</strong>
                    <span>Batch Sealed Direct Import</span>
                  </div>
                </div>
                <div class="pdp-trust-item">
                  <span class="trust-icon">🏬</span>
                  <div class="trust-text">
                    <strong>Nagpur Showroom</strong>
                    <span>Lad Square Metro Pillar 213</span>
                  </div>
                </div>
                <div class="pdp-trust-item">
                  <span class="trust-icon">✨</span>
                  <div class="trust-text">
                    <strong>Derm Verified</strong>
                    <span>Authentic formulations</span>
                  </div>
                </div>
              </div>

            {%- when 'accordions' -%}
              <!-- Collapsible Product Details & Trust Accordions -->
              <div class="product-accordions-group" {{ block.shopify_attributes }}>
                <div class="product-acc-item">
                  <button type="button" class="product-acc-header" aria-expanded="false">
                    <span>✨ Usage, Application & Storage Guide</span>
                    <span class="acc-arrow">+</span>
                  </button>
                  <div class="product-acc-content" style="display: none;">
                    <p>• Store in a cool, dry place away from direct sunlight and humidity.<br>
                    • Always perform a 24-hour patch test before first use on sensitive skin.<br>
                    • Keep caps and lids firmly tightened after each application to preserve potency and fragrance.</p>
                  </div>
                </div>
                <div class="product-acc-item">
                  <button type="button" class="product-acc-header" aria-expanded="false">
                    <span>🛡️ 100% Authenticity Guarantee</span>
                    <span class="acc-arrow">+</span>
                  </button>
                  <div class="product-acc-content" style="display: none;">
                    <p>Every product at <strong>Lush Beauty Mart</strong> is guaranteed 100% genuine and sourced directly with verifiable batch codes and manufacturer seals. Products are inspected for quality before delivery or in-store pickup at our Nagpur showroom.</p>
                  </div>
                </div>
                <div class="product-acc-item">
                  <button type="button" class="product-acc-header" aria-expanded="false">
                    <span>🚚 Delivery & In-Store Showroom Pickup</span>
                    <span class="acc-arrow">+</span>
                  </button>
                  <div class="product-acc-content" style="display: none;">
                    <p>• <strong>Nagpur Doorstep Delivery:</strong> Free Same-Day / Next-Day Delivery on orders above ₹999.<br>
                    • <strong>Showroom Pickup:</strong> Free instant pickup available at Below Hotel Maitrayee, Near Lad Square (Metro Pillar 213–214), North Ambazari Road, Nagpur.<br>
                    • <strong>Pan India:</strong> 3–5 working days tracked courier dispatch via Shiprocket / BlueDart / Delhivery.</p>
                  </div>
                </div>
              </div>

            {%- when 'custom_liquid' -%}
              <div class="pdp-custom-liquid" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <!-- ====================================================================
       COMPACT MOBILE STICKY BOTTOM PURCHASE BAR
       ==================================================================== -->
  <div class="sticky-mobile-pdp-bar" id="StickyMobilePdpBar">
    <div class="sticky-bar-left">
      {%- if featured_img != blank -%}
        <img src="{{ featured_img | image_url: width: 80 }}" alt="{{ product.title | escape }}" class="sticky-bar-thumb" width="36" height="45" loading="lazy">
      {%- endif -%}
      <span class="sticky-bar-price" data-sticky-price>{{ current_variant.price | money }}</span>
    </div>
    <button type="button" class="btn-sticky-add-bag" id="BtnStickyAddBag" {% unless current_variant.available %}disabled{% endunless %}>
      <span data-sticky-add-text>{% if current_variant.available %}ADD TO BAG{% else %}SOLD OUT{% endif %}</span>
    </button>
  </div>

  <!-- ====================================================================
       FULLSCREEN IMAGE LIGHTBOX VIEWER MODAL
       ==================================================================== -->
  <div class="pdp-lightbox-modal" id="PdpLightboxModal" aria-hidden="true" role="dialog" aria-label="Image Fullscreen Viewer">
    <div class="pdp-lightbox-backdrop" id="BtnCloseLightboxBackdrop"></div>
    <div class="pdp-lightbox-content">
      <button type="button" class="btn-close-lightbox" id="BtnCloseLightbox" aria-label="Close fullscreen view">&times;</button>
      <div class="lightbox-img-wrap">
        <img id="LightboxMainImg" src="{{ featured_img | image_url: width: 1400 }}" alt="{{ product.title | escape }}" class="lightbox-img">
      </div>
      <div class="lightbox-counter" id="LightboxCounter">
        <span id="LightboxCurrent">1</span> / <span>{{ product.media.size | default: 1 }}</span>
      </div>
    </div>
  </div>

  <!-- Embedded Product JSON Data for Real-Time Variant Synchronization -->
  <script type="application/json" id="ProductJson-{{ product.id }}">
    {{ product | json }}
  </script>
</div>

{% schema %}
{
  "name": "Main Product Page",
  "tag": "section",
  "class": "section-main-product",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor_actions",
      "name": "Vendor, Share & Wishlist",
      "limit": 1
    },
    {
      "type": "title",
      "name": "Product Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price Card",
      "limit": 1
    },
    {
      "type": "rating",
      "name": "Star Rating & Stock",
      "limit": 1
    },
    {
      "type": "judgeme_badge",
      "name": "Judge.me Star Badge",
      "limit": 1
    },
    {
      "type": "judgeme_reviews",
      "name": "Judge.me Reviews Widget",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "🌿"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product Description & Details"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant Selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons & WhatsApp",
      "limit": 1
    },
    {
      "type": "delivery_checker",
      "name": "Delivery Pincode Checker",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Check Delivery Availability"
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust & Authenticity Badges",
      "limit": 1
    },
    {
      "type": "accordions",
      "name": "Collapsible Details Tabs",
      "limit": 1
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid Code"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "vendor_actions"
      },
      {
        "type": "title"
      },
      {
        "type": "price"
      },
      {
        "type": "judgeme_badge"
      },
      {
        "type": "rating"
      },
      {
        "type": "description"
      },
      {
        "type": "variant_picker"
      },
      {
        "type": "buy_buttons"
      },
      {
        "type": "delivery_checker"
      },
      {
        "type": "trust_badges"
      },
      {
        "type": "accordions"
      }
    ]
  }
}
{% endschema %}
