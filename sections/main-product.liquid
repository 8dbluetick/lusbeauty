<section class="lush-main-product-section" data-product-id="{{ product.id }}">
  <div class="page-width">
    <!-- Breadcrumbs -->
    <div class="product-breadcrumbs">
      <a href="/">Home</a> <span>/</span>
      <a href="/collections/all">Shop</a> <span>/</span>
      <span>{{ product.title }}</span>
    </div>

    <div class="main-product-grid">
      <!-- Left Column: Product Gallery -->
      <div class="product-gallery-panel">
        <div class="main-image-viewport">
          {%- if product.featured_media -%}
            <img id="ProductMainImg" src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.featured_media.alt | escape | default: product.title }}" class="product-stage-img" width="800" height="800">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if product.compare_at_price > product.price -%}
            {%- assign disc = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
            <span class="badge-stage-discount">{{ disc }}% OFF</span>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="thumbnail-strip">
            {%- for media in product.media -%}
              <button type="button" class="thumb-btn {% if forloop.first %}active{% endif %}" data-thumb-src="{{ media | image_url: width: 900 }}">
                <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" width="80" height="80">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Right Column: Product Purchasing Form & Details -->
      <div class="product-info-panel">
        <div class="product-category-rating-row">
          <span class="product-type-pill">{{ product.type | default: "Lush Exclusive" }}</span>
        </div>

        <h1 class="product-page-title">{{ product.title }}</h1>

        <!-- Price Box -->
        <div class="product-price-card">
          <div class="price-row-main">
            <span class="price-big">{{ product.price | money }}</span>
            {%- if product.compare_at_price > product.price -%}
              <span class="price-mrp-big">{{ product.compare_at_price | money }}</span>
              <span class="badge-saved">Save {{ product.compare_at_price | minus: product.price | money }}</span>
            {%- endif -%}
          </div>
          <p class="tax-shipping-note">Inclusive of all taxes. Free delivery in Nagpur on orders above ₹999.</p>
        </div>

        <!-- Description -->
        <div class="product-description-rte">
          {{ product.description }}
        </div>

        <!-- Form: Variants, Quantity & Actions -->
        {%- form 'product', product, id: 'MainProductForm', class: 'product-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="ProductVariantId">

          {%- unless product.has_only_default_variant -%}
            <div class="product-variants-wrap">
              {%- for option in product.options_with_values -%}
                <div class="variant-option-group">
                  <label class="variant-label">{{ option.name }}:</label>
                  <div class="variant-pill-row">
                    {%- for value in option.values -%}
                      <label class="variant-pill-label">
                        <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} class="variant-radio">
                        <span class="variant-pill-btn">{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Quantity Stepper -->
          <div class="quantity-row">
            <label class="qty-title">Quantity:</label>
            <div class="qty-selector">
              <button type="button" class="qty-btn" id="BtnQtyMinus">-</button>
              <input type="number" name="quantity" id="ProductQuantityInput" value="1" min="1" class="qty-input">
              <button type="button" class="qty-btn" id="BtnQtyPlus">+</button>
            </div>
          </div>

          <!-- Buttons: Add to Bag, Buy Now, WhatsApp Enquiry -->
          <div class="product-cta-buttons" id="ProductMainCtaRow">
            <button type="submit" name="add" class="btn-add-bag" {% unless product.available %}disabled{% endunless %}>
              <span>{% if product.available %}Add to Shopping Bag{% else %}Sold Out{% endif %}</span>
            </button>

            {% if product.available %}
              <button type="button" class="btn-buy-now" id="BtnBuyNow">
                <span>Buy Now</span>
              </button>
            {% endif %}
          </div>

          {%- assign wa_enquiry_text = 'Namaste Lush Beauty Mart Nagpur! 🌸 I am interested in: ' | append: product.title | append: ' (' | append: product.price | money | append: '). Is this in stock at your Lad Square store?' -%}
          <a href="https://wa.me/{{ settings.store_whatsapp | default: '919119595951' }}?text={{ wa_enquiry_text | url_encode }}" target="_blank" rel="noopener noreferrer" class="btn-product-whatsapp-enquire">
            <span>💬 Enquire Product on WhatsApp (+91 91195 95951)</span>
          </a>
        {%- endform -%}

        <!-- Interactive Pin Code Delivery Checker -->
        <div class="pincode-checker-box">
          <label for="DeliveryPincodeInput" class="pincode-label">
            <span>📍 Check Delivery Time & Nagpur Availability:</span>
          </label>
          <div class="pincode-input-row">
            <input type="text" id="DeliveryPincodeInput" maxlength="6" placeholder="Enter 6-digit Pincode (e.g. 440010)" class="pincode-input">
            <button type="button" id="BtnCheckPincode" class="btn-pincode-check">Check</button>
          </div>
          <div id="PincodeResult" class="pincode-result-msg" style="display: none;"></div>
        </div>

        <!-- Collapsible Product Details & Care Tabs -->
        <div class="product-accordions-group">
          <!-- Accordion 1: Highlights & Features -->
          <div class="product-acc-item active">
            <button type="button" class="product-acc-header" aria-expanded="true">
              <span>🌿 Highlights & Authenticity</span>
              <span class="acc-arrow">−</span>
            </button>
            <div class="product-acc-content">
              <ul class="acc-bullets-list">
                <li><strong>100% Genuine Branded Product</strong> sourced directly with manufacturer batch seal.</li>
                <li>Dermatologist & beauty stylist recommended formulations & designs.</li>
                <li>In-stock and available for immediate pickup at our <strong>Lad Square, Nagpur</strong> showroom.</li>
              </ul>
            </div>
          </div>

          <!-- Accordion 2: Care & Usage Instructions -->
          <div class="product-acc-item">
            <button type="button" class="product-acc-header" aria-expanded="false">
              <span>✨ Care, Material & Usage Guide</span>
              <span class="acc-arrow">+</span>
            </button>
            <div class="product-acc-content" style="display: none;">
              <p>For skincare & makeup, store in a cool, dry place away from direct sunlight. For artificial jewellery and luxury handbags, store in soft zip pouches and avoid direct moisture or perfume contact to retain lasting lustre.</p>
            </div>
          </div>

          <!-- Accordion 3: Nagpur Express Delivery & Store Pickup -->
          <div class="product-acc-item">
            <button type="button" class="product-acc-header" aria-expanded="false">
              <span>🚚 Delivery & In-Store Showroom Pickup</span>
              <span class="acc-arrow">+</span>
            </button>
            <div class="product-acc-content" style="display: none;">
              <p>• <strong>Nagpur Doorstep Delivery:</strong> Free Same-Day / Next-Day Delivery on orders above ₹999.<br>
              • <strong>Showroom Pickup:</strong> Instant pickup available at Below Hotel Maitrayee, Near Lad Square (Metro Pillar 213–214), North Ambazari Road, Nagpur.<br>
              • <strong>Pan India:</strong> 3–5 working days tracked courier delivery.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sticky Mobile Add to Bag Bar -->
  <div class="sticky-mobile-pdp-bar" id="StickyMobilePdpBar">
    <div class="sticky-bar-info">
      <span class="sticky-bar-title">{{ product.title | truncate: 25 }}</span>
      <span class="sticky-bar-price">{{ product.price | money }}</span>
    </div>
    <button type="button" class="btn-sticky-add-bag" id="BtnStickyAddBag">
      <span>+ Add to Bag</span>
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Main Product Page",
  "settings": []
}
{% endschema %}
