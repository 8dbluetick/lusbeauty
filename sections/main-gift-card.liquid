{% comment %}
  Lush Beauty Mart — Luxury E-Gift Card Purchasing Section
{% endcomment %}

<div class="lush-gift-card-purchase-page" style="background: #FAF7F2; padding: 40px 0 80px; min-height: 80vh;">
  <div class="page-width" style="max-width: 1100px; margin: 0 auto; padding: 0 16px;">
    
    <!-- Header -->
    <div style="text-align: center; max-width: 700px; margin: 0 auto 40px;">
      <span style="display: inline-block; padding: 5px 16px; background: rgba(197, 160, 89, 0.15); border: 1px solid rgba(197, 160, 89, 0.35); border-radius: 999px; font-size: 0.72rem; font-weight: 800; color: #8B6F3E; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 12px;">
        🎁 THE PERFECT BEAUTY GIFT
      </span>
      <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; color: #1F1610; line-height: 1.15; margin: 0 0 12px;">
        Lush Luxury E-Gift Card
      </h1>
      <p style="font-size: 0.92rem; color: #6E5E52; line-height: 1.6; margin: 0;">
        Give the gift of pure luxury. Redeemable across all 100% authentic skincare, high-definition makeup, French fragrances, and designer handbags.
      </p>
    </div>

    <!-- Main 2-Column Split: [ 3D Live Card Preview ] & [ Purchase Form ] -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 36px; align-items: start;">
      
      <!-- Left Column: Interactive 3D Gold Card Preview -->
      <div style="position: sticky; top: 100px;">
        <div id="InteractiveGiftCard" style="background: linear-gradient(135deg, #1F1610 0%, #352317 50%, #150E09 100%); border: 2px solid #C5A059; border-radius: 20px; padding: 32px 28px; color: #FFFFFF; box-shadow: 0 16px 40px rgba(31, 22, 16, 0.15); position: relative; overflow: hidden; transition: transform 0.3s ease;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 36px;">
            <div style="width: 44px; height: 32px; background: linear-gradient(135deg, #E6C786 0%, #C5A059 100%); border-radius: 6px; position: relative;"></div>
            <span style="font-size: 0.72rem; font-weight: 800; color: #C5A059; letter-spacing: 0.1em; text-transform: uppercase;">
              LUSH BEAUTY MART
            </span>
          </div>

          <div style="font-size: 0.75rem; color: #C5A059; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 6px;">Gift Pass Value</div>
          <div id="LiveCardAmount" style="font-family: var(--font-serif); font-size: 3rem; font-weight: 800; color: #FFFFFF; margin-bottom: 24px; line-height: 1;">₹1,000</div>

          <div style="display: flex; justify-content: space-between; align-items: flex-end; padding-top: 20px; border-top: 1px solid rgba(197, 160, 89, 0.3);">
            <div>
              <div style="font-size: 0.68rem; color: #BBA99C; text-transform: uppercase; margin-bottom: 2px;">Recipient</div>
              <div id="LiveRecipientName" style="font-size: 0.9rem; font-weight: 700; color: #FFFFFF;">Special Someone ✨</div>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 0.68rem; color: #BBA99C; text-transform: uppercase; margin-bottom: 2px;">Validity</div>
              <div style="font-size: 0.85rem; font-weight: 700; color: #C5A059;">1 Year Pan-India</div>
            </div>
          </div>
        </div>

        <!-- 4 Luxury Perks -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 24px;">
          <div style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 12px; padding: 14px; text-align: center;">
            <span style="font-size: 1.4rem; display: block; margin-bottom: 4px;">⚡</span>
            <strong style="font-size: 0.78rem; color: #1F1610; display: block;">Instant Delivery</strong>
            <span style="font-size: 0.7rem; color: #6E5E52;">Via Email & WhatsApp</span>
          </div>
          <div style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 12px; padding: 14px; text-align: center;">
            <span style="font-size: 1.4rem; display: block; margin-bottom: 4px;">🏬</span>
            <strong style="font-size: 0.78rem; color: #1F1610; display: block;">Online & In-Store</strong>
            <span style="font-size: 0.7rem; color: #6E5E52;">Lad Square, Nagpur</span>
          </div>
          <div style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 12px; padding: 14px; text-align: center;">
            <span style="font-size: 1.4rem; display: block; margin-bottom: 4px;">⏳</span>
            <strong style="font-size: 0.78rem; color: #1F1610; display: block;">1-Year Validity</strong>
            <span style="font-size: 0.7rem; color: #6E5E52;">Zero Expiry Stress</span>
          </div>
          <div style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 12px; padding: 14px; text-align: center;">
            <span style="font-size: 1.4rem; display: block; margin-bottom: 4px;">🌸</span>
            <strong style="font-size: 0.78rem; color: #1F1610; display: block;">100% Genuine</strong>
            <span style="font-size: 0.7rem; color: #6E5E52;">All Brand Products</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Denomination & Details Form -->
      <div style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 20px; padding: 32px 28px; box-shadow: 0 8px 30px rgba(31, 22, 16, 0.04);">
        <h2 style="font-family: var(--font-serif); font-size: 1.4rem; font-weight: 800; color: #1F1610; margin-bottom: 20px;">
          1. Select Gift Card Amount
        </h2>

        <!-- Denominations Grid -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 28px;" id="DenominationGroup">
          <button type="button" class="gift-denom-btn" data-amount="500" style="padding: 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; background: #FAF7F2; font-weight: 800; font-size: 0.95rem; color: #1F1610; cursor: pointer; transition: all 0.2s;">₹500</button>
          <button type="button" class="gift-denom-btn active" data-amount="1000" style="padding: 14px; border: 2px solid #C5A059; border-radius: 10px; background: #1F1610; font-weight: 800; font-size: 0.95rem; color: #C5A059; cursor: pointer; transition: all 0.2s;">₹1,000</button>
          <button type="button" class="gift-denom-btn" data-amount="2000" style="padding: 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; background: #FAF7F2; font-weight: 800; font-size: 0.95rem; color: #1F1610; cursor: pointer; transition: all 0.2s;">₹2,000</button>
          <button type="button" class="gift-denom-btn" data-amount="3000" style="padding: 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; background: #FAF7F2; font-weight: 800; font-size: 0.95rem; color: #1F1610; cursor: pointer; transition: all 0.2s;">₹3,000</button>
          <button type="button" class="gift-denom-btn" data-amount="5000" style="padding: 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; background: #FAF7F2; font-weight: 800; font-size: 0.95rem; color: #1F1610; cursor: pointer; transition: all 0.2s;">₹5,000</button>
          <button type="button" class="gift-denom-btn" data-amount="10000" style="padding: 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; background: #FAF7F2; font-weight: 800; font-size: 0.95rem; color: #1F1610; cursor: pointer; transition: all 0.2s;">₹10,000</button>
        </div>

        <h2 style="font-family: var(--font-serif); font-size: 1.4rem; font-weight: 800; color: #1F1610; margin-bottom: 20px;">
          2. Personalize Your Gift
        </h2>

        <!-- Personalization Form -->
        <form action="/cart/add" method="post" id="LushGiftCardForm">
          <input type="hidden" name="id" id="GiftCardVariantId" value="{% if all_products['gift-card'] != blank %}{{ all_products['gift-card'].variants.first.id }}{% elsif all_products['lush-beauty-gift-card'] != blank %}{{ all_products['lush-beauty-gift-card'].variants.first.id }}{% endif %}">
          <input type="hidden" name="properties[Card Amount]" id="PropertyAmount" value="₹1,000">

          <div style="margin-bottom: 16px;">
            <label for="RecipientNameInput" style="display: block; font-size: 0.75rem; font-weight: 700; color: #1F1610; text-transform: uppercase; margin-bottom: 6px;">Recipient's Name</label>
            <input type="text" id="RecipientNameInput" name="properties[Recipient Name]" placeholder="e.g. Priya Sharma" style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box;">
          </div>

          <div style="margin-bottom: 16px;">
            <label for="RecipientEmailInput" style="display: block; font-size: 0.75rem; font-weight: 700; color: #1F1610; text-transform: uppercase; margin-bottom: 6px;">Recipient's Email or WhatsApp</label>
            <input type="text" id="RecipientEmailInput" name="properties[Recipient Contact]" placeholder="e.g. priya@gmail.com or +91 98765 43210" style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box;">
          </div>

          <div style="margin-bottom: 24px;">
            <label for="GiftMessageInput" style="display: block; font-size: 0.75rem; font-weight: 700; color: #1F1610; text-transform: uppercase; margin-bottom: 6px;">Personal Greeting Message</label>
            <textarea id="GiftMessageInput" name="properties[Message]" rows="3" placeholder="Wishing you glowing skin and endless happiness! Happy Birthday! 🌸" style="width: 100%; padding: 12px 14px; border: 1.5px solid #EAE3DA; border-radius: 10px; font-size: 0.88rem; outline: none; box-sizing: border-box; font-family: inherit; resize: vertical;"></textarea>
          </div>

          <!-- Purchase Action Buttons -->
          <div style="display: flex; flex-direction: column; gap: 10px;">
            <button type="submit" id="BtnAddGiftCard" style="width: 100%; padding: 16px; background: #1F1610; color: #C5A059; font-size: 0.9rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; border: none; border-radius: 10px; cursor: pointer; transition: all 0.2s;">
              🛍️ Add Gift Card to Shopping Bag (<span id="BtnAmountText">₹1,000</span>)
            </button>
            <a href="https://api.whatsapp.com/send?phone=919119595951&text=Hello%20Lush%20Beauty%20Mart!%20I%20want%20to%20order%20a%20Luxury%20Gift%20Card." target="_blank" rel="noopener" style="display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; padding: 12px; background: #FAF7F2; border: 1px solid #EAE3DA; color: #1F1610; font-size: 0.82rem; font-weight: 700; border-radius: 10px; text-decoration: none;">
              💬 Need help? Order Gift Card via WhatsApp
            </a>
          </div>
        </form>

      </div>
    </div>

  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const denomButtons = document.querySelectorAll('.gift-denom-btn');
  const liveAmount = document.getElementById('LiveCardAmount');
  const btnAmountText = document.getElementById('BtnAmountText');
  const propertyAmount = document.getElementById('PropertyAmount');
  const recipientInput = document.getElementById('RecipientNameInput');
  const liveRecipientName = document.getElementById('LiveRecipientName');

  denomButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      denomButtons.forEach(b => {
        b.style.background = '#FAF7F2';
        b.style.color = '#1F1610';
        b.style.border = '1.5px solid #EAE3DA';
      });
      btn.style.background = '#1F1610';
      btn.style.color = '#C5A059';
      btn.style.border = '2px solid #C5A059';

      const amount = btn.getAttribute('data-amount');
      const formatted = '₹' + parseInt(amount, 10).toLocaleString('en-IN');
      
      if (liveAmount) liveAmount.textContent = formatted;
      if (btnAmountText) btnAmountText.textContent = formatted;
      if (propertyAmount) propertyAmount.value = formatted;
    });
  });

  if (recipientInput && liveRecipientName) {
    recipientInput.addEventListener('input', () => {
      const val = recipientInput.value.trim();
      liveRecipientName.textContent = val ? val + ' ✨' : 'Special Someone ✨';
    });
  }
});
</script>

{% schema %}
{
  "name": "Gift Card Page",
  "settings": []
}
{% endschema %}
