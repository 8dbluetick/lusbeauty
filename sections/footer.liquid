<footer class="lush-footer">
  <!-- Top Gold Border Accent -->
  <div class="footer-gold-bar"></div>

  <div class="page-width">
    <!-- Top Highlights Bar -->
    <div class="footer-perks-grid">
      <div class="footer-perk-item">
        <span class="perk-icon">📍</span>
        <div>
          <strong>Nagpur Store</strong>
          <p>Gandhi Nagar, Lad Square</p>
        </div>
      </div>
      <div class="footer-perk-item">
        <span class="perk-icon">🛡️</span>
        <div>
          <strong>100% Genuine</strong>
          <p>Authentic Brands Only</p>
        </div>
      </div>
      <div class="footer-perk-item">
        <span class="perk-icon">🚚</span>
        <div>
          <strong>Nagpur & Pan India</strong>
          <p>Fast doorstep delivery</p>
        </div>
      </div>
      <div class="footer-perk-item">
        <span class="perk-icon">⏰</span>
        <div>
          <strong>Open 7 Days</strong>
          <p>10:30 AM to 9:30 PM</p>
        </div>
      </div>
    </div>

    <!-- Main Footer Links Grid -->
    <div class="footer-main-grid">
      <!-- Col 1: Brand Info & Social -->
      <div class="footer-brand-col">
        <div class="footer-brand-header">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 160 }}"
              alt="{{ section.settings.store_title | default: shop.name | escape }}"
              class="footer-logo-img"
              width="{{ section.settings.logo_width | default: 44 }}"
              height="{{ section.settings.logo_width | default: 44 }}"
            >
          {%- else -%}
            <img
              src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300623/lushbeautymart_14050530_135102335_bdtk3h.jpg"
              alt="Lush Beauty Mart"
              class="footer-logo-img"
              width="44"
              height="44"
            >
          {%- endif -%}
          <div>
            <div class="brand-wordmark">
              <span class="wordmark-bold text-cream">{{ section.settings.store_title | default: "LUSH BEAUTY MART" }}</span>
            </div>
            {%- if section.settings.store_tagline != blank -%}
              <p class="brand-quote" style="margin: 0;">“{{ section.settings.store_tagline }}”</p>
            {%- endif -%}
          </div>
        </div>
        <p class="brand-summary" style="margin-top: 12px;">
          {{ section.settings.description | default: "Nagpur’s premier luxury destination for genuine skincare, high-definition cosmetics, authentic artificial jewellery, designer handbags, and beauty accessories." }}
        </p>

        <div class="footer-social-wrap">
          <span class="social-heading">Follow Us Online</span>
          <div class="social-icons-row">
            {%- assign insta_url = section.settings.instagram_link | default: settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' -%}
            <a href="{{ insta_url }}" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            {%- assign fb_url = section.settings.facebook_link | default: settings.social_facebook_link | default: 'https://facebook.com' -%}
            <a href="{{ fb_url }}" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Facebook">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/>
              </svg>
            </a>
            {%- assign wa_phone = section.settings.whatsapp | default: settings.store_whatsapp | default: '919119595951' -%}
            <a href="https://wa.me/{{ wa_phone }}" target="_blank" rel="noopener noreferrer" class="social-btn social-btn-wa" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 2: Categories -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Categories</h4>
        <ul class="footer-links-list">
          {%- assign cat_menu = linklists[section.settings.menu_categories] -%}
          {%- if cat_menu != blank and cat_menu.links.size > 0 -%}
            {%- for link in cat_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{% if collections['skincare'] != blank %}{{ collections['skincare'].url }}{% else %}/collections/all{% endif %}">Skincare & Serums</a></li>
            <li><a href="{% if collections['cosmetics'] != blank %}{{ collections['cosmetics'].url }}{% else %}/collections/all{% endif %}">Cosmetics & Makeup</a></li>
            <li><a href="{% if collections['artificial-jewellery'] != blank %}{{ collections['artificial-jewellery'].url }}{% elsif collections['jewellery'] != blank %}{{ collections['jewellery'].url }}{% else %}/collections/all{% endif %}">Artificial Jewellery</a></li>
            <li><a href="{% if collections['handbags'] != blank %}{{ collections['handbags'].url }}{% else %}/collections/all{% endif %}">Handbags & Slings</a></li>
            <li><a href="{% if collections['beauty-accessories'] != blank %}{{ collections['beauty-accessories'].url }}{% elsif collections['accessories'] != blank %}{{ collections['accessories'].url }}{% else %}/collections/all{% endif %}">Beauty Accessories</a></li>
            <li><a href="/collections/all" class="text-gold">✨ All Collections</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Col 3: Customer Support -->
      <div class="footer-links-col">
        <h4 class="footer-col-title">Customer Support</h4>
        <ul class="footer-links-list">
          {%- assign support_menu = linklists[section.settings.menu_support] -%}
          {%- if support_menu != blank and support_menu.links.size > 0 -%}
            {%- for link in support_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="https://wa.me/{{ wa_phone }}" target="_blank" rel="noopener noreferrer">WhatsApp Support ↗</a></li>
            <li><a href="#store-section">Store Location & Timings</a></li>
            <li><a href="/cart">Shopping Bag & Checkout</a></li>
            <li><a href="https://sevasurgicalsanddrugs.vercel.app/" target="_blank" rel="noopener noreferrer" style="color: #10B981; font-weight: 700;">🏥 Seva Surgicals & Pharmacy ↗</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Col 4: Nagpur Physical Store Address -->
      <div class="footer-address-col">
        <h4 class="footer-col-title">Nagpur Store</h4>
        <div class="footer-address-block">
          <p>
            {{ section.settings.address | default: "Below Hotel Maitrayee, Near Lad Square, Metro Pillar No. 213, 214, North Ambazari Road, Gandhi Nagar, Nagpur – 440 010" | newline_to_br }}
          </p>
          <p class="footer-phone">
            📞 <a href="tel:{{ section.settings.phone | default: '9119595951' }}">+91 {{ section.settings.phone | default: '9119595951' }}</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <p class="footer-copy">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: "Lush Beauty Mart. All Rights Reserved." }}
      </p>
      <div class="footer-payment-badges">
        <span>🔒 100% Secure Shopping</span>
        <span class="sep">•</span>
        <span>⚡ UPI & Net Banking</span>
        <span class="sep">•</span>
        <span>🚚 Free Nagpur Delivery on ₹999+</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Max Width",
      "default": 44
    },
    {
      "type": "text",
      "id": "store_title",
      "label": "Store Name",
      "default": "LUSH BEAUTY MART"
    },
    {
      "type": "text",
      "id": "store_tagline",
      "label": "Store Tagline",
      "default": "Where Beauty Meets Quality"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Store Description",
      "default": "Nagpur’s premier luxury destination for genuine skincare, high-definition cosmetics, authentic artificial jewellery, designer handbags, and beauty accessories."
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Physical Address",
      "default": "Below Hotel Maitrayee, Near Lad Square,\nMetro Pillar No. 213, 214,\nNorth Ambazari Road, Gandhi Nagar,\nNagpur – 440 010"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "9119595951"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp Number",
      "default": "919119595951"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "facebook_link",
      "label": "Facebook Link"
    },
    {
      "type": "link_list",
      "id": "menu_categories",
      "label": "Categories Menu (Optional)"
    },
    {
      "type": "link_list",
      "id": "menu_support",
      "label": "Customer Support Menu (Optional)"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Lush Beauty Mart. All Rights Reserved."
    }
  ]
}
{% endschema %}
