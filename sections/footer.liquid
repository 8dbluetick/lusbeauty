          </svg>
        </div>

        <!-- 6. PhonePe -->
        <div class="payment-badge-card" title="PhonePe">
          <svg viewBox="0 0 50 32" width="44" height="28" fill="none">
            <rect width="50" height="32" rx="5" fill="#FFFFFF"/>
            <circle cx="16" cy="16" r="9.5" fill="#5F259F"/>
            <text x="12" y="21" font-family="sans-serif" font-size="14" font-weight="900" fill="#FFFFFF">पे</text>
            <text x="27.5" y="19" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-size="9" font-weight="800" fill="#5F259F">Pe</text>
          </svg>
        </div>

        <!-- 7. Paytm -->
        <div class="payment-badge-card" title="Paytm">
          <svg viewBox="0 0 50 32" width="44" height="28" fill="none">
            <rect width="50" height="32" rx="5" fill="#FFFFFF"/>
            <text x="5" y="20.5" font-family="sans-serif" font-size="12" font-weight="900" fill="#002970">pay</text>
            <text x="25.5" y="20.5" font-family="sans-serif" font-size="12" font-weight="900" fill="#00BAF2">tm</text>
          </svg>
        </div>

        <!-- 8. Cash on Delivery (COD) -->
        <div class="payment-badge-card" title="Cash on Delivery">
          <svg viewBox="0 0 50 32" width="44" height="28" fill="none">
            <rect width="50" height="32" rx="5" fill="#FFFFFF"/>
            <text x="7" y="15" font-family="'Plus Jakarta Sans', sans-serif" font-size="8.5" font-weight="900" fill="#0F7A42">C · O · D</text>
            <text x="5" y="23" font-family="'Plus Jakarta Sans', sans-serif" font-size="5.5" font-weight="800" fill="#8A7363">PAY ON DELIVERY</text>
          </svg>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom-bar">
      <p class="footer-copy">
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_text | default: "Lush Beauty Mart. All Rights Reserved." }}
      </p>
      <div class="footer-legal-links">
        <a href="/pages/privacy-policy">Privacy Policy</a>
        <span class="sep">•</span>
        <a href="/pages/terms-of-service">Terms</a>
        <span class="sep">•</span>
        <a href="/pages/refund-policy">Refunds</a>
        <span class="sep">•</span>
        <a href="/pages/shipping-policy">Shipping</a>
      </div>
      <div class="footer-payment-badges">
        <span>🔒 100% Secure Shopping</span>
        <span class="sep">•</span>
        <span>⚡ UPI & COD</span>
        <span class="sep">•</span>
        <span>🚚 Nagpur & Pan-India</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Max Width",
      "default": 44
    },
    {
      "type": "text",
      "id": "store_title",
      "label": "Store Name",
      "default": "LUSH BEAUTY MART"
    },
    {
      "type": "text",
      "id": "store_tagline",
      "label": "Store Tagline",
      "default": "Where Beauty Meets Quality"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Store Description",
      "default": "Nagpur’s premier luxury destination for genuine dermatological skincare, cosmetics, designer handbags, fragrances, and beauty accessories."
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Physical Address",
      "default": "Below Hotel Maitrayee, Near Lad Square,\nMetro Pillar No. 213, 214,\nNorth Ambazari Road, Gandhi Nagar,\nNagpur – 440 010"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "9119595951"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "WhatsApp Number",
      "default": "919119595951"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "facebook_link",
      "label": "Facebook Link"
    },
    {
      "type": "link_list",
      "id": "menu_categories",
      "label": "Categories Menu (Optional)"
    },
    {
      "type": "link_list",
      "id": "menu_support",
      "label": "Customer Support Menu (Optional)"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Lush Beauty Mart. All Rights Reserved."
    }
  ]
}
{% endschema %}
