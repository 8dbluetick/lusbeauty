{%- if section.settings.enable_section -%}
  <section class="lush-categories-section lush-marquee-categories-section">
    <div class="page-width">
      <div class="section-header-center">
        {%- if section.settings.badge != blank -%}
          <span class="section-badge">{{ section.settings.badge }}</span>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.title | default: "Shop By Collection" }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="section-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    </div>

    <!-- Dual Running Marquee Wrapper -->
    <div class="collection-marquee-wrapper" style="--marquee-speed: {{ section.settings.speed | default: 32 }}s;">
      <!-- Row 1: Leftward Running Marquee (Right to Left) -->
      <div class="collection-marquee-row row-left">
        <div class="collection-marquee-track track-left">
          <!-- Group 1 -->
          <div class="collection-marquee-group">
            <!-- Card 1: Skincare -->
            <a href="{% if collections['skincare'] != blank %}{{ collections['skincare'].url }}{% else %}/collections/all{% endif %}" class="collection-running-card group">
              <div class="cat-image-wrapper">
                <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=800&auto=format&fit=crop" alt="Skincare" class="cat-img" loading="lazy" width="400" height="500">
                <div class="cat-overlay"></div>
                <span class="cat-count-pill">✨ Top Rated</span>
                <div class="cat-content">
                  <span class="cat-super">LUSH SKINCARE</span>
                  <h3 class="cat-name">Dermal Skincare</h3>
                  <p class="cat-desc">Serums, Cleansers & Moisturizers</p>
                  <div class="cat-cta"><span>Explore Collection</span> <span class="cat-arrow">→</span></div>
                </div>
              </div>
            </a>

            <!-- Card 2: Makeup -->
