                  <p class="cat-desc">Lipsticks, Foundations & Liners</p>
                  <div class="cat-cta"><span>Explore Collection</span> <span class="cat-arrow">→</span></div>
                </div>
              </div>
            </a>

            <!-- Card 3: Designer Handbags -->
