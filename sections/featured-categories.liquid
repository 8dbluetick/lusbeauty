<section class="lush-categories-section">
  <div class="page-width">
    <div class="section-header-center">
      <span class="section-badge">✨ Curated Collections</span>
      <h2 class="section-title">{{ section.settings.title | default: "Shop By Category" }}</h2>
      <p class="section-subtitle">Explore our handpicked categories in-store in Nagpur or browse and order online.</p>
    </div>

    <div class="categories-grid-6">
      <!-- 1. Skincare -->
      <a href="/collections/skincare" class="category-card group">
        <div class="cat-image-wrapper">
          <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=800&auto=format&fit=crop" alt="Skincare" class="cat-img" loading="lazy" width="600" height="750">
          <div class="cat-overlay"></div>
          <span class="cat-count-pill">40+ Essentials</span>
          <div class="cat-content">
            <span class="cat-super">LUSH SKINCARE</span>
            <h3 class="cat-name">Skincare</h3>
            <p class="cat-desc">Serums, Sunscreens, Moisturizers & Cleansers</p>
            <div class="cat-cta">
              <span>Explore Collection</span>
              <span class="cat-arrow">→</span>
            </div>
          </div>
        </div>
      </a>

      <!-- 2. Cosmetics -->
      <a href="/collections/cosmetics" class="category-card group">
        <div class="cat-image-wrapper">
          <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?q=80&w=800&auto=format&fit=crop" alt="Cosmetics" class="cat-img" loading="lazy" width="600" height="750">
          <div class="cat-overlay"></div>
          <span class="cat-count-pill">60+ Shades</span>
          <div class="cat-content">
            <span class="cat-super">LUSH COSMETICS</span>
            <h3 class="cat-name">Cosmetics</h3>
            <p class="cat-desc">Lipsticks, Foundations, Kajal, Eyeliners & Mascaras</p>
            <div class="cat-cta">
              <span>Explore Collection</span>
              <span class="cat-arrow">→</span>
            </div>
          </div>
        </div>
      </a>

      <!-- 3. Artificial Jewellery -->
      <a href="/collections/artificial-jewellery" class="category-card group">
        <div class="cat-image-wrapper">
          <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=800&auto=format&fit=crop" alt="Artificial Jewellery" class="cat-img" loading="lazy" width="600" height="750">
          <div class="cat-overlay"></div>
          <span class="cat-count-pill">80+ Designs</span>
          <div class="cat-content">
            <span class="cat-super">ROYAL JEWELLERY</span>
            <h3 class="cat-name">Artificial Jewellery</h3>
            <p class="cat-desc">Kundan Sets, AD Rings, Jhumkas, Bangles & Tikka</p>
            <div class="cat-cta">
              <span>Explore Collection</span>
              <span class="cat-arrow">→</span>
            </div>
          </div>
        </div>
      </a>

      <!-- 4. Handbags -->
      <a href="/collections/handbags" class="category-card group">
        <div class="cat-image-wrapper">
          <img src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?q=80&w=800&auto=format&fit=crop" alt="Handbags" class="cat-img" loading="lazy" width="600" height="750">
          <div class="cat-overlay"></div>
          <span class="cat-count-pill">35+ Styles</span>
          <div class="cat-content">
            <span class="cat-super">LUXURY BAGS</span>
            <h3 class="cat-name">Handbags & Slings</h3>
            <p class="cat-desc">Structured Totes, Quilted Slings & Baguette Bags</p>
            <div class="cat-cta">
              <span>Explore Collection</span>
              <span class="cat-arrow">→</span>
            </div>
          </div>
        </div>
      </a>

      <!-- 5. Beauty Accessories -->
      <a href="/collections/beauty-accessories" class="category-card group">
        <div class="cat-image-wrapper">
          <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?q=80&w=800&auto=format&fit=crop" alt="Beauty Accessories" class="cat-img" loading="lazy" width="600" height="750">
          <div class="cat-overlay"></div>
          <span class="cat-count-pill">30+ Tools</span>
          <div class="cat-content">
            <span class="cat-super">BEAUTY TOOLS</span>
            <h3 class="cat-name">Beauty Accessories</h3>
            <p class="cat-desc">Pro Makeup Brushes, Jade Rollers & Blenders</p>
            <div class="cat-cta">
              <span>Explore Collection</span>
              <span class="cat-arrow">→</span>
            </div>
          </div>
        </div>
      </a>

      <!-- 6. Fashion Accessories -->
      <a href="/collections/fashion-accessories" class="category-card group">
        <div class="cat-image-wrapper">
          <img src="https://images.unsplash.com/photo-1590548784585-643d2b9f2925?q=80&w=800&auto=format&fit=crop" alt="Fashion Accessories" class="cat-img" loading="lazy" width="600" height="750">
          <div class="cat-overlay"></div>
          <span class="cat-count-pill">25+ Items</span>
          <div class="cat-content">
            <span class="cat-super">STYLE ACCENTS</span>
            <h3 class="cat-name">Fashion Accessories</h3>
            <p class="cat-desc">Pearl Headbands, Saree Brooches & Gift Hampers</p>
            <div class="cat-cta">
              <span>Explore Collection</span>
              <span class="cat-arrow">→</span>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop By Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop By Category"
    }
  ],
  "presets": [
    {
      "name": "Shop By Category Grid"
    }
  ]
}
{% endschema %}
