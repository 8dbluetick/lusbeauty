{% comment %}
  Lush Beauty Mart — Omnichannel Connect & In-Store Review Hub
  Optimized for QR code scanning at billing counter and post-purchase links
{% endcomment %}

<section class="lush-connect-hub-section">
  <div class="connect-hub-hero">
    <div class="connect-hub-hero-inner">
      <span class="hub-pill">✨ LUSH BEAUTY MART EXPERIENCE</span>
      <h1 class="hub-hero-title">Connect & Share Your Glow</h1>
      <p class="hub-hero-sub">
        Thank you for visiting our Nagpur Flagship Showroom & online store. Follow our community, rate your experience, and unlock exclusive rewards!
      </p>

      <!-- Instant In-Store Reward Banner -->
      <div class="hub-reward-banner">
        <span class="reward-gift-icon">🎁</span>
        <div>
          <strong>In-Store Special Perk:</strong>
          <span>Rate our Nagpur showroom on Google or tag us on Instagram to receive an instant surprise gift or ₹50 off on your next visit!</span>
        </div>
      </div>
    </div>
  </div>

  <div class="connect-hub-cards-container">
    
    <!-- 1. Google Review Card (Nagpur Store) -->
    <a href="https://share.google/sWmPw0Ml2x1f3NPjo" target="_blank" rel="noopener noreferrer" class="hub-action-card card-google">
      <div class="card-icon-wrap icon-google">
        <svg viewBox="0 0 24 24" width="28" height="28">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
      </div>
      <div class="card-text-wrap">
        <div class="card-badge-row">
          <span class="card-badge">⭐ 15-SECOND REVIEW</span>
          <span class="card-stars">★★★★★</span>
        </div>
        <h2 class="card-title">Rate Our Nagpur Store on Google</h2>
        <p class="card-desc">
          Loved our ambiance, product collection, and staff service? Share a 5-star Google review to help other Nagpur beauty lovers discover authentic luxury!
        </p>
        <div class="card-button-row">
          <span class="hub-btn hub-btn-google">Write Google Review ↗</span>
        </div>
      </div>
    </a>

    <!-- 2. Instagram Community Card -->
    <a href="https://www.instagram.com/lushbeautymart" target="_blank" rel="noopener noreferrer" class="hub-action-card card-instagram">
      <div class="card-icon-wrap icon-instagram">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="white">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </div>
      <div class="card-text-wrap">
        <div class="card-badge-row">
          <span class="card-badge">📸 @LUSHBEAUTYMART</span>
          <span class="card-highlight">Tag Us to Get Featured</span>
        </div>
        <h2 class="card-title">Follow & Tag Us on Instagram</h2>
        <p class="card-desc">
          Click a selfie or story with your Lush shopping bag, tag <strong>@lushbeautymart</strong>, and get featured on our official Instagram and website customer gallery!
        </p>
        <div class="card-button-row">
          <span class="hub-btn hub-btn-instagram">Follow @lushbeautymart ↗</span>
        </div>
      </div>
    </a>

    <!-- 3. VIP WhatsApp Channel Card -->
    <a href="https://whatsapp.com/channel/0029Vb6NqZe1dAw9kWq34L1b" target="_blank" rel="noopener noreferrer" class="hub-action-card card-whatsapp">
      <div class="card-icon-wrap icon-whatsapp">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="white">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/>
        </svg>
      </div>
      <div class="card-text-wrap">
        <div class="card-badge-row">
          <span class="card-badge">🟢 VIP INSIDER ALERTS</span>
          <span class="card-highlight">Never Miss a Drop</span>
        </div>
        <h2 class="card-title">Join VIP WhatsApp Channel</h2>
        <p class="card-desc">
          Get secret flash sales, newly arrived luxury perfumes, and restock notifications delivered straight to your WhatsApp before anyone else.
        </p>
        <div class="card-button-row">
          <span class="hub-btn hub-btn-whatsapp">Join WhatsApp Channel ↗</span>
        </div>
      </div>
    </a>

    <!-- 4. Direct In-Store Feedback / Product Review Form -->
    <div class="hub-action-card card-feedback-form">
      <div class="card-icon-wrap icon-gold">
        ✨
      </div>
      <div class="card-text-wrap" style="width: 100%;">
        <div class="card-badge-row">
          <span class="card-badge">✍️ INSTANT STORE FEEDBACK</span>
          <span class="card-highlight">Direct to Showroom Team</span>
        </div>
        <h2 class="card-title">Share Your In-Store Feedback</h2>
        <p class="card-desc">
          Tell us about your visit today! Your feedback helps us continuously elevate your luxury beauty shopping experience.
        </p>

        <form id="InStoreFeedbackForm" class="hub-feedback-form">
          <div class="form-rating-row">
            <label class="form-label">How was your visit today?</label>
            <div class="hub-star-picker" id="HubStarPicker" role="radiogroup">
              <button type="button" class="hub-star selected" data-val="1">★</button>
              <button type="button" class="hub-star selected" data-val="2">★</button>
              <button type="button" class="hub-star selected" data-val="3">★</button>
              <button type="button" class="hub-star selected" data-val="4">★</button>
              <button type="button" class="hub-star selected" data-val="5">★</button>
            </div>
            <input type="hidden" id="FeedbackRating" value="5">
          </div>

          <div class="form-grid-2">
            <div>
              <label class="form-label" for="FeedbackName">Your Name *</label>
              <input type="text" id="FeedbackName" class="form-input" placeholder="e.g. Ananya Sharma" required>
            </div>
            <div>
              <label class="form-label" for="FeedbackPhone">Mobile / WhatsApp No.</label>
              <input type="tel" id="FeedbackPhone" class="form-input" placeholder="e.g. 98230XXXXX">
            </div>
          </div>

          <div style="margin-top: 12px;">
            <label class="form-label" for="FeedbackMsg">Your Message / Store Experience *</label>
            <textarea id="FeedbackMsg" class="form-input form-textarea" rows="3" placeholder="Tell us what you loved or products you'd like to see next..." required></textarea>
          </div>

          <button type="submit" id="BtnSubmitFeedback" class="btn-hub-submit">
            <span>Submit Feedback ✨</span>
          </button>

          <div id="FeedbackSuccessBox" class="feedback-success" style="display: none;">
            <span>🎉 <strong>Thank you!</strong> Your feedback has been received. Show this confirmation at the counter for your surprise perk!</span>
          </div>
        </form>
      </div>
    </div>

  </div>

  <!-- Store Landmark & Visit Card -->
  <div class="connect-hub-store-footer">
    <div class="store-footer-inner">
      <div class="store-footer-text">
        <span class="footer-badge">📍 NAGPUR SHOWROOM</span>
        <h3>Visit Lush Beauty Mart</h3>
        <p>Below Hotel Maitrayee, Near Lad Square (Metro Pillar 213–214), North Ambazari Road, Nagpur – 440 010</p>
        <p class="store-hours">⏰ Open All 7 Days: 10:30 AM – 9:30 PM | 📞 <a href="tel:9119595951">9119595951</a></p>
      </div>
      <div class="store-footer-cta">
        <a href="https://share.google/sWmPw0Ml2x1f3NPjo" target="_blank" rel="noopener noreferrer" class="btn-footer-map">
          <span>Google Maps Directions ↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
.lush-connect-hub-section {
  background: #FAF7F2;
  min-height: 80vh;
  padding: 32px 16px 64px;
  font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
}

.connect-hub-hero {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 32px;
}

.hub-pill {
  display: inline-block;
  background: rgba(197, 160, 89, 0.15);
  color: #8C6D2D;
  border: 1px solid rgba(197, 160, 89, 0.35);
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 1px;
  margin-bottom: 12px;
}

.hub-hero-title {
  font-family: var(--font-serif, "Playfair Display", Georgia, serif);
  font-size: clamp(2rem, 5vw, 2.7rem);
  font-weight: 800;
  color: #1F1610;
  line-height: 1.2;
  margin: 0 0 12px;
}

.hub-hero-sub {
  font-size: 0.95rem;
  color: #6E5E52;
  line-height: 1.6;
  margin: 0 0 20px;
}

.hub-reward-banner {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #FFFDF9;
  border: 1.5px dashed #C5A059;
  border-radius: 14px;
  padding: 14px 18px;
  text-align: left;
  box-shadow: 0 4px 16px rgba(197, 160, 89, 0.08);
}

.reward-gift-icon {
  font-size: 1.8rem;
  flex-shrink: 0;
}

.hub-reward-banner strong {
  display: block;
  font-size: 0.88rem;
  color: #1F1610;
}

.hub-reward-banner span {
  font-size: 0.82rem;
  color: #6E5E52;
}

.connect-hub-cards-container {
  max-width: 680px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.hub-action-card {
  display: flex;
  gap: 18px;
  background: #FFFFFF;
  border: 1px solid #EAE3DA;
  border-radius: 18px;
  padding: 22px;
  text-decoration: none;
  color: inherit;
  box-shadow: 0 4px 20px rgba(31, 22, 16, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.hub-action-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 28px rgba(31, 22, 16, 0.09);
  border-color: #C5A059;
}

.card-icon-wrap {
  width: 54px;
  height: 54px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-google {
  background: #F1F3F4;
}

.icon-instagram {
  background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%);
}

.icon-whatsapp {
  background: #25D366;
}

.icon-gold {
  background: #FFF9EE;
  border: 1px solid rgba(197, 160, 89, 0.3);
  font-size: 1.8rem;
}

.card-text-wrap {
  flex: 1;
}

.card-badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.card-badge {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.6px;
  color: #8C6D2D;
  background: #FAF7F2;
  padding: 3px 8px;
  border-radius: 6px;
}

.card-stars {
  color: #F59E0B;
  font-size: 0.95rem;
  letter-spacing: 2px;
}

.card-highlight {
  font-size: 0.75rem;
  font-weight: 700;
  color: #16A34A;
}

.card-title {
  font-family: var(--font-serif, "Playfair Display", Georgia, serif);
  font-size: 1.25rem;
  font-weight: 800;
  color: #1F1610;
  margin: 0 0 6px;
  line-height: 1.3;
}

.card-desc {
  font-size: 0.84rem;
  color: #6E5E52;
  line-height: 1.5;
  margin: 0 0 14px;
}

.card-button-row {
  display: flex;
}

.hub-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 10px 18px;
  border-radius: 999px;
  font-size: 0.84rem;
  font-weight: 700;
  transition: opacity 0.2s ease;
}

.hub-btn:hover {
  opacity: 0.9;
}

.hub-btn-google {
  background: #1F1610;
  color: #FFFFFF;
}

.hub-btn-instagram {
  background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
  color: #FFFFFF;
}

.hub-btn-whatsapp {
  background: #25D366;
  color: #FFFFFF;
}

/* Feedback Form Card */
.card-feedback-form {
  cursor: default;
}
.card-feedback-form:hover {
  transform: none;
}

.form-rating-row {
  margin-bottom: 14px;
  background: #FAF7F2;
  padding: 12px 16px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hub-star-picker {
  display: flex;
  gap: 4px;
}

.hub-star {
  background: none;
  border: none;
  font-size: 1.6rem;
  color: #D1C7BD;
  cursor: pointer;
  padding: 0;
  line-height: 1;
  transition: color 0.15s ease, transform 0.15s ease;
}

.hub-star.selected {
  color: #F59E0B;
}

.hub-star:hover {
  transform: scale(1.15);
}

.form-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

@media (max-width: 540px) {
  .form-grid-2 {
    grid-template-columns: 1fr;
  }
}

.form-label {
  display: block;
  font-size: 0.78rem;
  font-weight: 700;
  color: #1F1610;
  margin-bottom: 5px;
}

.form-input {
  width: 100%;
  padding: 10px 14px;
  border: 1.5px solid #EAE3DA;
  border-radius: 10px;
  background: #FAF7F2;
  font-size: 0.86rem;
  color: #1F1610;
  outline: none;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #C5A059;
  background: #FFFFFF;
}

.btn-hub-submit {
  width: 100%;
  margin-top: 14px;
  background: #1F1610;
  color: #FFFFFF;
  border: none;
  padding: 13px;
  border-radius: 10px;
  font-size: 0.9rem;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.2s ease;
}

.btn-hub-submit:hover {
  background: #C5A059;
}

.feedback-success {
  margin-top: 14px;
  background: #ECFDF5;
  border: 1px solid #A7F3D0;
  color: #065F46;
  padding: 12px 16px;
  border-radius: 10px;
  font-size: 0.84rem;
}

/* Store Footer Card */
.connect-hub-store-footer {
  max-width: 680px;
  margin: 28px auto 0;
}

.store-footer-inner {
  background: #FFFFFF;
  border: 1px solid #EAE3DA;
  border-radius: 18px;
  padding: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-shadow: 0 4px 20px rgba(31, 22, 16, 0.04);
}

@media (max-width: 600px) {
  .store-footer-inner {
    flex-direction: column;
    text-align: center;
  }
}

.footer-badge {
  font-size: 0.72rem;
  font-weight: 800;
  color: #C5A059;
  letter-spacing: 0.8px;
  display: block;
  margin-bottom: 4px;
}

.store-footer-text h3 {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 800;
  color: #1F1610;
  margin: 0 0 6px;
}

.store-footer-text p {
  font-size: 0.82rem;
  color: #6E5E52;
  margin: 0 0 4px;
  line-height: 1.4;
}

.store-hours {
  color: #16A34A !important;
  font-weight: 600;
}

.btn-footer-map {
  display: inline-flex;
  align-items: center;
  padding: 10px 18px;
  background: #FAF7F2;
  border: 1.5px solid #C5A059;
  color: #1F1610;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.btn-footer-map:hover {
  background: #C5A059;
  color: #FFFFFF;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Star Picker in Feedback form
  var starPicker = document.getElementById('HubStarPicker');
  var hiddenRating = document.getElementById('FeedbackRating');
  if (starPicker) {
    var stars = starPicker.querySelectorAll('.hub-star');
    stars.forEach(function(s) {
      s.addEventListener('click', function() {
        var val = parseInt(this.getAttribute('data-val'), 10);
        hiddenRating.value = val;
        stars.forEach(function(item) {
          var itemVal = parseInt(item.getAttribute('data-val'), 10);
          if (itemVal <= val) {
            item.classList.add('selected');
          } else {
            item.classList.remove('selected');
          }
        });
      });
    });
  }

  // Handle in-store feedback submission to Supabase
  var form = document.getElementById('InStoreFeedbackForm');
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn = document.getElementById('BtnSubmitFeedback');
      var name = document.getElementById('FeedbackName').value.trim();
      var phone = document.getElementById('FeedbackPhone').value.trim();
      var msg = document.getElementById('FeedbackMsg').value.trim();
      var rating = parseInt(hiddenRating.value, 10) || 5;

      if (!name || !msg) return;

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>Saving Feedback... ✨</span>';
      }

      var supabaseUrl = window.LUSH_SUPABASE_URL || 'https://jhhmnylfpesotguptuec.supabase.co';
      var supabaseKey = window.LUSH_SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpoaG1ueWxmcGVzb3RndXB0dWVjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg1MDkxMTQsImV4cCI6MjEwNDA4NTExNH0.HyAQeIj4n6_oTlZ3XOQFobG8ACLrqw1PUVycldw6now';

      var payload = {
        product_id: 'store_nagpur_walkin',
        product_title: 'Lush Beauty Mart Nagpur Flagship Store',
        reviewer_name: name,
        reviewer_email: phone ? phone + '@phone.store' : '',
        reviewer_city: 'Nagpur Walk-in Shopper',
        rating: rating,
        review_title: 'In-Store Experience Feedback',
        review_body: msg,
        photo_url: '',
        verified_buyer: true,
        helpful_count: 1,
        is_approved: true
      };

      fetch(supabaseUrl.replace(//$/, '') + '/rest/v1/product_reviews', {
        method: 'POST',
        headers: {
          'apikey': supabaseKey,
          'Authorization': 'Bearer ' + supabaseKey,
          'Content-Type': 'application/json',
          'Prefer': 'return=representation'
        },
        body: JSON.stringify(payload)
      })
      .then(function(res) {
        if (!res.ok) throw new Error('Supabase response: ' + res.status);
        return res.json();
      })
      .then(function() {
        form.reset();
        document.getElementById('FeedbackSuccessBox').style.display = 'block';
        if (btn) {
          btn.innerHTML = '<span>Submitted Successfully! ✓</span>';
          btn.style.background = '#16A34A';
        }
      })
      .catch(function(err) {
        console.warn('Feedback submit fallback:', err);
        form.reset();
        document.getElementById('FeedbackSuccessBox').style.display = 'block';
        if (btn) {
          btn.innerHTML = '<span>Submitted Successfully! ✓</span>';
          btn.style.background = '#16A34A';
        }
      });
    });
  }
});
