<section class="lush-wholesale-section">
  <div class="page-width">
    <div class="wholesale-banner-card">
      <div class="wholesale-banner-glow"></div>
      <div class="wholesale-banner-grid">
        <!-- Left info -->
        <div class="wholesale-info">
          <span class="wholesale-tag">🏢 B2B Bulk Purchase & Salon Supply</span>
          <h2 class="wholesale-heading">Retail & Wholesale Available</h2>
          <p class="wholesale-description">
            Are you a salon owner, makeup artist, boutique retailer, or reselling entrepreneur in Vidarbha / Maharashtra? Get direct wholesale carton pricing, customized bridal bundles, and GST invoicing.
          </p>

          <div class="wholesale-perks">
            <div class="perk-item">
              <span class="perk-icon">🏷️</span>
              <div>
                <strong>Up to 60% Margin</strong>
                <span>Competitive bulk rates</span>
              </div>
            </div>
            <div class="perk-item">
              <span class="perk-icon">📦</span>
              <div>
                <strong>Low Minimum MOQs</strong>
                <span>Mix & match options</span>
              </div>
            </div>
            <div class="perk-item">
              <span class="perk-icon">🚚</span>
              <div>
                <strong>Nagpur Fast Dispatch</strong>
                <span>Doorstep delivery</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right CTA Box -->
        <div class="wholesale-cta-box">
          <div class="cta-box-card">
            <span class="cta-card-tag">WHOLESALE ENQUIRY PORTAL</span>
            <h4 class="cta-card-title">Get Instant B2B Rate Sheet</h4>
            <p class="cta-card-sub">Submit your requirements or connect directly on WhatsApp with our wholesale manager.</p>
            <button type="button" class="btn-open-wholesale-modal" data-open-wholesale>
              <span>Contact Us for Wholesale Pricing</span>
              <span class="btn-arrow">→</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wholesale Banner",
  "settings": [],
  "presets": [
    {
      "name": "Wholesale Banner"
    }
  ]
}
{% endschema %}
