{% comment %}
  Lush Beauty Mart — Nykaa Luxe Style "Brand Spotlight Carousel" Section
  Showcases top authorized brand partners with guaranteed authentic local vector/PNG logos
{% endcomment %}

<style>
.brand-card-logo,
.brand-logo-area img,
.brand-logo-area svg {
  max-height: 46px !important;
  max-width: 130px !important;
  width: auto !important;
  height: auto !important;
  object-fit: contain !important;
  display: block !important;
  margin: 0 auto !important;
  filter: none !important;
  opacity: 1 !important;
  visibility: visible !important;
}

.brand-logo-area {
  margin: 10px 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 50px !important;
  width: 100% !important;
}
</style>

<section class="lush-brands-section" id="BrandSpotlightSection">
  <div class="page-width brands-container">
    <!-- Header -->
    <div class="section-header-center">
      {%- if section.settings.badge != blank -%}
        <span class="brand-badge-pill">{{ section.settings.badge }}</span>
      {%- endif -%}
      <h2 class="brand-section-title">{{ section.settings.title | default: 'Featured Brand Spotlight' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="brand-section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- Brands Carousel Track -->
    <div class="brands-carousel-wrap">
      <div class="brands-track-container" data-brand-track>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <a
              href="{{ block.settings.link | default: '/collections/all' }}"
              class="brand-card-item"
              {{ block.shopify_attributes }}
            >
              <div class="brand-verified-pill">
                <span class="verified-check">✓</span>
                <span>AUTHORIZED STORE</span>
              </div>

              <div class="brand-logo-area">
                {%- if block.settings.brand_image != blank -%}
                  {%- if block.settings.brand_image.src -%}
                    <img
                      src="{{ block.settings.brand_image | image_url: width: 280 }}"
                      alt="{{ block.settings.title | escape }}"
                      class="brand-card-logo"
                      width="140"
                      height="60"
                      loading="lazy"
                    >
                  {%- elsif block.settings.brand_image contains '/' -%}
                    <img
                      src="{{ block.settings.brand_image }}"
                      alt="{{ block.settings.title | escape }}"
                      class="brand-card-logo"
                      width="140"
                      height="60"
                      loading="lazy"
                    >
                  {%- else -%}
                    <img
                      src="{{ block.settings.brand_image | asset_url }}"
                      alt="{{ block.settings.title | escape }}"
                      class="brand-card-logo"
                      width="140"
                      height="60"
                      loading="lazy"
                    >
                  {%- endif -%}
                {%- else -%}
                  {% render 'brand-logo', brand: block.settings.title, class: 'brand-card-logo' %}
                {%- endif -%}
              </div>

              <div class="brand-offer-tag">
                <span>{{ block.settings.offer_tag | default: 'Up to 25% OFF' }}</span>
              </div>

              <span class="brand-explore-btn">
                <span>Shop Collection</span>
                <span>→</span>
              </span>
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Top Brands with Authentic Visual Logos -->
          <a href="{% if collections['skin1004'] != blank %}{{ collections['skin1004'].url }}{% else %}/collections/all?filter.p.vendor=SKIN1004{% endif %}" class="brand-card-item">
