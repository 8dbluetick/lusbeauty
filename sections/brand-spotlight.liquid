          "settings": {
            "title": "L'ORÉAL PARIS",
            "offer_tag": "Up to 30% OFF",
            "link": "/collections/all"
          }
        },
        {
          "type": "brand_card",
          "settings": {
            "title": "MAYBELLINE NY",
            "offer_tag": "Flat 20% OFF • Lipsticks",
            "link": "/collections/all"
          }
        },
        {
          "type": "brand_card",
          "settings": {
            "title": "PLUM GOODNESS",
            "offer_tag": "100% Vegan & Cruelty Free",
            "link": "/collections/all"
          }
        },
        {
          "type": "brand_card",
          "settings": {
            "title": "SWISS BEAUTY",
            "offer_tag": "Starting at just ₹199",
            "link": "/collections/all"
          }
        }
      ]
    }
  ]
}
