{% comment %}
  Lush Beauty Mart — Nykaa Luxe Style "Brand Spotlight Carousel" Section
  Showcases top authorized brand partners (Minimalist, The Derma Co, L'Oreal, Maybelline, Plum, Swiss Beauty)
{% endcomment %}

<section class="lush-brands-section" id="BrandSpotlightSection">
  <div class="page-width brands-container">
    <!-- Header -->
    <div class="section-header-center">
      {%- if section.settings.badge != blank -%}
        <span class="brand-badge-pill">{{ section.settings.badge }}</span>
      {%- endif -%}
      <h2 class="brand-section-title">{{ section.settings.title | default: 'Featured Brand Spotlight' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="brand-section-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <!-- Brands Carousel Track -->
    <div class="brands-carousel-wrap">
      <div class="brands-track-container" data-brand-track>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <a
              href="{{ block.settings.link | default: '/collections/all' }}"
              class="brand-card-item"
              {{ block.shopify_attributes }}
            >
              <div class="brand-verified-pill">
                <span class="verified-check">✓</span>
                <span>AUTHORIZED STORE</span>
              </div>

              <div class="brand-logo-area">
                {%- if block.settings.brand_image != blank -%}
                  <img
                    src="{{ block.settings.brand_image }}"
                    alt="{{ block.settings.title | escape }}"
                    class="brand-card-logo"
                    width="140"
                    height="60"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="brand-card-name">{{ block.settings.title }}</span>
                {%- endif -%}
              </div>

              <div class="brand-offer-tag">
                <span>{{ block.settings.offer_tag | default: 'Up to 25% OFF' }}</span>
              </div>

              <span class="brand-explore-btn">
                <span>Shop Collection</span>
                <span>→</span>
              </span>
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Default 6 Top Brands -->
          <a href="/collections/all" class="brand-card-item">
            <div class="brand-verified-pill"><span class="verified-check">✓</span><span>AUTHORIZED</span></div>
            <div class="brand-logo-area"><span class="brand-card-name">MINIMALIST</span></div>
            <div class="brand-offer-tag"><span>Up to 15% OFF • Serums</span></div>
            <span class="brand-explore-btn"><span>Shop Brand</span><span>→</span></span>
          </a>

          <a href="/collections/all" class="brand-card-item">
            <div class="brand-verified-pill"><span class="verified-check">✓</span><span>AUTHORIZED</span></div>
            <div class="brand-logo-area"><span class="brand-card-name">THE DERMA CO</span></div>
            <div class="brand-offer-tag"><span>Buy 2 Get 10% OFF</span></div>
            <span class="brand-explore-btn"><span>Shop Brand</span><span>→</span></span>
          </a>

          <a href="/collections/all" class="brand-card-item">
            <div class="brand-verified-pill"><span class="verified-check">✓</span><span>AUTHORIZED</span></div>
            <div class="brand-logo-area"><span class="brand-card-name">L'ORÉAL PARIS</span></div>
            <div class="brand-offer-tag"><span>Up to 30% OFF • Hair & Face</span></div>
            <span class="brand-explore-btn"><span>Shop Brand</span><span>→</span></span>
          </a>

          <a href="/collections/all" class="brand-card-item">
            <div class="brand-verified-pill"><span class="verified-check">✓</span><span>AUTHORIZED</span></div>
            <div class="brand-logo-area"><span class="brand-card-name">MAYBELLINE NY</span></div>
            <div class="brand-offer-tag"><span>Flat 20% OFF • Lipsticks</span></div>
            <span class="brand-explore-btn"><span>Shop Brand</span><span>→</span></span>
          </a>

          <a href="/collections/all" class="brand-card-item">
            <div class="brand-verified-pill"><span class="verified-check">✓</span><span>AUTHORIZED</span></div>
            <div class="brand-logo-area"><span class="brand-card-name">PLUM GOODNESS</span></div>
            <div class="brand-offer-tag"><span>100% Vegan & Cruelty Free</span></div>
            <span class="brand-explore-btn"><span>Shop Brand</span><span>→</span></span>
          </a>

          <a href="/collections/all" class="brand-card-item">
            <div class="brand-verified-pill"><span class="verified-check">✓</span><span>AUTHORIZED</span></div>
            <div class="brand-logo-area"><span class="brand-card-name">SWISS BEAUTY</span></div>
            <div class="brand-offer-tag"><span>Starting at just ₹199</span></div>
            <span class="brand-explore-btn"><span>Shop Brand</span><span>→</span></span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- View All Brands Directory CTA Button -->
    <div style="text-align: center; margin-top: 28px;">
      <a href="/collections" class="btn-hero-primary" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 28px; font-size: 0.82rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; border-radius: 999px; text-decoration: none;">
        <span>👑 Explore All Authorized Brands (A–Z)</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "🌟 100% GENUINE PARTNERS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Official Brand Spotlight"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Sourced directly from certified brand distributors and stocked in our Nagpur Showroom."
    }
  ],
  "blocks": [
    {
      "type": "brand_card",
      "name": "Brand Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Brand Name",
          "default": "Minimalist"
        },
        {
          "type": "text",
          "id": "brand_image",
          "label": "Brand Logo Image URL (Optional)"
        },
        {
          "type": "text",
          "id": "offer_tag",
          "label": "Promotional Tag",
          "default": "Up to 20% OFF"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Spotlight",
      "blocks": [
        {
          "type": "brand_card",
          "settings": {
            "title": "MINIMALIST",
            "offer_tag": "Up to 15% OFF • Serums",
            "link": "/collections/all"
          }
        },
        {
          "type": "brand_card",
          "settings": {
            "title": "THE DERMA CO",
            "offer_tag": "Buy 2 Get 10% OFF",
            "link": "/collections/all"
          }
        },
        {
