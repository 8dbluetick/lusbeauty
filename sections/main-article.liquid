{% comment %}
  Lush Beauty Mart — Single Article Reader Section
{% endcomment %}

<article class="main-article-section" style="max-width: 800px; margin: 40px auto 80px; padding: 0 16px; min-height: 60vh;">
  <div style="margin-bottom: 24px;">
    <a href="{{ blog.url }}" style="font-size: 0.78rem; font-weight: 800; color: #C5A059; text-decoration: none;">← Back to {{ blog.title }}</a>
  </div>

  <header style="margin-bottom: 28px;">
    <span style="font-size: 0.75rem; color: #8A7363; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; display: block; margin-bottom: 8px;">
      {{ article.published_at | date: "%B %d, %Y" }} • By {{ article.author | default: 'Lush Beauty Team' }}
    </span>
    <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 800; color: #1F1610; line-height: 1.25; margin: 0 0 16px;">
      {{ article.title }}
    </h1>
  </header>

  {%- if article.image -%}
    <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: 16px; margin-bottom: 30px; border: 1px solid #EAE3DA;">
      <img src="{{ article.image | image_url: width: 1000 }}" alt="{{ article.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
    </div>
  {%- endif -%}

  <div class="rte article-body-content" style="font-size: 0.95rem; line-height: 1.85; color: #3E3027;">
    {{ article.content }}
  </div>
</article>

{% schema %}
{
  "name": "Article Content",
  "settings": []
}
{% endschema %}
