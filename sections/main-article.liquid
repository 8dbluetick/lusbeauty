{% comment %}
  Lush Beauty Mart — Luxury Editorial Article Reader Section (Vogue / Harper's Bazaar Style)
{% endcomment %}

<div class="lush-article-wrapper" style="background: #FAF7F2; padding: 30px 0 80px; min-height: 80vh;">
  <article class="page-width main-article-section" style="max-width: 860px; margin: 0 auto; padding: 0 16px;">
    
    <!-- Breadcrumb -->
    <nav style="display: flex; align-items: center; gap: 8px; font-size: 0.75rem; color: #8A7363; margin-bottom: 24px;">
      <a href="/" style="color: #6E5E52; text-decoration: none;">Home</a>
      <span>/</span>
      <a href="{{ blog.url }}" style="color: #6E5E52; text-decoration: none;">{{ blog.title }}</a>
      <span>/</span>
      <span style="color: #C5A059; font-weight: 700;">{{ article.title | truncate: 35 }}</span>
    </nav>

    <!-- Article Header -->
    <header style="margin-bottom: 30px; text-align: center;">
      <span style="display: inline-block; padding: 4px 14px; background: rgba(197, 160, 89, 0.15); border: 1px solid rgba(197, 160, 89, 0.35); border-radius: 999px; font-size: 0.72rem; font-weight: 800; color: #8B6F3E; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 14px;">
        ✨ LUSH BEAUTY EDITORIAL
      </span>
      <h1 style="font-family: var(--font-serif); font-size: clamp(2rem, 4.5vw, 2.8rem); font-weight: 800; color: #1F1610; line-height: 1.2; margin: 0 0 18px;">
        {{ article.title }}
      </h1>

      <!-- Byline & Meta -->
      <div style="display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 12px; font-size: 0.8rem; color: #6E5E52; font-weight: 600;">
        <span>Published on {{ article.published_at | date: "%B %d, %Y" }}</span>
        <span>•</span>
        <span>⏱️ 4 Min Read</span>
        <span>•</span>
        <span>By {{ article.author | default: 'Lush Beauty Team' }}</span>
      </div>
    </header>

    <!-- Featured Image -->
    {%- if article.image -%}
      <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: 20px; margin-bottom: 36px; border: 1px solid #EAE3DA; box-shadow: 0 8px 30px rgba(31, 22, 16, 0.06); background: #FFFFFF;">
        <img
          src="{{ article.image | image_url: width: 1200 }}"
          alt="{{ article.title | escape }}"
          style="width: 100%; height: 100%; object-fit: cover;"
          loading="eager"
          width="860"
          height="480"
        >
      </div>
    {%- endif -%}

    <!-- Main Content Body (Rich Text) -->
    <div class="rte article-body-content" style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 20px; padding: 36px 30px; box-shadow: 0 4px 20px rgba(31, 22, 16, 0.03); font-size: 0.98rem; line-height: 1.85; color: #3E3027;">
      {{ article.content }}
    </div>

    <!-- Share Strip -->
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 14px; padding: 18px 24px; margin: 30px 0;">
      <span style="font-size: 0.82rem; font-weight: 800; color: #1F1610; text-transform: uppercase; letter-spacing: 0.04em;">
        Share this Beauty Guide:
      </span>
      <div style="display: flex; gap: 10px;">
        <a
          href="https://api.whatsapp.com/send?text={{ article.title | url_encode }}%20-%20{{ shop.url | append: article.url | url_encode }}"
          target="_blank"
          rel="noopener"
          style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; background: #25D366; color: #FFFFFF; font-size: 0.78rem; font-weight: 700; border-radius: 8px; text-decoration: none;"
        >
          <span>Share on WhatsApp</span>
        </a>
        <button
          type="button"
          onclick="navigator.clipboard.writeText(window.location.href); this.textContent='✓ Copied!'; setTimeout(() => this.textContent='Copy Link', 2000);"
          style="padding: 8px 16px; background: #FAF7F2; border: 1px solid #EAE3DA; color: #1F1610; font-size: 0.78rem; font-weight: 700; border-radius: 8px; cursor: pointer;"
        >
          Copy Link
        </button>
      </div>
    </div>

    <!-- Back to Journal CTA -->
    <div style="text-align: center; margin-top: 36px;">
      <a href="{{ blog.url }}" style="display: inline-flex; align-items: center; gap: 8px; padding: 12px 24px; background: #1F1610; color: #C5A059; font-size: 0.8rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; border-radius: 8px; text-decoration: none;">
        <span>← Back to Beauty Journal</span>
      </a>
    </div>

  </article>
</div>

{% schema %}
{
  "name": "Article Content",
  "settings": []
}
{% endschema %}
