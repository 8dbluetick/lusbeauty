<script>
document.addEventListener('DOMContentLoaded', () => {
  const searchInput = document.getElementById('BrandSearchInput');
  const cards = document.querySelectorAll('.brand-dir-card');
  const countPill = document.getElementById('BrandCountPill');
  const letterBtns = document.querySelectorAll('.letter-btn');

  let activeLetter = 'ALL';

  function filterBrands() {
    const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
    let visibleCount = 0;

    cards.forEach(card => {
      const name = (card.getAttribute('data-brand-name') || '').toLowerCase();
      const letter = card.getAttribute('data-brand-letter') || '';
      const cat = (card.getAttribute('data-brand-cat') || '').toLowerCase();

      const matchQuery = !query || name.includes(query) || cat.includes(query);
      const matchLetter = activeLetter === 'ALL' || letter === activeLetter;

      if (matchQuery && matchLetter) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (countPill) {
      countPill.textContent = `${visibleCount} ${visibleCount === 1 ? 'Brand' : 'Brands'}`;
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterBrands);
  }

  letterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      letterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeLetter = btn.getAttribute('data-letter') || 'ALL';
      filterBrands();
    });
  });
});
</script>

