      <div class="brand-dir-card" data-brand-name="Centella SKIN1004 Madagascar Centella" data-brand-letter="C" data-brand-letter-alt="S" data-brand-cat="Korean Skincare">
        <span class="brand-verified-tag">✓ AUTHORIZED</span>
        <div class="brand-dir-logo-wrap">
          {% render 'brand-logo', brand: 'skin1004', class: 'brand-dir-logo-img' %}
        </div>
        <h3 class="brand-dir-name">SKIN1004 Madagascar Centella</h3>
        <span class="brand-dir-cat">Korean Soothing Cica Skincare</span>
        <a href="{% if collections['skin1004'] != blank %}{{ collections['skin1004'].url }}{% elsif collections['centella'] != blank %}{{ collections['centella'].url }}{% else %}/collections/all?filter.p.vendor=SKIN1004{% endif %}" class="btn-brand-explore">
          <span>Shop SKIN1004</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const searchInput = document.getElementById('BrandSearchInput');
  const cards = document.querySelectorAll('.brand-dir-card');
  const countPill = document.getElementById('BrandCountPill');
  const letterBtns = document.querySelectorAll('.letter-btn');

  let activeLetter = 'ALL';

  function filterBrands() {
    const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
    let visibleCount = 0;

    cards.forEach(card => {
      const name = (card.getAttribute('data-brand-name') || '').toLowerCase();
      const letter = card.getAttribute('data-brand-letter') || '';
      const letterAlt = card.getAttribute('data-brand-letter-alt') || '';
      const cat = (card.getAttribute('data-brand-cat') || '').toLowerCase();

      const matchQuery = !query || name.includes(query) || cat.includes(query);
      const matchLetter = activeLetter === 'ALL' || letter === activeLetter || letterAlt === activeLetter;

      if (matchQuery && matchLetter) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (countPill) {
      countPill.textContent = `${visibleCount} ${visibleCount === 1 ? 'Brand' : 'Brands'}`;
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterBrands);
  }

  letterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      letterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeLetter = btn.getAttribute('data-letter') || 'ALL';
      filterBrands();
    });
  });
});
</script>

{% schema %}
{
  "name": "Brands Directory",
  "settings": []
}
{% endschema %}
