{% comment %}
  Lush Beauty Mart — All Brands Directory (Nykaa / Sephora Style)
  Interactive search, A-Z letter filters, and 1-click vendor collection links
{% endcomment %}

<section class="lush-brands-directory-section">
  <div class="page-width">
    <!-- Header -->
    <div class="brands-dir-header">
      <span class="brands-dir-badge">👑 OFFICIAL LUXURY DIRECTORY</span>
      <h1 class="brands-dir-title">Shop by Authorized Brand</h1>
      <p class="brands-dir-sub">100% Authentic products sourced directly from verified brand partners & stocked in our Nagpur Flagship Showroom.</p>
      
      <!-- Interactive Brand Search -->
      <div class="brands-search-wrap">
        <svg class="brands-search-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="BrandSearchInput" class="brands-search-input" placeholder="Search brand by name (e.g. Minimalist, MAC, Dot & Key, L'Oreal)..." autocomplete="off">
        <span class="brands-count-pill" id="BrandCountPill">24 Brands</span>
      </div>

      <!-- Alphabet Letter Filter Bar -->
      <div class="brands-alphabet-bar" id="BrandAlphabetBar">
        <button type="button" class="letter-btn active" data-letter="ALL">ALL</button>
        <button type="button" class="letter-btn" data-letter="B">B</button>
        <button type="button" class="letter-btn" data-letter="C">C</button>
        <button type="button" class="letter-btn" data-letter="D">D</button>
        <button type="button" class="letter-btn" data-letter="E">E</button>
        <button type="button" class="letter-btn" data-letter="G">G</button>
        <button type="button" class="letter-btn" data-letter="H">H</button>
        <button type="button" class="letter-btn" data-letter="K">K</button>
        <button type="button" class="letter-btn" data-letter="L">L</button>
        <button type="button" class="letter-btn" data-letter="M">M</button>
        <button type="button" class="letter-btn" data-letter="N">N</button>
        <button type="button" class="letter-btn" data-letter="P">P</button>
        <button type="button" class="letter-btn" data-letter="R">R</button>
        <button type="button" class="letter-btn" data-letter="S">S</button>
        <button type="button" class="letter-btn" data-letter="T">T</button>
        <button type="button" class="letter-btn" data-letter="V">V</button>
        <button type="button" class="letter-btn" data-letter="Y">Y</button>
      </div>
    </div>

