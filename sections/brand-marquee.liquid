          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914434/L_Oreal_Professionnel_Logo_f0y489.jpg" alt="L'Oréal Professionnel" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/Minimalist_Logo_prha1q.jpg" alt="Minimalist" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/Cetaphil_Logo_aoujzk.jpg" alt="Cetaphil" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/MAC_Cosmetics_Logo_ncog8r.jpg" alt="M·A·C Cosmetics" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/L_Oreal_Paris_Logo_kxwxbt.jpg" alt="L'Oréal Paris" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/e.l.f._Cosmetics_Logo_y5bqon.jpg" alt="e.l.f. Cosmetics" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/The_Ordinary_Logo_j9mzhc.jpg" alt="The Ordinary" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/Laneige_Logo_ge6cmm.jpg" alt="Laneige" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/Charlotte_Tilbury_Logo_qxeunb.jpg" alt="Charlotte Tilbury" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/Dove_Logo_a1cwpw.jpg" alt="Dove" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
