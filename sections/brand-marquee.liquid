{% schema %}
{
  "name": "Brand Logo Marquee",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "100% Genuine Authorized Brands"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fresh stocks sourced directly from official brand houses & available in our Nagpur Showroom."
    },
    {
      "type": "range",
      "id": "speed",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Marquee Scroll Speed",
      "default": 35
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    }
  ],
  "presets": [
    {
      "name": "Brand Logo Marquee"
    }
  ]
}
{% endschema %}
