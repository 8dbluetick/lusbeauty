{% comment %}
  Lush Beauty Mart — Infinite Running Brand Logo Marquee
  Smooth continuous marquee of 100% genuine authorized brands
{% endcomment %}

<section class="lush-brand-marquee-section" id="BrandMarqueeSection" style="background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};">
  <div class="page-width brand-marquee-header-wrap">
    <div class="brand-marquee-title-row">
      <span class="brand-marquee-badge">🌟 100% ORIGINAL & AUTHORIZED</span>
      <h2 class="brand-marquee-heading">{{ section.settings.heading | default: 'Trusted Luxury Brand Partners' }}</h2>
      <p class="brand-marquee-sub">{{ section.settings.subheading | default: 'Stocked fresh in our Nagpur Flagship Showroom & available for pan-India delivery.' }}</p>
    </div>
  </div>

  <div class="brand-marquee-container">
    <div class="brand-marquee-track" style="animation-duration: {{ section.settings.speed | default: 35 }}s;">
      <!-- Group 1 -->
      <div class="brand-marquee-content">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="brand-logo-card" title="{{ block.settings.brand_name | escape }}" {{ block.shopify_attributes }}>
              <img
                src="{{ block.settings.logo_url }}"
                alt="{{ block.settings.brand_name | escape }}"
                class="brand-marquee-logo-img"
                width="140"
                height="45"
                loading="lazy"
              >
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Default 17 Luxury Brand Logos -->
          <a href="/collections/all" class="brand-logo-card" title="Dot & Key"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914434/Dot_Key_Logo_l2cw3q.jpg" alt="Dot & Key" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" title="Kay Beauty"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914434/Kay_Beauty_Logo_jvwfqj.jpg" alt="Kay Beauty" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
