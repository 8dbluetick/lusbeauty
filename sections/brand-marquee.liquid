                    >
                  {%- endif -%}
                {%- else -%}
                  {% render 'brand-logo', brand: b_title, class: 'brand-marquee-logo-img' %}
                {%- endif -%}
              </div>
              <span class="brand-card-logo-title">{{ b_title }}</span>
            </a>
          {%- endfor -%}
