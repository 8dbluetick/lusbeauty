{% comment %}
  Lush Beauty Mart — Infinite Running Brand Logo Marquee
  Smooth non-stop continuous loop of 100% genuine authorized brands
{% endcomment %}

<style>
.lush-brand-marquee-section {
  padding: 26px 0 32px;
  background-color: {{ section.settings.bg_color | default: '#FAF7F2' }};
  border-top: 1px solid #EAE3DA;
  border-bottom: 1px solid #EAE3DA;
  overflow: hidden;
  position: relative;
  width: 100%;
  display: block;
}

.brand-marquee-header-wrap {
  text-align: center;
  margin-bottom: 16px;
}

.brand-marquee-badge {
  display: inline-flex;
  padding: 4px 12px;
  background: rgba(197, 160, 89, 0.15);
  border: 1px solid rgba(197, 160, 89, 0.4);
  border-radius: 999px;
  color: #8B6F3E;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.brand-marquee-heading {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.85rem;
  font-weight: 800;
  color: #1F1610;
  margin: 0 0 6px;
}

.brand-marquee-sub {
  font-size: 0.88rem;
  color: #6E5E52;
  margin: 0 auto;
  max-width: 540px;
}

.brand-marquee-container {
  width: 100%;
  overflow: hidden;
  position: relative;
  padding: 8px 0;
  mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
}

.brand-marquee-track {
  display: flex !important;
  width: max-content !important;
  animation: brandMarqueeScroll {{ section.settings.speed | default: 35 }}s linear infinite !important;
}

@keyframes brandMarqueeScroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

.brand-marquee-content {
  display: flex !important;
  align-items: center !important;
  gap: 16px !important;
  padding-right: 16px !important;
  flex-shrink: 0 !important;
}

.brand-logo-card {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 8px 20px !important;
  height: 56px !important;
  min-width: 135px !important;
  background: #FFFFFF !important;
  border: 1.5px solid #EAE3DA !important;
  border-radius: 12px !important;
  box-shadow: 0 2px 8px rgba(31, 22, 16, 0.04) !important;
  flex-shrink: 0 !important;
  cursor: pointer !important;
  text-decoration: none !important;
  user-select: none !important;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease !important;
}
.brand-logo-card:hover {
  transform: translateY(-2px) !important;
  border-color: #C5A059 !important;
  box-shadow: 0 6px 14px rgba(197, 160, 89, 0.18) !important;
}

.brand-marquee-logo-img {
  max-height: 38px !important;
  max-width: 115px !important;
  width: auto !important;
  height: auto !important;
  object-fit: contain !important;
  display: block !important;
}

@media (max-width: 767px) {
  .lush-brand-marquee-section {
    padding: 28px 0 34px;
  }
  .brand-marquee-heading {
    font-size: 1.35rem;
  }
  .brand-logo-card {
    height: 48px !important;
    padding: 6px 14px !important;
    min-width: 105px !important;
  }
  .brand-marquee-logo-img {
    max-height: 30px !important;
    max-width: 95px !important;
  }
}
</style>

