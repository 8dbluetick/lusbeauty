                    src="{{ block.settings.image | image_url: width: 240 }}"
                    alt="{{ b_title | escape }}"
                    class="brand-marquee-logo-img"
                    width="120"
                    height="32"
                    loading="lazy"
                  >
                {%- elsif block.settings.brand_image != blank -%}
                  {%- if block.settings.brand_image contains '/' -%}
