          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914432/Estee_Lauder_Logo_mxv7lr.jpg" alt="Estée Lauder" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914432/Love_Beauty_Planet_Logo_swz3db.jpg" alt="Love Beauty & Planet" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" tabindex="-1"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914432/Bath_Body_Works_Logo_hxmfwr.jpg" alt="Bath & Body Works" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
        {%- endif -%}
      </div>
    </div>
