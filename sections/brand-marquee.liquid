          <a href="/collections/all" class="brand-logo-card" title="L'Oréal Professionnel"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914434/L_Oreal_Professionnel_Logo_f0y489.jpg" alt="L'Oréal Professionnel" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" title="Minimalist"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/Minimalist_Logo_prha1q.jpg" alt="Minimalist" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" title="Cetaphil"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/Cetaphil_Logo_aoujzk.jpg" alt="Cetaphil" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" title="M·A·C Cosmetics"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/MAC_Cosmetics_Logo_ncog8r.jpg" alt="M·A·C Cosmetics" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" title="L'Oréal Paris"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/L_Oreal_Paris_Logo_kxwxbt.jpg" alt="L'Oréal Paris" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
