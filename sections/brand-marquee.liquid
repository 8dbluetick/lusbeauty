        {%- endif -%}
      </div>

      <!-- Group 2 (Duplicate for Seamless Infinite Marquee Loop) -->
      <div class="brand-marquee-content" aria-hidden="true">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="brand-logo-card" tabindex="-1">
              <img
                src="{{ block.settings.logo_url }}"
