{% comment %}
  Lush Beauty Mart — Logo Carousel / Scrolling Logos (Infinite Running Marquee)
  Supports full customizable blocks in the Shopify Theme Customizer left sidebar with image upload & automatic authentic fallback
{% endcomment %}

<style>
.lush-brand-marquee-section {
  padding: 26px 0 32px;
  background-color: {{ section.settings.bg_color | default: '#FAF7F2' }};
  border-top: 1px solid #EAE3DA;
  border-bottom: 1px solid #EAE3DA;
  overflow: hidden;
  position: relative;
  width: 100%;
  display: block;
}

.brand-marquee-header-wrap {
  text-align: center;
  margin-bottom: 16px;
}

.brand-marquee-badge {
  display: inline-flex;
  padding: 4px 12px;
  background: rgba(197, 160, 89, 0.15);
  border: 1px solid rgba(197, 160, 89, 0.4);
  border-radius: 999px;
  color: #8B6F3E;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.brand-marquee-heading {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 1.85rem;
  font-weight: 800;
  color: #1F1610;
  margin: 0 0 6px;
}

.brand-marquee-sub {
  font-size: 0.88rem;
  color: #6E5E52;
  margin: 0 auto;
  max-width: 540px;
}

.brand-marquee-container {
  width: 100%;
  overflow: hidden;
  position: relative;
  padding: 8px 0;
  mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
}

.brand-marquee-track {
  display: flex !important;
  width: max-content !important;
  animation: brandMarqueeScroll {{ section.settings.speed | default: 45 }}s linear infinite !important;
}

.brand-marquee-track:hover {
  animation-play-state: paused !important;
}

@keyframes brandMarqueeScroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

.brand-marquee-content {
  display: flex !important;
  align-items: center !important;
  gap: 16px !important;
  padding-right: 16px !important;
  flex-shrink: 0 !important;
}

.brand-logo-card {
  display: inline-flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 10px 16px !important;
  height: 68px !important;
  min-width: 140px !important;
  background: #FFFFFF !important;
  border: 1.5px solid #EAE3DA !important;
  border-radius: 12px !important;
  box-shadow: 0 2px 8px rgba(31, 22, 16, 0.04) !important;
  flex-shrink: 0 !important;
  cursor: pointer !important;
  text-decoration: none !important;
  user-select: none !important;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease !important;
  gap: 6px !important;
}

.brand-logo-card:hover {
  transform: translateY(-2px) !important;
  border-color: #C5A059 !important;
  box-shadow: 0 6px 14px rgba(197, 160, 89, 0.18) !important;
}

.brand-card-logo-wrap {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  height: 32px !important;
  width: 100% !important;
}

.brand-marquee-logo-img,
.brand-card-logo-wrap img,
.brand-card-logo-wrap svg {
  max-height: 30px !important;
  max-width: 110px !important;
  width: auto !important;
  height: auto !important;
  object-fit: contain !important;
  display: block !important;
  margin: 0 auto !important;
  filter: none !important;
  opacity: 1 !important;
  visibility: visible !important;
}

.brand-card-logo-title {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif !important;
  font-size: 0.65rem !important;
  font-weight: 800 !important;
  letter-spacing: 0.8px !important;
  text-transform: uppercase !important;
  color: #1F1610 !important;
  white-space: nowrap !important;
  line-height: 1 !important;
}

@media (max-width: 767px) {
  .lush-brand-marquee-section {
    padding: 22px 0 28px !important;
  }
  .brand-marquee-heading {
    font-size: 1.35rem !important;
  }
  .brand-logo-card {
    height: 56px !important;
    padding: 6px 12px !important;
    min-width: 115px !important;
    gap: 4px !important;
  }
  .brand-card-logo-wrap {
    height: 26px !important;
  }
  .brand-marquee-logo-img,
  .brand-card-logo-wrap img,
  .brand-card-logo-wrap svg {
    max-height: 24px !important;
    max-width: 90px !important;
  }
  .brand-card-logo-title {
    font-size: 0.58rem !important;
    letter-spacing: 0.5px !important;
  }
}
</style>

<section class="lush-brand-marquee-section" id="BrandMarqueeSection">
