          <a href="/collections/all" class="brand-logo-card" title="Laneige"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/Laneige_Logo_ge6cmm.jpg" alt="Laneige" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
          <a href="/collections/all" class="brand-logo-card" title="Charlotte Tilbury"><img src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787914433/Charlotte_Tilbury_Logo_qxeunb.jpg" alt="Charlotte Tilbury" class="brand-marquee-logo-img" width="140" height="45" loading="lazy"></a>
