      <h2 class="brand-marquee-heading">{{ section.settings.heading | default: '100% Genuine Authorized Brands' }}</h2>
      <p class="brand-marquee-sub">{{ section.settings.subheading | default: 'Fresh stocks sourced directly from official brand houses & available in our Nagpur Showroom.' }}</p>
