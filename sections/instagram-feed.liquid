<section class="lush-instagram-section">
  <div class="page-width">
    <div class="section-header-center">
      <span class="section-badge">📸 Social Gallery</span>
      <h2 class="section-title">Follow {{ settings.social_instagram_handle | default: "@lushbeautymart" }}</h2>
      <p class="section-subtitle">Discover our latest arrivals, festive collections and store updates from our Nagpur showroom.</p>
    </div>

    <!-- 3x3 Responsive Grid -->
    <div class="insta-grid-3x3">
      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="insta-card group">
        <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=600&auto=format&fit=crop" alt="Lush Beauty Mart Jewellery" class="insta-img" loading="lazy" width="400" height="400">
        <div class="insta-overlay">
          <span class="insta-icon">📷</span>
          <p class="insta-caption">Bridal Kundan Collection ✨ #LushJewels</p>
        </div>
      </a>

      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="insta-card group">
        <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?q=80&w=600&auto=format&fit=crop" alt="Lush Beauty Mart Cosmetics" class="insta-img" loading="lazy" width="400" height="400">
        <div class="insta-overlay">
          <span class="insta-icon">📷</span>
          <p class="insta-caption">Velvet Matte Lipsticks 💄 #LushCosmetics</p>
        </div>
      </a>

      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="insta-card group">
        <img src="https://images.unsplash.com/photo-1584917865442-de89df76afd3?q=80&w=600&auto=format&fit=crop" alt="Lush Beauty Mart Handbags" class="insta-img" loading="lazy" width="400" height="400">
        <div class="insta-overlay">
          <span class="insta-icon">📷</span>
          <p class="insta-caption">Structured Handbags 👜 #NagpurFashion</p>
        </div>
      </a>

      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="insta-card group">
        <img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?q=80&w=600&auto=format&fit=crop" alt="Lush Beauty Mart Skincare" class="insta-img" loading="lazy" width="400" height="400">
        <div class="insta-overlay">
          <span class="insta-icon">📷</span>
          <p class="insta-caption">Botanical Glow Essentials 🌿</p>
        </div>
      </a>

      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="insta-card group">
        <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=600&auto=format&fit=crop" alt="Lush Beauty Mart Nagpur Store" class="insta-img" loading="lazy" width="400" height="400">
        <div class="insta-overlay">
          <span class="insta-icon">📷</span>
          <p class="insta-caption">Nagpur Store at Lad Square 📍</p>
        </div>
      </a>

      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="insta-card group">
        <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?q=80&w=600&auto=format&fit=crop" alt="Lush Beauty Mart Rings" class="insta-img" loading="lazy" width="400" height="400">
        <div class="insta-overlay">
          <span class="insta-icon">📷</span>
          <p class="insta-caption">Statement AD Rings ✨ #LushJewellery</p>
        </div>
      </a>

      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="insta-card group">
        <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?q=80&w=600&auto=format&fit=crop" alt="Lush Beauty Mart Beauty Tools" class="insta-img" loading="lazy" width="400" height="400">
        <div class="insta-overlay">
          <span class="insta-icon">📷</span>
          <p class="insta-caption">Pro Makeup Brushes 🪄</p>
        </div>
      </a>

      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="insta-card group">
        <img src="https://images.unsplash.com/photo-1566150905458-1bf1fc113f0d?q=80&w=600&auto=format&fit=crop" alt="Lush Beauty Mart Slings" class="insta-img" loading="lazy" width="400" height="400">
        <div class="insta-overlay">
          <span class="insta-icon">📷</span>
          <p class="insta-caption">Quilted Sling Bags 🎀</p>
        </div>
      </a>

      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="insta-card group">
        <img src="https://images.unsplash.com/photo-1513885535751-8b9238bd345a?q=80&w=600&auto=format&fit=crop" alt="Lush Beauty Mart Hampers" class="insta-img" loading="lazy" width="400" height="400">
        <div class="insta-overlay">
          <span class="insta-icon">📷</span>
          <p class="insta-caption">Festive Gift Hampers 🎁</p>
        </div>
      </a>
    </div>

    <div class="section-footer-center">
      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="btn-follow-instagram">
        <span>Follow Us on Instagram</span>
        <span class="btn-arrow">↗</span>
      </a>
    </div>
  </div>
</section>

