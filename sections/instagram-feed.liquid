<section class="lush-instagram-section" id="social-gallery-section">
  <div class="page-width">
    <div class="section-header-center">
      <span class="section-badge">📸 SOCIAL GALLERY</span>
      <h2 class="section-title">Follow {{ settings.social_instagram_handle | default: "@lushbeautymart" }}</h2>
      <p class="section-subtitle">Real unboxings, store walkthroughs, and beauty updates straight from our Nagpur showroom.</p>
    </div>

    <!-- Real Uploaded Social Gallery Grid (3 items) -->
    <div class="social-gallery-grid-3">
      <!-- Item 1: Real Video Reel (@explore.with_shruti) -->
      <div class="social-post-card group" data-post-type="video">
        <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="social-post-link">
          <div class="social-media-wrap">
            <video
              class="social-video-media"
              src="https://res.cloudinary.com/dsqxboxoc/video/upload/v1787301075/explore.with_shruti_14050530_135038188_yhjyo2.mp4"
              poster="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300602/lushbeautymart_14050530_135039469_kdl5zs.webp"
              muted
              loop
              playsinline
              autoplay
            ></video>
            <div class="social-post-overlay">
              <span class="social-type-pill">▶ Reel</span>
              <p class="social-caption">Store walkthrough & exclusive beauty shopping at Nagpur store ✨</p>
              <span class="social-author">@explore.with_shruti × @lushbeautymart</span>
            </div>
          </div>
        </a>
      </div>

      <!-- Item 2: Real Video Reel (@angelpeterr_) -->
      <div class="social-post-card group" data-post-type="video">
        <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="social-post-link">
          <div class="social-media-wrap">
            <video
              class="social-video-media"
              src="https://res.cloudinary.com/dsqxboxoc/video/upload/v1787300962/angelpeterr__14050530_135035349_b9xjrn.mp4"
              poster="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300602/lushbeautymart_14050530_135039469_kdl5zs.webp"
              muted
              loop
              playsinline
              autoplay
            ></video>
            <div class="social-post-overlay">
              <span class="social-type-pill">▶ Reel</span>
              <p class="social-caption">Bridal jewellery & cosmetics glamour look 💫</p>
              <span class="social-author">@angelpeterr_ × @lushbeautymart</span>
            </div>
          </div>
        </a>
      </div>

      <!-- Item 3: Real Photo Post (@lushbeautymart) -->
      <div class="social-post-card group" data-post-type="image">
        <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="social-post-link">
          <div class="social-media-wrap">
            <img
              src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300602/lushbeautymart_14050530_135039469_kdl5zs.webp"
              alt="Lush Beauty Mart Real Post"
              class="social-img-media"
              loading="lazy"
              width="600"
              height="600"
            >
            <div class="social-post-overlay">
              <span class="social-type-pill">📷 Post</span>
              <p class="social-caption">Unboxing premium jewellery & cosmetics in-store 💎</p>
              <span class="social-author">@lushbeautymart</span>
            </div>
          </div>
        </a>
      </div>
    </div>

    <div class="section-footer-center">
      <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/lushbeautymart' }}" target="_blank" rel="noopener noreferrer" class="btn-follow-instagram">
        <span>Follow @lushbeautymart on Instagram</span>
        <span class="btn-arrow">↗</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social Gallery",
  "settings": [],
  "presets": [
    {
      "name": "Social Gallery"
    }
  ]
}
{% endschema %}
