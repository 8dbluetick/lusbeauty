{%- if section.settings.enable_section -%}
  <section class="lush-trending-section">
    <div class="page-width">
      <div class="section-header-split">
        <div>
          {%- if section.settings.badge != blank -%}
            <span class="section-badge">{{ section.settings.badge }}</span>
          {%- endif -%}
          <h2 class="section-title">{{ section.settings.title | default: "Trending Now" }}</h2>
          {%- if section.settings.subtitle != blank -%}
            <p class="section-subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_filters -%}
          <div class="category-filter-pills" id="TrendingCategoryFilters">
            <button type="button" class="filter-pill active" data-category-filter="all">All Picks</button>
            <button type="button" class="filter-pill" data-category-filter="skincare">Skincare</button>
            <button type="button" class="filter-pill" data-category-filter="cosmetics">Cosmetics</button>
            <button type="button" class="filter-pill" data-category-filter="handbag">Handbags</button>
            <button type="button" class="filter-pill" data-category-filter="hair">Hair Care</button>
            <button type="button" class="filter-pill" data-category-filter="fragrance">Fragrances</button>
          </div>
        {%- endif -%}
      </div>

      <!-- Product Grid -->
      <div class="products-grid-4">
        {%- assign featured_collection = collections[section.settings.collection] | default: collections.all -%}
        {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
          {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
            {%- assign is_lazy = true -%}
            {%- if forloop.index <= 4 -%}
              {%- assign is_lazy = false -%}
            {%- endif -%}
            {% render 'product-card', product: product, lazy: is_lazy %}
          {%- endfor -%}
        {%- else -%}
          <div class="no-products-message">
            <p>No products found in this collection. Please select a collection in the theme editor.</p>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.btn_text != blank -%}
        <div class="section-footer-center">
          <a href="{{ section.settings.view_all_link | default: '/collections/all' }}" class="btn-view-all-shop">
            <span>{{ section.settings.btn_text }}</span>
            <span class="btn-arrow">→</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Trending Products",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Section Badge",
      "default": "🔥 Most Loved in Nagpur"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Top rated skincare, beauty essentials, luxury handbags & signature fragrances."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "label": "Number of Products to Show"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Category Filter Buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "Explore Full Collection"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button Link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Trending Products"
    }
  ]
}
{% endschema %}
