              height="300"
            >
            <span style="position: absolute; top: 12px; left: 12px; background: rgba(27, 67, 50, 0.9); color: #FFFFFF; font-size: 0.7rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; backdrop-filter: blur(4px);">
              🌿 11 Authentic Products
            </span>
