              {%- elsif collection.handle == 'rasasi' or col_title_lower contains 'rasasi' -%}
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-size: 0.68rem; font-weight: 800; color: #C5A059; text-transform: uppercase; letter-spacing: 0.05em;">
                    LUSH BRAND COLLECTION
                  </span>
                  <img src="{{ 'rasasi-logo.png' | asset_url }}" alt="Rasasi Perfumes" style="max-height: 22px; width: auto; object-fit: contain;">
                </div>
              {%- elsif collection.handle == 'gliss' or col_title_lower contains 'gliss' -%}
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-size: 0.68rem; font-weight: 800; color: #E5A93C; text-transform: uppercase; letter-spacing: 0.05em;">
                    LUSH BRAND COLLECTION
                  </span>
                  <img src="{{ 'gliss-logo.png' | asset_url }}" alt="Schwarzkopf Gliss" style="max-height: 22px; width: auto; object-fit: contain;">
                </div>
              {%- elsif collection.handle == 'skin-cottage' or col_title_lower contains 'skin cottage' -%}
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-size: 0.68rem; font-weight: 800; color: #2D6A4F; text-transform: uppercase; letter-spacing: 0.05em;">
                    LUSH BRAND COLLECTION
                  </span>
                  <img src="{{ 'skin-cottage-logo.png' | asset_url }}" alt="Skin Cottage" style="max-height: 22px; width: auto; object-fit: contain;">
                </div>
              {%- elsif collection.handle == 'syoss' or col_title_lower contains 'syoss' -%}
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-size: 0.68rem; font-weight: 800; color: #1F1610; text-transform: uppercase; letter-spacing: 0.05em;">
                    LUSH BRAND COLLECTION
                  </span>
                  <img src="{{ 'syoss-logo.svg' | asset_url }}" alt="Syoss" style="max-height: 20px; width: auto; object-fit: contain;">
                </div>
              {%- else -%}
                <span style="font-size: 0.68rem; font-weight: 800; color: #C5A059; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">
                  LUSH COLLECTION
                </span>
              {%- endif -%}
              <h3 style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 800; color: #1F1610; margin: 0 0 6px; line-height: 1.3;">
                <a href="{{ collection.url }}" style="color: #1F1610; text-decoration: none;">{{ collection.title }}</a>
              </h3>
              {%- if collection.description != blank -%}
                <p style="font-size: 0.78rem; color: #6E5E52; line-height: 1.4; margin: 0 0 14px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  {{ collection.description | strip_html }}
                </p>
              {%- else -%}
                <p style="font-size: 0.78rem; color: #6E5E52; line-height: 1.4; margin: 0 0 14px;">
                  Explore authentic beauty, cosmetics and accessories.
                </p>
              {%- endif -%}

              <!-- Button -->
              <div style="margin-top: auto;">
                <a href="{{ collection.url }}" style="display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 10px 14px; background: #1F1610; color: #C5A059; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; border-radius: 8px; text-decoration: none; box-sizing: border-box; transition: all 0.2s ease;">
                  <span>Explore Collection</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "All Collections & Departments"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Explore our handpicked categories in-store in Nagpur or browse and order online."
    }
  ]
}
{% endschema %}
