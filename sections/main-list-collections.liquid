{% comment %}
  Lush Beauty Mart — Luxury All Collections & Departments Catalog
  Clean 2-col (mobile) to 4-col (desktop) grid with high contrast and perfect image containment
{% endcomment %}

<section class="lush-all-collections-page" style="padding: 30px 0 60px; background: #FAF7F2; min-height: 70vh;">
  <div class="page-width" style="max-width: 1280px; margin: 0 auto; padding: 0 16px;">
    <!-- Section Header -->
    <div style="text-align: center; max-width: 700px; margin: 0 auto 36px;">
      <span style="display: inline-block; padding: 4px 14px; background: rgba(197, 160, 89, 0.15); border: 1px solid rgba(197, 160, 89, 0.35); border-radius: 999px; font-size: 0.72rem; font-weight: 800; color: #8B6F3E; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 10px;">
        ✨ CURATED DEPARTMENTS
      </span>
      <h1 style="font-family: var(--font-serif); font-size: clamp(1.8rem, 4vw, 2.5rem); font-weight: 800; color: #1F1610; margin: 0 0 10px; line-height: 1.2;">
        {{ section.settings.title | default: 'All Collections & Categories' }}
      </h1>
      <p style="font-size: 0.88rem; color: #6E5E52; margin: 0; line-height: 1.5;">
        {{ section.settings.subtitle | default: 'Browse our complete catalog of genuine beauty, skincare, luxury fragrances, and designer handbags.' }}
      </p>
    </div>

    <!-- Responsive Collections Grid -->
    <div class="collections-grid-container" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <div class="collection-luxury-card" style="background: #FFFFFF; border: 1px solid #EAE3DA; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; transition: all 0.3s ease; box-shadow: 0 4px 16px rgba(31, 22, 16, 0.04);">
            <!-- Image Area -->
            <a href="{{ collection.url }}" style="display: block; position: relative; background: #FDFCFA; aspect-ratio: 4/3; overflow: hidden; padding: 16px; display: flex; align-items: center; justify-content: center; text-decoration: none;">
              {%- if collection.featured_image != blank -%}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.title | escape }}"
                  style="max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; transition: transform 0.4s ease;"
                  loading="lazy"
                  width="400"
                  height="300"
                >
              {%- elsif collection.products.first.featured_image != blank -%}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.title | escape }}"
                  style="max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; transition: transform 0.4s ease;"
                  loading="lazy"
                  width="400"
                  height="300"
                >
              {%- else -%}
                <div style="font-size: 3rem;">🌸</div>
              {%- endif -%}

              <!-- Item Count Badge -->
              <span style="position: absolute; top: 12px; left: 12px; background: rgba(31, 22, 16, 0.85); color: #FFFFFF; font-size: 0.7rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; backdrop-filter: blur(4px);">
                {{ collection.all_products_count }} {{ collection.all_products_count | pluralize: 'Item', 'Items' }}
              </span>
            </a>

            <!-- Content Area -->
            <div style="padding: 18px 16px 20px; display: flex; flex-direction: column; flex: 1; border-top: 1px solid #F3EDE7;">
              <span style="font-size: 0.68rem; font-weight: 800; color: #C5A059; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">
                LUSH COLLECTION
              </span>
              <h3 style="font-family: var(--font-serif); font-size: 1.15rem; font-weight: 800; color: #1F1610; margin: 0 0 6px; line-height: 1.3;">
                <a href="{{ collection.url }}" style="color: #1F1610; text-decoration: none;">{{ collection.title }}</a>
              </h3>
              {%- if collection.description != blank -%}
                <p style="font-size: 0.78rem; color: #6E5E52; line-height: 1.4; margin: 0 0 14px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  {{ collection.description | strip_html }}
                </p>
              {%- else -%}
                <p style="font-size: 0.78rem; color: #6E5E52; line-height: 1.4; margin: 0 0 14px;">
                  Explore authentic beauty, cosmetics and accessories.
                </p>
              {%- endif -%}

              <!-- Button -->
              <div style="margin-top: auto;">
                <a href="{{ collection.url }}" style="display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 10px 14px; background: #1F1610; color: #C5A059; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; border-radius: 8px; text-decoration: none; box-sizing: border-box; transition: all 0.2s ease;">
                  <span>Explore Collection</span>
                  <span>→</span>
                </a>
              </div>
            </div>
          </div>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "All Collections & Departments"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Explore our handpicked categories in-store in Nagpur or browse and order online."
    }
  ]
}
{% endschema %}
