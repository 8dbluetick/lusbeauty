{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 28,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Logo Max Width",
      "default": 42
    },
    {
      "type": "text",
      "id": "store_title",
      "label": "Store Name",
      "default": "LUSH BEAUTY MART"
    },
    {
      "type": "text",
      "id": "store_tagline",
      "label": "Store Tagline",
      "default": "WHERE BEAUTY MEETS QUALITY"
    },
    {
      "type": "checkbox",
      "id": "use_custom_menu",
      "label": "Use Custom Navigation Menu from Admin",
      "default": false,
      "info": "When unchecked, the built-in full 43-collection hierarchy is active automatically."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Action Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Live Search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Shopping Bag",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Header Text / Icon Color",
      "default": "#1F1610"
    }
  ]
}
{% endschema %}
