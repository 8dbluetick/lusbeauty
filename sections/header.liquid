{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Logo Max Width",
      "default": 36
    },
    {
      "type": "text",
      "id": "store_title",
      "label": "Store Name",
      "default": "LUSH BEAUTY MART"
    },
    {
      "type": "text",
      "id": "store_tagline",
      "label": "Store Tagline",
      "default": "WHERE BEAUTY MEETS QUALITY"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu",
      "info": "Select the menu configured in Online Store -> Navigation. If empty, all active collections from Shopify will be listed automatically."
    },
    {
      "type": "header",
      "content": "Action Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Live Search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Shopping Bag",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Header Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Header Text / Icon Color",
      "default": "#1F1610"
    }
  ]
}
{% endschema %}
