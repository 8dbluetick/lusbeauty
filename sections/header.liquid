<header class="lush-header-sticky" id="LushHeader">
  <div class="page-width header-container">
    <!-- Mobile: Hamburger Menu Button -->
    <div class="header-mobile-toggle">
      <button type="button" class="btn-hamburger" id="BtnMobileMenuToggle" aria-label="Open Navigation">
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>

    <!-- LEFT: Brand Logo / Wordmark -->
    <div class="header-logo-wrap">
      <a href="/" class="header-brand-link">
        <img
          src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300623/lushbeautymart_14050530_135102335_bdtk3h.jpg"
          alt="Lush Beauty Mart"
          class="header-logo-img"
          width="46"
          height="46"
        >
        <div class="header-brand-text">
          <span class="brand-title">LUSH BEAUTY MART</span>
          <span class="brand-tagline">WHERE BEAUTY MEETS QUALITY</span>
        </div>
      </a>
    </div>

    <!-- CENTER: Main Navigation (Dynamic with graceful 404 fallback) -->
    <nav class="header-desktop-nav" aria-label="Primary Navigation">
      <ul class="nav-links-list">
        {%- assign nav_menu = linklists[section.settings.menu | default: 'main-menu'] -%}
        {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
          {%- for link in nav_menu.links -%}
            <li>
              <a href="{{ link.url }}" class="nav-item-link{% if link.active %} active{% endif %}">
                {{ link.title | upcase }}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="/" class="nav-item-link">HOME</a></li>
          <li><a href="/collections/all" class="nav-item-link">SHOP</a></li>
          <li><a href="{% if collections['skincare'] != blank %}{{ collections['skincare'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">SKINCARE</a></li>
          <li><a href="{% if collections['cosmetics'] != blank %}{{ collections['cosmetics'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">COSMETICS</a></li>
          <li><a href="{% if collections['artificial-jewellery'] != blank %}{{ collections['artificial-jewellery'].url }}{% elsif collections['jewellery'] != blank %}{{ collections['jewellery'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">JEWELLERY</a></li>
          <li><a href="{% if collections['handbags'] != blank %}{{ collections['handbags'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">HANDBAGS</a></li>
          <li><a href="{% if collections['beauty-accessories'] != blank %}{{ collections['beauty-accessories'].url }}{% elsif collections['accessories'] != blank %}{{ collections['accessories'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">ACCESSORIES</a></li>
          <li><a href="/collections/all" class="nav-item-link nav-item-offers">OFFERS</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- RIGHT: Minimal Thin-Line Icons -->
    <div class="header-actions">
      <!-- Search -->
      <button type="button" class="header-action-btn" data-open-search title="Search" aria-label="Search">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
      </button>

      <!-- Wishlist -->
      <button type="button" class="header-action-btn" data-open-wishlist title="Wishlist" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
        <span class="action-badge wishlist-badge" data-wishlist-count>0</span>
      </button>

      <!-- Account -->
      <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="header-action-btn" title="Account" aria-label="Account">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <!-- Cart -->
      <button type="button" class="header-action-btn" data-open-cart title="Shopping Bag" aria-label="Cart">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-2z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="action-badge cart-badge" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-nav-drawer" id="MobileNavDrawer" aria-hidden="true">
    <div class="mobile-nav-backdrop" id="BtnCloseMobileMenu"></div>
    <div class="mobile-nav-panel">
      <div class="mobile-nav-header">
        <div class="header-brand-link">
          <img
            src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300623/lushbeautymart_14050530_135102335_bdtk3h.jpg"
            alt="Lush Beauty Mart"
            class="header-logo-img"
            width="38"
            height="38"
          >
          <div class="header-brand-text">
            <span class="brand-title" style="font-size: 1.05rem;">LUSH BEAUTY MART</span>
            <span class="brand-tagline" style="font-size: 0.5rem;">WHERE BEAUTY MEETS QUALITY</span>
          </div>
        </div>
        <button type="button" class="btn-close-mobile-nav" id="BtnCloseMobileNavX" aria-label="Close Navigation">&times;</button>
      </div>

      <div class="mobile-nav-body">
        <ul class="mobile-nav-links">
          {%- assign nav_menu = linklists[section.settings.menu | default: 'main-menu'] -%}
          {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
            {%- for link in nav_menu.links -%}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title | upcase }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/">HOME</a></li>
            <li><a href="/collections/all">SHOP</a></li>
            <li><a href="{% if collections['skincare'] != blank %}{{ collections['skincare'].url }}{% else %}/collections/all{% endif %}">SKINCARE</a></li>
            <li><a href="{% if collections['cosmetics'] != blank %}{{ collections['cosmetics'].url }}{% else %}/collections/all{% endif %}">COSMETICS</a></li>
            <li><a href="{% if collections['artificial-jewellery'] != blank %}{{ collections['artificial-jewellery'].url }}{% elsif collections['jewellery'] != blank %}{{ collections['jewellery'].url }}{% else %}/collections/all{% endif %}">JEWELLERY</a></li>
            <li><a href="{% if collections['handbags'] != blank %}{{ collections['handbags'].url }}{% else %}/collections/all{% endif %}">HANDBAGS</a></li>
            <li><a href="{% if collections['beauty-accessories'] != blank %}{{ collections['beauty-accessories'].url }}{% elsif collections['accessories'] != blank %}{{ collections['accessories'].url }}{% else %}/collections/all{% endif %}">ACCESSORIES</a></li>
            <li><a href="/collections/all" class="mobile-offers-link">OFFERS</a></li>
          {%- endif -%}
        </ul>

        <div class="mobile-nav-footer-info">
          <p class="mobile-store-loc">📍 Nagpur Store • Lad Square, North Ambazari Rd</p>
          <a href="tel:{{ settings.store_phone | default: '9119595951' }}" class="mobile-call-link">📞 {{ settings.store_phone | default: '9119595951' }}</a>
        </div>
      </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
