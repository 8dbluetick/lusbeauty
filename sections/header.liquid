<header class="lush-header-sticky" id="LushHeader" style="background-color: {{ section.settings.bg_color | default: '#FFFFFF' }};">
  <div class="page-width header-container">
    <!-- Mobile: Hamburger Menu Button -->
    <div class="header-mobile-toggle">
      <button type="button" class="btn-hamburger" id="BtnMobileMenuToggle" aria-label="Open Navigation" style="color: {{ section.settings.text_color | default: '#1F1610' }};">
        <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>

    <!-- LEFT: Brand Logo / Wordmark -->
    <div class="header-logo-wrap">
      <a href="/" class="header-brand-link">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 160 }}"
            alt="{{ section.settings.store_title | default: shop.name | escape }}"
            class="header-logo-img"
            style="width: {{ section.settings.logo_width | default: 36 }}px; height: auto;"
            width="{{ section.settings.logo_width | default: 36 }}"
            height="{{ section.settings.logo_width | default: 36 }}"
          >
        {%- else -%}
          <img
            src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300623/lushbeautymart_14050530_135102335_bdtk3h.jpg"
            alt="{{ section.settings.store_title | default: 'Lush Beauty Mart' }}"
            class="header-logo-img"
            width="36"
            height="36"
          >
        {%- endif -%}
        <div class="header-brand-text">
          <span class="brand-title" style="color: {{ section.settings.text_color | default: '#1F1610' }};">{{ section.settings.store_title | default: "LUSH BEAUTY MART" }}</span>
          {%- if section.settings.store_tagline != blank -%}
            <span class="brand-tagline">{{ section.settings.store_tagline }}</span>
          {%- endif -%}
        </div>
      </a>
    </div>

    <!-- CENTER: Main Navigation (Multi-Level Mega Menu & Dropdowns) -->
    <nav class="header-desktop-nav" aria-label="Primary Navigation">
      <ul class="nav-links-list">
        {%- assign nav_menu = linklists[section.settings.menu | default: 'main-menu'] -%}
        {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
          {%- for link in nav_menu.links -%}
            <li class="nav-item-wrap{% if link.links != blank %} has-dropdown{% endif %}">
              <a href="{{ link.url }}" class="nav-item-link{% if link.active %} active{% endif %}" style="color: {{ section.settings.text_color | default: '#2C1D11' }};">
                <span>{{ link.title | upcase }}</span>
                {%- if link.links != blank -%}<span class="dropdown-chevron">▾</span>{%- endif -%}
              </a>
              {%- if link.links != blank -%}
                <ul class="header-dropdown-menu">
                  {%- for child_link in link.links -%}
                    <li class="{% if child_link.links != blank %}has-sub-dropdown{% endif %}">
                      <a href="{{ child_link.url }}" class="header-dropdown-link{% if child_link.active %} active{% endif %}">
                        {{ child_link.title }}
                        {%- if child_link.links != blank -%}<span class="sub-dropdown-chevron">›</span>{%- endif -%}
                      </a>
                      {%- if child_link.links != blank -%}
                        <ul class="header-sub-dropdown-menu">
                          {%- for grand_link in child_link.links -%}
                            <li>
                              <a href="{{ grand_link.url }}" class="header-sub-dropdown-link">
                                {{ grand_link.title }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- Clean Default Hierarchy for Lush Beauty Mart Catalog -->
          <!-- 1. Skincare Dropdown -->
          <li class="nav-item-wrap has-dropdown">
            <a href="{% if collections['skincare'] != blank %}{{ collections['skincare'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">
              <span>SKINCARE</span>
              <span class="dropdown-chevron">▾</span>
            </a>
            <ul class="header-dropdown-menu">
              <li><a href="{% if collections['skincare'] != blank %}{{ collections['skincare'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link header-dropdown-all">✨ View All Skincare</a></li>
              <li><a href="{% if collections['face-wash-cleansers'] != blank %}{{ collections['face-wash-cleansers'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Face Wash & Cleansers</a></li>
              <li><a href="{% if collections['face-serums'] != blank %}{{ collections['face-serums'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Face Serums</a></li>
              <li><a href="{% if collections['moisturizers-face-creams'] != blank %}{{ collections['moisturizers-face-creams'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Moisturizers & Face Creams</a></li>
              <li><a href="{% if collections['sunscreens'] != blank %}{{ collections['sunscreens'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Sunscreens</a></li>
              <li><a href="{% if collections['toners'] != blank %}{{ collections['toners'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Toners</a></li>
              <li><a href="{% if collections['face-masks'] != blank %}{{ collections['face-masks'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Face Masks</a></li>
              <li><a href="{% if collections['acne-blemish-care'] != blank %}{{ collections['acne-blemish-care'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Acne & Blemish Care</a></li>
              <li><a href="{% if collections['brightening-vitamin-c'] != blank %}{{ collections['brightening-vitamin-c'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Brightening & Vitamin C</a></li>
              <li><a href="{% if collections['korean-skincare'] != blank %}{{ collections['korean-skincare'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link text-gold">🌿 Korean Skincare</a></li>
            </ul>
          </li>

          <!-- 2. Makeup Dropdown -->
          <li class="nav-item-wrap has-dropdown">
            <a href="{% if collections['makeup'] != blank %}{{ collections['makeup'].url }}{% elsif collections['cosmetics'] != blank %}{{ collections['cosmetics'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">
              <span>MAKEUP</span>
              <span class="dropdown-chevron">▾</span>
            </a>
            <ul class="header-dropdown-menu">
              <li><a href="{% if collections['makeup'] != blank %}{{ collections['makeup'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link header-dropdown-all">✨ View All Makeup</a></li>
              <li><a href="{% if collections['lipsticks'] != blank %}{{ collections['lipsticks'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Lipsticks</a></li>
              <li><a href="{% if collections['lip-care'] != blank %}{{ collections['lip-care'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Lip Care</a></li>
              <li><a href="{% if collections['foundation-base-makeup'] != blank %}{{ collections['foundation-base-makeup'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Foundation & Base Makeup</a></li>
              <li><a href="{% if collections['concealers'] != blank %}{{ collections['concealers'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Concealers</a></li>
              <li><a href="{% if collections['bb-cc-cream'] != blank %}{{ collections['bb-cc-cream'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">BB / CC Cream</a></li>
              <li><a href="{% if collections['blush-bronzer-highlighter'] != blank %}{{ collections['blush-bronzer-highlighter'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Blush, Bronzer & Highlighter</a></li>
              <li><a href="{% if collections['eye-makeup'] != blank %}{{ collections['eye-makeup'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Eye Makeup (Kajal & Liners)</a></li>
            </ul>
          </li>

          <!-- 3. Haircare Dropdown -->
          <li class="nav-item-wrap has-dropdown">
            <a href="{% if collections['haircare'] != blank %}{{ collections['haircare'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">
              <span>HAIRCARE</span>
              <span class="dropdown-chevron">▾</span>
            </a>
            <ul class="header-dropdown-menu">
              <li><a href="{% if collections['haircare'] != blank %}{{ collections['haircare'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link header-dropdown-all">✨ View All Haircare</a></li>
              <li><a href="{% if collections['shampoos'] != blank %}{{ collections['shampoos'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Shampoos</a></li>
              <li><a href="{% if collections['conditioners'] != blank %}{{ collections['conditioners'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Conditioners</a></li>
              <li><a href="{% if collections['hair-masks'] != blank %}{{ collections['hair-masks'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Hair Masks & Spas</a></li>
              <li><a href="{% if collections['hair-serums'] != blank %}{{ collections['hair-serums'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Hair Serums</a></li>
              <li><a href="{% if collections['hair-oils'] != blank %}{{ collections['hair-oils'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Hair Oils</a></li>
              <li><a href="{% if collections['hair-growth-anti-hair-fall'] != blank %}{{ collections['hair-growth-anti-hair-fall'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Hair Growth & Anti-Hair Fall</a></li>
            </ul>
          </li>

          <!-- 4. Bodycare Dropdown -->
          <li class="nav-item-wrap has-dropdown">
            <a href="{% if collections['bodycare'] != blank %}{{ collections['bodycare'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">
              <span>BODYCARE</span>
              <span class="dropdown-chevron">▾</span>
            </a>
            <ul class="header-dropdown-menu">
              <li><a href="{% if collections['bodycare'] != blank %}{{ collections['bodycare'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link header-dropdown-all">✨ View All Bodycare</a></li>
              <li><a href="{% if collections['body-wash-shower-gel'] != blank %}{{ collections['body-wash-shower-gel'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Body Wash & Shower Gel</a></li>
              <li><a href="{% if collections['body-lotions'] != blank %}{{ collections['body-lotions'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Body Lotions</a></li>
              <li><a href="{% if collections['body-creams'] != blank %}{{ collections['body-creams'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Body Creams & Butters</a></li>
              <li><a href="{% if collections['body-scrubs'] != blank %}{{ collections['body-scrubs'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Body Scrubs & Exfoliators</a></li>
              <li><a href="{% if collections['talc-body-powder'] != blank %}{{ collections['talc-body-powder'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Talc & Body Powder</a></li>
            </ul>
          </li>

          <!-- 5. Fragrance Dropdown -->
          <li class="nav-item-wrap has-dropdown">
            <a href="{% if collections['fragrance'] != blank %}{{ collections['fragrance'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">
              <span>FRAGRANCE</span>
              <span class="dropdown-chevron">▾</span>
            </a>
            <ul class="header-dropdown-menu">
              <li><a href="{% if collections['fragrance'] != blank %}{{ collections['fragrance'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link header-dropdown-all">✨ View All Fragrances</a></li>
              <li><a href="{% if collections['perfumes-for-men'] != blank %}{{ collections['perfumes-for-men'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Perfumes for Men</a></li>
              <li><a href="{% if collections['perfumes-for-women'] != blank %}{{ collections['perfumes-for-women'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Perfumes for Women</a></li>
              <li><a href="{% if collections['unisex-perfumes'] != blank %}{{ collections['unisex-perfumes'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Unisex Perfumes</a></li>
              <li><a href="{% if collections['eau-de-parfum'] != blank %}{{ collections['eau-de-parfum'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Eau de Parfum (EDP)</a></li>
              <li><a href="{% if collections['eau-de-toilette'] != blank %}{{ collections['eau-de-toilette'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link">Eau de Toilette (EDT)</a></li>
              <li><a href="{% if collections['premium-fragrances'] != blank %}{{ collections['premium-fragrances'].url }}{% else %}/collections/all{% endif %}" class="header-dropdown-link text-gold">👑 Premium Fragrances</a></li>
            </ul>
          </li>

          <!-- 6. Tumblers & Drinkware -->
          <li>
            <a href="{% if collections['tumblers-drinkware'] != blank %}{{ collections['tumblers-drinkware'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link">
              <span>DRINKWARE</span>
            </a>
          </li>

          <!-- 7. Offers & Deals -->
          <li>
            <a href="{% if collections['offers-deals'] != blank %}{{ collections['offers-deals'].url }}{% elsif collections['sale'] != blank %}{{ collections['sale'].url }}{% else %}/collections/all{% endif %}" class="nav-item-link nav-item-offers">
              <span>OFFERS 🏷️</span>
            </a>
          </li>

          <!-- 8. Partner Venture -->
          <li>
            <a href="https://sevasurgicalsanddrugs.vercel.app/" target="_blank" rel="noopener noreferrer" class="nav-item-link nav-item-partner" style="color: #0F7A42; font-weight: 800;">
              <span>🏥 SEVA SURGICALS ↗</span>
            </a>
          </li>
        {%- endif -%}
      </ul>
    </nav>

    <!-- RIGHT: Action Icons -->
    <div class="header-actions">
      <!-- Search -->
      {%- if section.settings.show_search -%}
        <button type="button" class="header-action-btn" data-open-search title="Search" aria-label="Search" style="color: {{ section.settings.text_color | default: '#1F1610' }};">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7.5"></circle>
            <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
          </svg>
        </button>
      {%- endif -%}

      <!-- Wishlist -->
      {%- if section.settings.show_wishlist -%}
        <button type="button" class="header-action-btn" data-open-wishlist title="Wishlist" aria-label="Wishlist" style="color: {{ section.settings.text_color | default: '#1F1610' }};">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
          <span class="action-badge wishlist-badge" data-wishlist-count>0</span>
        </button>
      {%- endif -%}

      <!-- Account -->
      {%- if section.settings.show_account -%}
        <a href="{% if customer %}/account{% else %}/account/login{% endif %}" class="header-action-btn" title="Account" aria-label="Account" style="color: {{ section.settings.text_color | default: '#1F1610' }};">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </a>
      {%- endif -%}

      <!-- Cart -->
      {%- if section.settings.show_cart -%}
        <button type="button" class="header-action-btn" data-open-cart title="Shopping Bag" aria-label="Cart" style="color: {{ section.settings.text_color | default: '#1F1610' }};">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-2z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="action-badge cart-badge" data-cart-count>{{ cart.item_count }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>

  <!-- Mobile Navigation Drawer with Smooth Accordion Collapsibles -->
  <div class="mobile-nav-drawer" id="MobileNavDrawer" aria-hidden="true">
    <div class="mobile-nav-backdrop" id="BtnCloseMobileMenu"></div>
    <div class="mobile-nav-panel">
      <div class="mobile-nav-header">
        <div class="header-brand-link">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 160 }}"
              alt="{{ section.settings.store_title | default: shop.name | escape }}"
              class="header-logo-img"
              width="36"
              height="36"
            >
          {%- else -%}
            <img
              src="https://res.cloudinary.com/dsqxboxoc/image/upload/v1787300623/lushbeautymart_14050530_135102335_bdtk3h.jpg"
              alt="Lush Beauty Mart"
              class="header-logo-img"
              width="36"
              height="36"
            >
          {%- endif -%}
          <div class="header-brand-text">
            <span class="brand-title" style="font-size: 1.05rem;">{{ section.settings.store_title | default: "LUSH BEAUTY MART" }}</span>
            <span class="brand-tagline" style="font-size: 0.5rem;">{{ section.settings.store_tagline | default: "WHERE BEAUTY MEETS QUALITY" }}</span>
          </div>
        </div>
        <button type="button" class="btn-close-mobile-nav" id="BtnCloseMobileNavX" aria-label="Close Navigation">&times;</button>
      </div>

      <div class="mobile-nav-body">
        <!-- Quick Featured Badges Row on Mobile -->
        <div class="mobile-featured-pills">
          <a href="{% if collections['bestsellers'] != blank %}{{ collections['bestsellers'].url }}{% else %}/collections/all{% endif %}" class="mobile-badge-pill">🔥 Bestsellers</a>
          <a href="{% if collections['trending'] != blank %}{{ collections['trending'].url }}{% else %}/collections/all{% endif %}" class="mobile-badge-pill">✨ Trending</a>
          <a href="{% if collections['new-arrivals'] != blank %}{{ collections['new-arrivals'].url }}{% else %}/collections/all{% endif %}" class="mobile-badge-pill">⭐ New</a>
          <a href="{% if collections['offers-deals'] != blank %}{{ collections['offers-deals'].url }}{% elsif collections['sale'] != blank %}{{ collections['sale'].url }}{% else %}/collections/all{% endif %}" class="mobile-badge-pill pill-sale">🏷️ Sale</a>
        </div>

        <ul class="mobile-nav-links">
          {%- assign nav_menu = linklists[section.settings.menu | default: 'main-menu'] -%}
          {%- if nav_menu != blank and nav_menu.links.size > 0 -%}
            {%- for link in nav_menu.links -%}
              <li class="mobile-nav-item{% if link.links != blank %} has-accordion{% endif %}">
                <div class="mobile-nav-row">
                  <a href="{{ link.url }}" class="mobile-nav-link">
                    {{ link.title | upcase }}
                  </a>
                  {%- if link.links != blank -%}
                    <button type="button" class="mobile-accordion-toggle" aria-label="Toggle Submenu">+</button>
                  {%- endif -%}
                </div>
                {%- if link.links != blank -%}
                  <ul class="mobile-sublinks" style="display: none;">
                    {%- for child_link in link.links -%}
                      <li>
                        <a href="{{ child_link.url }}" class="mobile-sublink">{{ child_link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <!-- 1. Mobile Skincare Accordion -->
            <li class="mobile-nav-item has-accordion">
              <div class="mobile-nav-row">
                <a href="{% if collections['skincare'] != blank %}{{ collections['skincare'].url }}{% else %}/collections/all{% endif %}" class="mobile-nav-link">SKINCARE</a>
                <button type="button" class="mobile-accordion-toggle" aria-label="Toggle Submenu">+</button>
              </div>
              <ul class="mobile-sublinks" style="display: none;">
                <li><a href="{% if collections['skincare'] != blank %}{{ collections['skincare'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink font-bold text-gold">✨ View All Skincare</a></li>
                <li><a href="{% if collections['face-wash-cleansers'] != blank %}{{ collections['face-wash-cleansers'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink">Face Wash & Cleansers</a></li>
                <li><a href="{% if collections['face-serums'] != blank %}{{ collections['face-serums'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink">Face Serums</a></li>
                <li><a href="{% if collections['moisturizers-face-creams'] != blank %}{{ collections['moisturizers-face-creams'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink">Moisturizers & Face Creams</a></li>
                <li><a href="{% if collections['sunscreens'] != blank %}{{ collections['sunscreens'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink">Sunscreens</a></li>
                <li><a href="{% if collections['toners'] != blank %}{{ collections['toners'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink">Toners</a></li>
                <li><a href="{% if collections['face-masks'] != blank %}{{ collections['face-masks'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink">Face Masks</a></li>
                <li><a href="{% if collections['acne-blemish-care'] != blank %}{{ collections['acne-blemish-care'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink">Acne & Blemish Care</a></li>
                <li><a href="{% if collections['brightening-vitamin-c'] != blank %}{{ collections['brightening-vitamin-c'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink">Brightening & Vitamin C</a></li>
                <li><a href="{% if collections['korean-skincare'] != blank %}{{ collections['korean-skincare'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink text-gold">🌿 Korean Skincare</a></li>
              </ul>
            </li>

            <!-- 2. Mobile Makeup Accordion -->
            <li class="mobile-nav-item has-accordion">
              <div class="mobile-nav-row">
                <a href="{% if collections['makeup'] != blank %}{{ collections['makeup'].url }}{% else %}/collections/all{% endif %}" class="mobile-nav-link">MAKEUP</a>
                <button type="button" class="mobile-accordion-toggle" aria-label="Toggle Submenu">+</button>
              </div>
              <ul class="mobile-sublinks" style="display: none;">
                <li><a href="{% if collections['makeup'] != blank %}{{ collections['makeup'].url }}{% else %}/collections/all{% endif %}" class="mobile-sublink font-bold text-gold">✨ View All Makeup</a></li>
