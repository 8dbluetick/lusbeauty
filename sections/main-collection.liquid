<section class="lush-collection-section">
  {%- assign is_skin_cottage = false -%}
  {%- if collection.handle == 'skin-cottage' or collection.title contains 'Skin Cottage' or collection.title contains 'skin cottage' or canonical_url contains 'skin-cottage' or canonical_url contains 'Skin+Cottage' or canonical_url contains 'Skin%20Cottage' or canonical_url contains 'Skin+cottage' -%}
    {%- assign is_skin_cottage = true -%}
  {%- endif -%}

  {%- assign is_syoss = false -%}
  {%- if collection.handle == 'syoss' or collection.title contains 'Syoss' or collection.title contains 'syoss' or canonical_url contains 'syoss' or canonical_url contains 'Syoss' -%}
    {%- assign is_syoss = true -%}
  {%- endif -%}

  <div class="page-width">
    <!-- Dedicated Brand Collection Hero Banner -->
    {%- if is_skin_cottage and collection.image == blank -%}
      <div class="collection-brand-hero-banner banner-skin-cottage" style="margin-bottom: 24px; border-radius: 16px; overflow: hidden; border: 1.5px solid #2D6A4F; box-shadow: 0 8px 24px rgba(17, 56, 44, 0.15);">
        <img
          src="{{ 'skin-cottage-collection-banner.jpg' | asset_url }}"
          alt="Skin Cottage Luxury Botanical Body Care Collection - Lush Beauty Mart"
          style="width: 100%; height: auto; display: block; object-fit: cover;"
          loading="eager"
          width="1200"
          height="675"
        >
      </div>
    {%- elsif is_syoss and collection.image == blank -%}
      <div class="collection-brand-hero-banner banner-syoss" style="background: linear-gradient(135deg, #0A0A0A 0%, #1A1A1A 100%); padding: 36px 20px; border-radius: 16px; margin-bottom: 24px; text-align: center; border: 1.5px solid #333333; box-shadow: 0 8px 24px rgba(0,0,0,0.15);">
        <div style="display:flex; justify-content:center; margin-bottom:12px;">
          <img src="{{ 'syoss-logo.svg' | asset_url }}" alt="Syoss Professional Performance - Japan 1977" style="max-height: 56px; max-width: 220px; width: auto; height: auto;" loading="eager">
        </div>
        <p style="margin: 0 auto; font-size: 0.92rem; color: #E5E5E5; font-weight: 600; letter-spacing: 0.4px; max-width: 650px;">
          Japanese Salon Professional Performance Haircare · Est. Osaka, Japan 1977 · 100% Authentic Stock
        </p>
      </div>
    {%- elsif collection.image != blank -%}
      <div class="collection-brand-hero-banner">
        <img
          src="{{ collection.image | image_url: width: 1920 }}"
          alt="{{ collection.title | escape }} - Lush Beauty Mart"
          class="collection-hero-img"
          width="1920"
          height="500"
          loading="eager"
        >
      </div>
    {%- elsif collection.handle == 'cetaphil' or collection.title contains 'Cetaphil' or collection.title contains 'cetaphil' -%}
      <div class="collection-brand-hero-banner banner-cetaphil">
        <img
          src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/banner-cetaphil.jpg.jpg"
          alt="Cetaphil Dermatological Skincare - Lush Beauty Mart"
          class="collection-hero-img collection-hero-img-cetaphil"
          width="1600"
          height="500"
          loading="eager"
        >
      </div>
    {%- elsif collection.handle == 'skin1004' or collection.handle == 'centella' or collection.title contains 'SKIN1004' or collection.title contains 'Centella' -%}
      <div class="collection-brand-hero-banner banner-skin1004" style="background:#FAF7F2; padding:32px 20px; border-radius:16px; margin-bottom:24px; text-align:center; border:1px solid #EAE3DA;">
        <img
          src="{{ 'skin1004-centella-logo.png' | asset_url }}"
          alt="SKIN1004 Madagascar Centella - Lush Beauty Mart"
          class="collection-hero-img"
          style="max-height:75px; width:auto; margin:0 auto; display:block;"
          loading="eager"
        >
      </div>
    {%- elsif collection.handle == 'vgr' or collection.title contains 'VGR' or collection.title contains 'vgr' -%}
      <div class="collection-brand-hero-banner banner-vgr" style="background:#FAF7F2; padding:32px 20px; border-radius:16px; margin-bottom:24px; text-align:center; border:1px solid #EAE3DA;">
        <img
          src="{{ 'vgr-logo.png' | asset_url }}"
          alt="VGR Professional - Lush Beauty Mart"
          class="collection-hero-img"
          style="max-height:75px; width:auto; margin:0 auto; display:block;"
          loading="eager"
        >
      </div>
    {%- elsif collection.handle == 'body-wash-shower-gel' or collection.handle == 'body-wash' or collection.handle == 'body-washes' or collection.title contains 'Body Wash' -%}
      <div class="collection-brand-hero-banner banner-bodywash">
        <img
          src="{{ 'banner-bodywash.jpg' | asset_url }}"
          alt="Body Wash & Shower Gel Luxury Collection - Lush Beauty Mart"
          class="collection-hero-img collection-hero-img-bodywash"
          width="1600"
          height="500"
          loading="eager"
        >
      </div>
    {%- endif -%}

    <!-- Luxury Collection Page Header -->
    <div class="collection-header-wrap">
      {%- if collection.image != blank -%}
        <div class="collection-brand-badge-wrap">
          <div class="collection-brand-logo-card">
            <img
              src="{{ collection.image | image_url: width: 320 }}"
              alt="{{ collection.title | escape }}"
              class="collection-brand-logo-img"
              width="150"
              height="60"
              loading="eager"
            >
          </div>
          <span class="collection-verified-pill">👑 100% ORIGINAL & AUTHORIZED BRAND PARTNER</span>
        </div>
      {%- elsif is_skin_cottage -%}
        <div class="collection-brand-badge-wrap">
          <div class="collection-brand-logo-card" style="padding: 6px 16px; border-radius: 12px; background: #11382C; border: 1.5px solid #2D6A4F;">
            <img src="{{ 'skin-cottage-logo.png' | asset_url }}" alt="Skin Cottage Malaysia" style="max-height: 40px; max-width: 160px; display: block; object-fit: contain;" loading="eager">
          </div>
          <span class="collection-verified-pill" style="color: #11382C; background: rgba(82, 183, 136, 0.15); border-color: rgba(82, 183, 136, 0.4);">
            🌿 100% ORIGINAL & AUTHORIZED MALAYSIAN BOTANICAL CARE
          </span>
        </div>
      {%- elsif is_syoss -%}
        <div class="collection-brand-badge-wrap">
          <div class="collection-brand-logo-card" style="padding: 8px 20px; border-radius: 12px; background: #0A0A0A; border: 1.5px solid #333333;">
            <img src="{{ 'syoss-logo.svg' | asset_url }}" alt="Syoss Japan" style="max-height: 38px; max-width: 140px; display: block;" loading="eager">
          </div>
          <span class="collection-verified-pill" style="color: #1F1610; background: rgba(229, 9, 20, 0.1); border-color: rgba(229, 9, 20, 0.35);">
            🇯🇵 100% GENUINE JAPANESE SALON PERFORMANCE
          </span>
        </div>
      {%- elsif collection.handle == 'rasasi' or collection.title contains 'Rasasi' or collection.title contains 'rasasi' -%}
        <div class="collection-brand-badge-wrap">
          <div class="collection-brand-logo-card" style="padding: 6px 18px; border-radius: 12px; background: #FFFFFF; border: 1.5px solid #C5A059;">
            {% render 'brand-logo', brand: 'rasasi', class: 'collection-brand-logo-img' %}
          </div>
          <span class="collection-verified-pill" style="color: #C5A059;">👑 100% AUTHENTIC DUBAI LUXURY PERFUMES</span>
        </div>
      {%- elsif collection.handle == 'possibility' or collection.title contains 'Possibility' or collection.title contains 'possibility' -%}
        <div class="collection-brand-badge-wrap">
          <div class="collection-brand-logo-card" style="padding: 6px 18px; border-radius: 12px; background: #FFFFFF; border: 1.5px solid #FFCCD5;">
            {% render 'brand-logo', brand: 'possibility', class: 'collection-brand-logo-img' %}
          </div>
          <span class="collection-verified-pill" style="color: #A4133C;">🍓 100% ORIGINAL LONDON GOURMET BATH CARE</span>
        </div>
      {%- elsif collection.handle == 'gliss' or collection.title contains 'Gliss' or collection.title contains 'gliss' -%}
        <div class="collection-brand-badge-wrap">
          <div class="collection-brand-logo-card" style="padding: 6px 18px; border-radius: 12px; background: #FFFFFF; border: 1.5px solid #E5A93C;">
            {% render 'brand-logo', brand: 'gliss', class: 'collection-brand-logo-img' %}
          </div>
          <span class="collection-verified-pill" style="color: #C5A059;">🌟 100% ORIGINAL SCHWARZKOPF LIQUID KERATIN</span>
        </div>
      {%- elsif collection.handle == 'skin1004' or collection.handle == 'centella' or collection.title contains 'SKIN1004' or collection.title contains 'Centella' -%}
        <div class="collection-brand-badge-wrap">
          <div class="collection-brand-logo-card">
            <img
              src="{{ 'skin1004-centella-logo.png' | asset_url }}"
              alt="SKIN1004 Madagascar Centella"
              class="collection-brand-logo-img"
              width="150"
              height="60"
              loading="eager"
            >
          </div>
          <span class="collection-verified-pill">👑 100% ORIGINAL & AUTHORIZED BRAND PARTNER</span>
        </div>
      {%- elsif collection.handle == 'vgr' or collection.title contains 'VGR' or collection.title contains 'vgr' -%}
        <div class="collection-brand-badge-wrap">
          <div class="collection-brand-logo-card">
            <img
              src="{{ 'vgr-logo.png' | asset_url }}"
              alt="VGR Professional"
              class="collection-brand-logo-img"
              width="150"
              height="60"
              loading="eager"
            >
          </div>
          <span class="collection-verified-pill">👑 100% ORIGINAL & AUTHORIZED BRAND PARTNER</span>
        </div>
      {%- endif -%}

      <span class="collection-eyebrow">LUSH BEAUTY MART NAGPUR</span>
      <h1 class="collection-main-title">{{ collection.title | default: "All Products" }}</h1>

      <!-- Rich Description Section -->
      {%- if collection.description != blank -%}
        <div class="collection-desc">{{ collection.description }}</div>
      {%- elsif is_skin_cottage -%}
        <div class="collection-skin-cottage-description" style="max-width: 860px; margin: 12px auto 20px; text-align: left; background: #FFFFFF; border: 1.5px solid #A7D7C5; border-radius: 14px; padding: 20px 24px; box-shadow: 0 4px 14px rgba(17,56,44,0.04);">
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px; flex-wrap:wrap;">
            <span style="font-size:0.72rem; font-weight:800; color:#1B4332; background:#E8F5EE; border:1px solid rgba(82,183,136,0.3); padding:3px 10px; border-radius:999px; text-transform:uppercase;">🇲🇾 Est. Malaysia</span>
            <span style="font-size:0.72rem; font-weight:800; color:#1B4332; background:#F4FBF7; border:1px solid #A7D7C5; padding:3px 10px; border-radius:999px; text-transform:uppercase;">🌿 Botanical Body Care &amp; Scrubs</span>
          </div>
          <p style="font-size: 0.9rem; color: #2D3A34; line-height: 1.65; margin: 0 0 14px;">
            <strong>Skin Cottage</strong> is a premier Malaysian bath and body care house celebrated for infusing natural botanical fruit extracts and restorative essences into everyday cleansing luxuries. Formulated with a gentle <strong>pH 5.5 balance</strong> and enriched with <strong>Vitamin E</strong> and botanical hydrators, each shower gel and exfoliating body scrub cleanses deeply, softens rough skin, and envelops your body in irresistible natural fragrance without stripping essential moisture.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            <span style="font-size: 0.75rem; background: #F4FBF7; border: 1px solid #A7D7C5; padding: 4px 12px; border-radius: 8px; font-weight: 700; color: #1B4332;">🌿 pH 5.5 Skin-Friendly</span>
            <span style="font-size: 0.75rem; background: #F4FBF7; border: 1px solid #A7D7C5; padding: 4px 12px; border-radius: 8px; font-weight: 700; color: #1B4332;">🍑 Natural Fruit Extracts</span>
            <span style="font-size: 0.75rem; background: #F4FBF7; border: 1px solid #A7D7C5; padding: 4px 12px; border-radius: 8px; font-weight: 700; color: #1B4332;">🧼 Rich Cushion Lather</span>
            <span style="font-size: 0.75rem; background: #F4FBF7; border: 1px solid #A7D7C5; padding: 4px 12px; border-radius: 8px; font-weight: 700; color: #1B4332;">📍 100% Genuine Nagpur Stock</span>
          </div>
        </div>
      {%- elsif is_syoss -%}
        <div class="collection-syoss-description" style="max-width: 860px; margin: 12px auto 20px; text-align: left; background: #FFFFFF; border: 1.5px solid #EAE3DA; border-radius: 14px; padding: 20px 24px; box-shadow: 0 4px 14px rgba(0,0,0,0.03);">
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px; flex-wrap:wrap;">
            <span style="font-size:0.72rem; font-weight:800; color:#E50914; background:#FFF0F0; border:1px solid rgba(229,9,20,0.2); padding:3px 10px; border-radius:999px; text-transform:uppercase;">🇯🇵 Est. Osaka, Japan 1977</span>
            <span style="font-size:0.72rem; font-weight:800; color:#1F1610; background:#F8FAFC; border:1px solid #E2E8F0; padding:3px 10px; border-radius:999px; text-transform:uppercase;">✨ Professional Performance Haircare</span>
          </div>
          <p style="font-size: 0.9rem; color: #4A3B32; line-height: 1.65; margin: 0 0 14px;">
            <strong>Syoss</strong> brings professional Japanese salon performance directly to your daily haircare routine. Co-developed and tested by master Japanese hairstylists and powered by Henkel hair science, Syoss combines traditional Asian botanicals (Black Rice, Violet Rice, Water Lily) with high-concentration <strong>Amino Complex</strong> and <strong>Kera-Lipid Technology</strong> to deeply rebuild damaged hair fibers, lock in brilliant color, and deliver salon-smooth hair at home.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            <span style="font-size: 0.75rem; background: #FAF7F2; border: 1px solid #EAE3DA; padding: 4px 12px; border-radius: 8px; font-weight: 700; color: #1F1610;">🧬 Kera-Lipid Cellular Repair</span>
            <span style="font-size: 0.75rem; background: #FAF7F2; border: 1px solid #EAE3DA; padding: 4px 12px; border-radius: 8px; font-weight: 700; color: #1F1610;">🌾 Asian Rice Amino Infusions</span>
            <span style="font-size: 0.75rem; background: #FAF7F2; border: 1px solid #EAE3DA; padding: 4px 12px; border-radius: 8px; font-weight: 700; color: #1F1610;">💈 100% Genuine Nagpur Stock</span>
          </div>
        </div>
      {%- endif -%}

      <div class="collection-meta-bar">
        <span class="collection-count-sub">Showing {{ collection.products_count }} authentic items available in-store and online</span>
      </div>
    </div>

    {%- assign sort_by = collection.sort_by | default: collection.default_sort_by | default: 'created-descending' -%}

    <!-- LUXURY COLLECTION CONTROLS: QUICK FILTERS, SORT & PRICE DRAWER -->
    <div class="collection-controls-bar">
      <!-- 1. Top Controls Row: [ Sort Dropdown ] and [ Price Filter Toggle ] -->
      <div class="collection-actions-row">
        <!-- Sort Dropdown -->
        <div class="sort-by-wrapper">
          <div class="sort-select-box">
            <select id="CollectionSortBy" class="sort-select" aria-label="Sort collection products">
              <option value="{{ collection.url }}?sort_by=created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>🆕 Recently Added</option>
              <option value="{{ collection.url }}?sort_by=best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>🔥 Best Selling</option>
              <option value="{{ collection.url }}?sort_by=price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>💰 Price: Low to High</option>
              <option value="{{ collection.url }}?sort_by=price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>💎 Price: High to Low</option>
              <option value="{{ collection.url }}?sort_by=manual" {% if sort_by == 'manual' %}selected{% endif %}>✨ Featured</option>
              <option value="{{ collection.url }}?sort_by=title-ascending" {% if sort_by == 'title-ascending' %}selected{% endif %}>🔤 Title: A–Z</option>
            </select>
            <span class="sort-arrow">▾</span>
          </div>
        </div>

        <!-- Filter Toggle Button -->
        <button type="button" class="btn-toggle-filters" id="BtnToggleFilters" aria-expanded="false">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="21" x2="4" y2="14"></line>
            <line x1="4" y1="10" x2="4" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12" y2="3"></line>
            <line x1="20" y1="21" x2="20" y2="16"></line>
            <line x1="20" y1="12" x2="20" y2="3"></line>
            <line x1="1" y1="14" x2="7" y2="14"></line>
            <line x1="9" y1="8" x2="15" y2="8"></line>
            <line x1="17" y1="16" x2="23" y2="16"></line>
          </svg>
          <span>Price Filter</span>
        </button>
      </div>

      <!-- 2. Quick Filter Pills Strip: Horizontal Touch-Scroll -->
      <div class="collection-quick-filters no-scrollbar">
        <span class="quick-filters-label">Quick:</span>
        <a href="{{ collection.url }}?sort_by=created-descending" class="filter-pill-chip {% if sort_by == 'created-descending' %}active{% endif %}">
          <span>🆕 Recently Added</span>
        </a>
        <a href="{{ collection.url }}?sort_by=best-selling" class="filter-pill-chip {% if sort_by == 'best-selling' %}active{% endif %}">
          <span>🔥 Best Selling</span>
        </a>
        <a href="{{ collection.url }}?sort_by=price-ascending" class="filter-pill-chip {% if sort_by == 'price-ascending' %}active{% endif %}">
          <span>💰 ₹ Low to High</span>
        </a>
        <a href="{{ collection.url }}?sort_by=price-descending" class="filter-pill-chip {% if sort_by == 'price-descending' %}active{% endif %}">
          <span>💎 ₹ High to Low</span>
        </a>
        <a href="{{ collection.url }}?filter.v.price.lte=499" class="filter-pill-chip">
          <span>Under ₹499</span>
        </a>
        <a href="{{ collection.url }}?filter.v.price.gte=500&filter.v.price.lte=999" class="filter-pill-chip">
          <span>₹500–₹999</span>
        </a>
        <a href="{{ collection.url }}?filter.v.price.gte=1000&filter.v.price.lte=1999" class="filter-pill-chip">
          <span>₹1,000–₹1,999</span>
        </a>
        <a href="{{ collection.url }}?filter.v.price.gte=2000" class="filter-pill-chip">
          <span>₹2,000+</span>
        </a>
        {%- if collection.url contains '?' or request.query_string != blank -%}
          <a href="{{ collection.url }}" class="filter-pill-chip clear-chip">
            <span>✕ Reset</span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Collapsible Advanced Price & Stock Filter Drawer / Panel -->
    <div class="collection-filter-panel" id="CollectionFilterPanel" style="display: none;">
      <form id="CollectionFilterForm" class="filter-form" action="{{ collection.url }}" method="GET">
        <input type="hidden" name="sort_by" value="{{ sort_by }}">
        
        <div class="filter-grid">
          <!-- Price Range Inputs -->
          <div class="filter-group">
            <h4 class="filter-group-title">💰 Custom Price Range (₹ INR)</h4>
            <div class="price-inputs-row">
              <div class="price-input-wrap">
                <span class="price-currency">₹</span>
                <input
                  type="number"
                  name="filter.v.price.gte"
                  id="FilterPriceMin"
                  class="price-number-input"
                  placeholder="Min Price"
                  min="0"
                  inputmode="numeric"
                >
              </div>
              <span class="price-range-sep">to</span>
              <div class="price-input-wrap">
                <span class="price-currency">₹</span>
                <input
                  type="number"
                  name="filter.v.price.lte"
                  id="FilterPriceMax"
                  class="price-number-input"
                  placeholder="Max Price"
                  min="0"
                  inputmode="numeric"
                >
              </div>
            </div>
          </div>

          <!-- Availability Filter -->
          <div class="filter-group">
            <h4 class="filter-group-title">📦 Stock Availability</h4>
            <label class="filter-checkbox-label">
              <input type="checkbox" name="filter.v.availability" value="1" class="filter-checkbox">
              <span>In Stock & Ready for Nagpur Delivery / Pickup</span>
            </label>
          </div>
        </div>

        <!-- Filter Actions -->
        <div class="filter-actions-bar">
          <a href="{{ collection.url }}" class="btn-clear-filters">Reset Filter</a>
          <button type="submit" class="btn-apply-filters">Apply Price Filter</button>
        </div>
      </form>
    </div>

    <!-- Collection Grid -->
    {%- paginate collection.products by 24 -%}
      {%- if collection.products_count == 0 -%}
        <div class="collection-empty-state">
          <div class="empty-icon-wrap">🛍️</div>
          <h2 class="empty-title">No products found in this collection</h2>
          <p class="empty-desc">New arrivals are being added daily to our Nagpur showroom. Explore our other popular collections.</p>
          <a href="/collections/all" class="btn-hero-primary">Browse All Collections</a>
        </div>
      {%- else -%}
        <div class="collection-products-grid">
          {%- for product in collection.products -%}
            {%- assign is_lazy = true -%}
            {%- if forloop.index <= 4 -%}
              {%- assign is_lazy = false -%}
            {%- endif -%}
            {% render 'product-card', product: product, lazy: is_lazy %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="pagination-wrapper">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
