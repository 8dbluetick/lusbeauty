<section class="lush-collection-section">
  <div class="page-width">
    <!-- Header -->
    <div class="collection-header-wrap">
      <span class="collection-super">LUSH BEAUTY MART NAGPUR</span>
      <h1 class="collection-main-title">{{ collection.title | default: "All Products" }}</h1>
      {%- if collection.description != blank -%}
        <p class="collection-desc">{{ collection.description }}</p>
      {%- endif -%}
      <p class="collection-count-sub">Showing {{ collection.products_count }} items available in-store and online</p>
    </div>

    <!-- Collection Grid -->
    {%- paginate collection.products by 16 -%}
      {%- if collection.products_count == 0 -%}
        <div class="collection-empty-state">
          <p>No products found in this collection.</p>
          <a href="/collections/all" class="btn-hero-primary">View All Products</a>
        </div>
      {%- else -%}
        <div class="products-grid-4">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="pagination-wrapper">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": []
}
{% endschema %}
