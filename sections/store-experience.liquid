{%- if section.settings.enable_section -%}
  <style>
  .lush-brand-marquee-section {
    padding: 28px 0 34px !important;
    background-color: #FAF7F2 !important;
    border-top: 1px solid #EAE3DA !important;
    border-bottom: 1px solid #EAE3DA !important;
    overflow: hidden !important;
    position: relative !important;
    width: 100% !important;
    display: block !important;
  }
  .brand-marquee-header-wrap {
    text-align: center !important;
    margin-bottom: 18px !important;
  }
  .brand-marquee-badge {
    display: inline-flex !important;
    padding: 4px 12px !important;
    background: rgba(197, 160, 89, 0.15) !important;
    border: 1px solid rgba(197, 160, 89, 0.4) !important;
    border-radius: 999px !important;
    color: #8B6F3E !important;
    font-size: 0.72rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.8px !important;
    text-transform: uppercase !important;
    margin-bottom: 8px !important;
  }
  .brand-marquee-heading {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: 1.85rem !important;
    font-weight: 800 !important;
    color: #1F1610 !important;
    margin: 0 0 6px !important;
  }
  .brand-marquee-sub {
    font-size: 0.88rem !important;
    color: #6E5E52 !important;
    margin: 0 auto !important;
    max-width: 560px !important;
  }
  .brand-marquee-container {
    width: 100% !important;
    overflow: hidden !important;
    position: relative !important;
    padding: 8px 0 !important;
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }
  .brand-marquee-track {
    display: flex !important;
    width: max-content !important;
    animation: brandMarqueeScroll 28s linear infinite !important;
    -webkit-animation: brandMarqueeScroll 28s linear infinite !important;
    will-change: transform !important;
  }
  .brand-marquee-container:hover .brand-marquee-track {
    animation-play-state: paused !important;
    -webkit-animation-play-state: paused !important;
  }
  @keyframes brandMarqueeScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @-webkit-keyframes brandMarqueeScroll {
    0% { -webkit-transform: translateX(0); }
    100% { -webkit-transform: translateX(-50%); }
  }
  .brand-marquee-content {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
    padding-right: 16px !important;
    flex-shrink: 0 !important;
  }
  .brand-logo-card {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 8px 20px !important;
    height: 56px !important;
    min-width: 135px !important;
    background: #FFFFFF !important;
    border: 1.5px solid #EAE3DA !important;
    border-radius: 12px !important;
    box-shadow: 0 2px 8px rgba(31, 22, 16, 0.04) !important;
    flex-shrink: 0 !important;
    cursor: default !important;
    user-select: none !important;
  }
  .brand-marquee-logo-img {
    max-height: 38px !important;
    max-width: 115px !important;
    width: auto !important;
    height: auto !important;
    object-fit: contain !important;
    display: block !important;
  }
  @media (max-width: 767px) {
    .lush-brand-marquee-section {
      padding: 24px 0 28px !important;
    }
    .brand-marquee-heading {
      font-size: 1.35rem !important;
    }
    .brand-logo-card {
      height: 48px !important;
      padding: 6px 14px !important;
      min-width: 105px !important;
    }
    .brand-marquee-logo-img {
      max-height: 30px !important;
      max-width: 95px !important;
    }
  }
  </style>

  <!-- 1. Luxury Brand Partner Logos Infinite Running Marquee -->
  <div class="lush-brand-marquee-section" id="BrandMarqueeSection">
    <div class="page-width brand-marquee-header-wrap">
      <div class="brand-marquee-title-row">
        <span class="brand-marquee-badge">🌟 100% ORIGINAL & AUTHORIZED</span>
        <h3 class="brand-marquee-heading">100% Genuine Authorized Brands</h3>
        <p class="brand-marquee-sub">Stocked fresh in our Nagpur Flagship Showroom & available for pan-India delivery.</p>
      </div>
    </div>

    <div class="brand-marquee-container">
      <div class="brand-marquee-track">
        <!-- Group 1 -->
        <div class="brand-marquee-content">
          <div class="brand-logo-card" title="Dot & Key">{% render 'brand-logo', brand: 'dot-and-key', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Kay Beauty">{% render 'brand-logo', brand: 'kay-beauty', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Lakmé">{% render 'brand-logo', brand: 'lakme', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="L'Oréal Professionnel">{% render 'brand-logo', brand: 'loreal-professionnel', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Minimalist">{% render 'brand-logo', brand: 'minimalist', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Cetaphil">{% render 'brand-logo', brand: 'cetaphil', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="M·A·C Cosmetics">{% render 'brand-logo', brand: 'mac', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="L'Oréal Paris">{% render 'brand-logo', brand: 'loreal-paris', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="e.l.f. Cosmetics">{% render 'brand-logo', brand: 'elf', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="The Ordinary">{% render 'brand-logo', brand: 'the-ordinary', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Laneige">{% render 'brand-logo', brand: 'laneige', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Charlotte Tilbury">{% render 'brand-logo', brand: 'charlotte-tilbury', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Dove">{% render 'brand-logo', brand: 'dove', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Kérastase">{% render 'brand-logo', brand: 'kerastase', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Estée Lauder">{% render 'brand-logo', brand: 'estee-lauder', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Love Beauty & Planet">{% render 'brand-logo', brand: 'love-beauty-planet', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Bath & Body Works">{% render 'brand-logo', brand: 'bath-and-body-works', class: 'brand-marquee-logo-img' %}</div>
        </div>

        <!-- Group 2 (Duplicate for Seamless Infinite Marquee Loop) -->
        <div class="brand-marquee-content" aria-hidden="true">
          <div class="brand-logo-card" title="Dot & Key">{% render 'brand-logo', brand: 'dot-and-key', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Kay Beauty">{% render 'brand-logo', brand: 'kay-beauty', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Lakmé">{% render 'brand-logo', brand: 'lakme', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="L'Oréal Professionnel">{% render 'brand-logo', brand: 'loreal-professionnel', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Minimalist">{% render 'brand-logo', brand: 'minimalist', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Cetaphil">{% render 'brand-logo', brand: 'cetaphil', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="M·A·C Cosmetics">{% render 'brand-logo', brand: 'mac', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="L'Oréal Paris">{% render 'brand-logo', brand: 'loreal-paris', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="e.l.f. Cosmetics">{% render 'brand-logo', brand: 'elf', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="The Ordinary">{% render 'brand-logo', brand: 'the-ordinary', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Laneige">{% render 'brand-logo', brand: 'laneige', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Charlotte Tilbury">{% render 'brand-logo', brand: 'charlotte-tilbury', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Dove">{% render 'brand-logo', brand: 'dove', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Kérastase">{% render 'brand-logo', brand: 'kerastase', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Estée Lauder">{% render 'brand-logo', brand: 'estee-lauder', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Love Beauty & Planet">{% render 'brand-logo', brand: 'love-beauty-planet', class: 'brand-marquee-logo-img' %}</div>
          <div class="brand-logo-card" title="Bath & Body Works">{% render 'brand-logo', brand: 'bath-and-body-works', class: 'brand-marquee-logo-img' %}</div>
        </div>
      </div>
    </div>
  </div>

  <section id="store-section" class="lush-store-section">
    <div class="page-width">
      <div class="section-header-center">
        {%- if section.settings.badge != blank -%}
          <span class="section-badge">{{ section.settings.badge }}</span>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading | default: "Visit Lush Beauty Mart" }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="section-subtitle">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="store-experience-grid">
        <!-- Left Column: 9:16 Portrait Story Video / Image Showcase -->
        <div class="store-media-column">
          {%- if section.settings.video_url != blank and section.settings.video_url contains 'http' and section.settings.video_url contains 'dsqxboxoc' == false -%}
            <div class="store-video-container">
              <video
                id="StoreStoryVideo"
                class="store-story-video"
                autoplay
                muted
                loop
                playsinline
                preload="auto"
                poster="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop"
              >
                <source src="{{ section.settings.video_url }}" type="video/mp4">
              </video>
            </div>
          {%- else -%}
            <div class="store-image-container">
              {%- if section.settings.store_image != blank -%}
                <img src="{{ section.settings.store_image | image_url: width: 1000 }}" alt="Lush Beauty Mart Nagpur Store" class="store-interior-img" width="800" height="900">
              {%- else -%}
                <img src="https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?q=80&w=1200&auto=format&fit=crop" alt="Lush Beauty Mart Store Interior" class="store-interior-img" width="800" height="900">
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <!-- Right Column: Interactive Google Maps Location Card -->
        <div class="store-location-card">
          <!-- Card Header with Luxury Eyebrow and Live Status -->
          <div class="location-card-header">
            <div>
              <span class="location-eyebrow-pill">📍 NAGPUR FLAGSHIP SHOWROOM</span>
              <h3 class="location-brand-name">{{ section.settings.store_name | default: settings.store_name | default: "Lush Beauty Mart" }}</h3>
              <p class="location-area">{{ section.settings.area | default: "Gandhi Nagar, North Ambazari Road, Nagpur" }}</p>
            </div>
            {%- if section.settings.open_status != blank -%}
              <span class="pill-open-now">
                <span class="pulse-green"></span>
                {{ section.settings.open_status }}
              </span>
            {%- endif -%}
          </div>

          <!-- Structured Luxury Info Grid -->
          <div class="location-details-list">
            <!-- 1. Address Card -->
            <div class="location-detail-item">
              <div class="detail-icon">📍</div>
              <div class="detail-text">
                <span class="detail-label">Store Address:</span>
                <p class="detail-value">{{ section.settings.address | default: settings.store_address | default: "Below Hotel Maitrayee, Near Lad Square, Metro Station Pillar No. 213, 214, North Ambazari Road, Gandhi Nagar, Nagpur – 440 010" }}</p>
              </div>
            </div>

            <!-- 2. Metro Landmark Card -->
            {%- if section.settings.landmark != blank -%}
              <div class="location-detail-item highlight-item">
                <div class="detail-icon">🚇</div>
                <div class="detail-text">
                  <span class="detail-label">Prime Metro Landmark:</span>
                  <div class="landmark-badge">
                    <span class="landmark-dot"></span>
                    <span class="landmark-text">{{ section.settings.landmark }}</span>
                  </div>
                </div>
              </div>
            {%- endif -%}

            <!-- 3. Timings Card -->
            {%- if section.settings.timings != blank -%}
              <div class="location-detail-item">
                <div class="detail-icon">⏰</div>
                <div class="detail-text">
                  <span class="detail-label">Store Timings:</span>
                  <p class="detail-value timings-value">{{ section.settings.timings }} <span class="tag-open-all">Open All 7 Days</span></p>
                </div>
              </div>
            {%- endif -%}
          </div>

          <!-- Interactive Google Maps Real Embed & Live Pin Container -->
          <div class="map-interactive-wrapper">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3721.282928090547!2d79.0572113!3d21.1396!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd4c0603f9e8a71%3A0x2f976a4df9e00000!2sHotel%20Maitrayee!5e0!3m2!1sen!2sin!4v1700000000000"
              width="100%"
              height="200"
              style="border:0; display:block; border-radius:12px;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Lush Beauty Mart Nagpur Showroom Google Map"
            ></iframe>
            <a href="{{ section.settings.map_link | default: settings.store_map_link | default: 'https://maps.google.com/?q=Hotel+Maitrayee+North+Ambazari+Road+Nagpur+440010' }}" target="_blank" rel="noopener noreferrer" class="map-floating-cta">
              <span class="pin-bounce">📍</span>
              <span>Open in Google Maps (Lad Square) ↗</span>
            </a>
          </div>

          <!-- Action Buttons: Directions, Rate on Google, Call, WhatsApp -->
          <div class="store-action-buttons">
            <a href="https://share.google/sWmPw0Ml2x1f3NPjo" target="_blank" rel="noopener noreferrer" class="btn-store-action btn-store-google-review" style="background: #FFF9EE; border-color: #C5A059; color: #8C6D2D;">
              <span>⭐ Rate on Google</span>
            </a>

            <a href="{{ section.settings.map_link | default: settings.store_map_link | default: 'https://maps.google.com/?q=Hotel+Maitrayee+North+Ambazari+Road+Nagpur+440010' }}" target="_blank" rel="noopener noreferrer" class="btn-store-action btn-store-dir">
              <span>🧭 Directions</span>
            </a>

            <a href="tel:{{ section.settings.phone | default: settings.store_phone | default: '9119595951' }}" class="btn-store-action btn-store-call">
              <span>📞 Call</span>
            </a>

            <a href="https://wa.me/{{ section.settings.whatsapp | default: settings.store_whatsapp | default: '919119595951' }}?text={{ 'Hi Lush Beauty Mart! I want to visit your store at Lad Square today.' | url_encode }}" target="_blank" rel="noopener noreferrer" class="btn-store-action btn-store-wa">
              <span>💬 WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Store Location",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Enable Section",
      "default": true
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "🏬 Flagship Experience Center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visit Lush Beauty Mart"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Subheading",
      "default": "Explore our collection in-store and discover dermatological skincare, cosmetics, designer handbags and beauty accessories all in one place."
    },
    {
      "type": "header",
      "content": "Store Video / Media (9:16 Instagram Story)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Store Section Video URL",
      "default": "",
      "info": "Paste the Instagram Story video URL. If left empty, fallback image is shown."
    },
    {
      "type": "image_picker",
      "id": "store_image",
      "label": "Fallback Store Interior Image"
    },
    {
      "type": "header",
      "content": "Location Details"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "Lush Beauty Mart"
    },
    {
      "type": "text",
      "id": "area",
      "label": "Area / Locality",
      "default": "Gandhi Nagar, North Ambazari Road, Nagpur"
    },
    {
      "type": "text",
      "id": "open_status",
      "label": "Open Status Tag",
      "default": "Open Today (10:30 AM - 9:30 PM)"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Full Address",
      "default": "Below Hotel Maitrayee, Near Lad Square, Metro Station Pillar No. 213, 214, North Ambazari Road, Gandhi Nagar, Nagpur – 440 010"
    },
    {
      "type": "text",
      "id": "landmark",
      "label": "Landmark / Metro Note",
      "default": "Directly opposite Metro Station Pillar No. 213 & 214"
    },
    {
      "type": "text",
      "id": "timings",
      "label": "Store Timings",
      "default": "Monday to Sunday: 10:30 AM – 9:30 PM (All 7 Days Open)"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Showroom Phone Number",
      "default": "9119595951"
    },
    {
      "type": "text",
      "id": "whatsapp",
      "label": "Showroom WhatsApp Number",
      "default": "919119595951"
    },
    {
      "type": "url",
      "id": "map_link",
      "label": "Google Maps Link"
    },
    {
      "type": "text",
      "id": "call_btn_text",
      "label": "Call Button Text",
      "default": "📞 Call Store"
    },
    {
      "type": "text",
      "id": "whatsapp_btn_text",
      "label": "WhatsApp Button Text",
      "default": "💬 WhatsApp Us"
    },
    {
      "type": "text",
      "id": "directions_btn_text",
      "label": "Directions Button Text",
      "default": "🧭 Get Directions"
    }
  ],
  "presets": [
    {
      "name": "Store Location"
    }
  ]
}
{% endschema %}
