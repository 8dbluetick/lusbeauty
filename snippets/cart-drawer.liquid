<div id="LushCartDrawer" class="cart-drawer-overlay" aria-hidden="true">
  <div class="cart-drawer-backdrop" data-close-cart></div>
  <div class="cart-drawer-panel">
    <!-- Header -->
    <div class="cart-drawer-header">
      <div class="cart-drawer-title-wrap">
        <svg class="cart-icon-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-2z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <h3 class="cart-drawer-heading">Shopping Bag</h3>
        <span class="cart-count-badge-drawer" data-cart-count>{{ cart.item_count }}</span>
      </div>
      <button type="button" class="cart-drawer-close" data-close-cart aria-label="Close cart">&times;</button>
    </div>

    <!-- Free Delivery Animated Progress Bar in Drawer -->
    {%- assign threshold = 99900 -%}
    {%- assign current_total = cart.total_price -%}
    {%- assign progress_percent = current_total | times: 100.0 | divided_by: threshold | at_most: 100 -%}
    <div class="cart-shipping-banner" id="DrawerShippingBanner">
      <div class="shipping-msg-wrap">
        <span class="shipping-icon">🚚</span>
        <div class="shipping-text" data-shipping-text>
          {%- if current_total >= threshold -%}
            <span class="shipping-unlocked">🎉 <strong>FREE Express Nagpur Delivery</strong> Unlocked!</span>
          {%- else -%}
            {%- assign needed = threshold | minus: current_total -%}
            <span>Add <strong>{{ needed | money }}</strong> more for <strong>FREE Nagpur Express Delivery</strong></span>
          {%- endif -%}
        </div>
      </div>
      <div class="drawer-progress-track">
        <div class="drawer-progress-bar" style="width: {{ progress_percent }}%;"></div>
      </div>
    </div>

    <!-- Cart Items Area -->
    <div class="cart-drawer-items" data-cart-items-container>
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty-state">
          <div class="empty-cart-icon">
            <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.4">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-2z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
          </div>
          <h4>Your beauty bag is empty</h4>
          <p>Explore luxury skincare, cosmetics, designer fragrances and viral drinkware from our Nagpur showroom.</p>
          <a href="/collections/all" class="btn-shop-collection" data-close-cart>
            <span>Explore Bestsellers</span>
            <span>→</span>
          </a>
        </div>
      {%- else -%}
        <div class="cart-item-list">
          {%- for item in cart.items -%}
            <div class="cart-drawer-item" data-line-key="{{ item.key }}">
              <a href="{{ item.url }}" class="drawer-item-img-link">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}" class="cart-item-img" width="80" height="100" loading="lazy">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'cart-placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="cart-item-info">
                <div class="cart-item-top">
                  <h5 class="cart-item-title"><a href="{{ item.url }}">{{ item.product.title }}</a></h5>
                  <button type="button" class="cart-item-remove" data-remove-item="{{ item.key }}" aria-label="Remove item">&times;</button>
                </div>
                {%- unless item.product.has_only_default_variant -%}
                  <span class="cart-item-variant">{{ item.variant.title }}</span>
                {%- endunless -%}
                <div class="cart-item-bottom">
                  <div class="qty-stepper">
                    <button type="button" class="qty-btn" data-qty-change="minus" data-key="{{ item.key }}" aria-label="Decrease quantity">−</button>
                    <span class="qty-num">{{ item.quantity }}</span>
                    <button type="button" class="qty-btn" data-qty-change="plus" data-key="{{ item.key }}" aria-label="Increase quantity">+</button>
                  </div>
                  <span class="cart-item-price">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Footer Summary & Checkout Actions -->
    <div class="cart-drawer-footer" id="CartDrawerFooter" style="{% if cart.item_count == 0 %}display: none;{% else %}display: flex;{% endif %}">
      <div class="cart-subtotal-row">
        <span>Bag Subtotal</span>
        <span class="cart-subtotal-val" data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>

      <div class="cart-shipping-row">
        <span>Nagpur Delivery</span>
        <span class="cart-shipping-val">
          {%- if cart.total_price >= threshold -%}
            <strong class="text-unlocked-badge">FREE</strong>
          {%- else -%}
            ₹50 (Free on ₹999+)
          {%- endif -%}
        </span>
      </div>

      <div class="cart-total-row">
        <span>Estimated Total</span>
        <span class="cart-total-val" data-cart-total>{{ cart.total_price | money }}</span>
      </div>

      <!-- Checkout CTAs -->
      <div class="cart-checkout-actions">
        <form action="/checkout" method="post">
          <button type="submit" class="btn-drawer-checkout" name="checkout">
            <span>Proceed to Checkout</span>
            <span class="arrow-icon">→</span>
          </button>
        </form>

        <button type="button" id="BtnWhatsAppOrder" class="btn-drawer-whatsapp">
          <span>💬 Instant 1-Click WhatsApp Order</span>
        </button>

        <a href="/cart" class="link-view-full-cart" data-close-cart>
          <span>View Full Shopping Bag Page →</span>
        </a>
      </div>

      <!-- Trust Badges Strip in Drawer -->
      <div class="cart-drawer-trust-strip">
        <div class="trust-badge-item">
          <span>🛡️ 100% Genuine Branded</span>
        </div>
        <div class="trust-badge-item">
          <span>⚡ Same-Day Nagpur Delivery</span>
        </div>
        <div class="trust-badge-item">
          <span>🏬 Showroom Pickup at Lad Sq.</span>
        </div>
      </div>
    </div>
  </div>
</div>
