<!-- Minimal, Elegant Add-to-Bag Toast Notification -->
<div id="LushToastContainer" class="lush-toast-container" aria-live="polite" role="status">
  <div id="LushAddToCartToast" class="lush-toast-card">
    <div class="toast-content-compact">
      <span class="toast-check-badge">✓</span>
      <div class="toast-text-wrap">
        <span class="toast-main-msg">Added to bag</span>
        <span id="ToastProductTitle" class="toast-item-title"></span>
      </div>
    </div>
    <div class="toast-actions-compact">
      <button type="button" class="btn-toast-view-bag" data-open-cart aria-label="Open Shopping Bag">
        <span>View Bag →</span>
      </button>
      <button type="button" class="btn-toast-close" id="BtnCloseToast" aria-label="Close notification">&times;</button>
    </div>
  </div>
</div>
