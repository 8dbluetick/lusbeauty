{% comment %}
  Lush Beauty Mart — Payment Badges & Logistics Vector Snippet
  Usage: {% render 'payment-trust-badges', type: 'upi|gpay|phonepe|paytm|visa|mastercard|rupay|shadowfax' %}
{% endcomment %}
{%- case type -%}
  {%- when 'upi' -%}
    <svg viewBox="0 0 70 24" height="18" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="UPI">
      <path d="M12 2L4 22H10L14 12H19L23 2H12Z" fill="#097939"/>
      <path d="M19 12L15 22H21L25 12H19Z" fill="#ED752E"/>
      <text x="32" y="17" font-family="'Arial Black', sans-serif" font-size="14" font-weight="900" fill="#2E3192" letter-spacing="1">UPI</text>
    </svg>

  {%- when 'gpay' or 'google-pay' -%}
    <svg viewBox="0 0 65 24" height="18" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Google Pay">
      <path d="M10.8 11.8V9.3H19.7C19.8 9.9 19.9 10.4 19.9 11.2C19.9 13.9 18.9 16.5 16.8 18.1C14.8 19.6 12.2 20.4 9.3 20.4C4.2 20.4 0 16.2 0 11.2C0 6.1 4.2 2 9.3 2C11.9 2 14.1 2.9 15.9 4.6L13.8 6.6C12.7 5.5 11.2 4.9 9.3 4.9C5.9 4.9 3.1 7.7 3.1 11.2C3.1 14.6 5.9 17.5 9.3 17.5C11.6 17.5 13.3 16.5 14.2 15.4C14.9 14.6 15.3 13.5 15.5 11.8H10.8Z" fill="#4285F4"/>
      <text x="24" y="16" font-family="'Product Sans', Arial, sans-serif" font-size="13" font-weight="700" fill="#5F6368">Pay</text>
    </svg>

  {%- when 'phonepe' -%}
    <svg viewBox="0 0 75 24" height="18" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="PhonePe">
      <circle cx="11" cy="12" r="10" fill="#5F259F"/>
      <path d="M8 7H14C15.6 7 16.8 8.1 16.8 9.6C16.8 11.1 15.6 12.2 14 12.2H11V17H8V7ZM11 10.2H13.6C14.2 10.2 14.7 9.8 14.7 9.3C14.7 8.8 14.2 8.4 13.6 8.4H11V10.2Z" fill="#FFFFFF"/>
      <text x="25" y="17" font-family="'Montserrat', sans-serif" font-size="12" font-weight="800" fill="#5F259F">PhonePe</text>
    </svg>

  {%- when 'paytm' -%}
    <svg viewBox="0 0 65 24" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Paytm">
      <text x="2" y="17" font-family="'Arial Black', sans-serif" font-size="13" font-weight="900" fill="#002E6E">Pay</text>
      <text x="32" y="17" font-family="'Arial Black', sans-serif" font-size="13" font-weight="900" fill="#00BAF2">tm</text>
    </svg>

  {%- when 'visa' -%}
    <svg viewBox="0 0 60 22" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Visa">
      <text x="3" y="17" font-family="'Arial Black', sans-serif" font-size="18" font-weight="900" font-style="italic" fill="#1A1F71" letter-spacing="1">VISA</text>
    </svg>

  {%- when 'mastercard' -%}
    <svg viewBox="0 0 52 24" height="18" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mastercard">
      <circle cx="16" cy="12" r="10" fill="#EB001B"/>
      <circle cx="28" cy="12" r="10" fill="#F79E1B"/>
      <path d="M22 5.3A10 10 0 0 1 22 18.7A10 10 0 0 1 22 5.3Z" fill="#FF5F00"/>
    </svg>

  {%- when 'rupay' -%}
    <svg viewBox="0 0 70 24" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="RuPay">
      <text x="3" y="17" font-family="'Arial Black', sans-serif" font-size="15" font-weight="900" font-style="italic" fill="#097939">Ru</text>
      <text x="28" y="17" font-family="'Arial Black', sans-serif" font-size="15" font-weight="900" font-style="italic" fill="#ED752E">Pay</text>
      <path d="M56 6L50 18H56L62 6H56Z" fill="#097939"/>
      <path d="M62 6L56 18H62L68 6H62Z" fill="#ED752E"/>
    </svg>

  {%- when 'shadowfax' -%}
    <svg viewBox="0 0 170 38" height="30" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Shadowfax Express Logistics">
      <!-- Lightning Wing Icon -->
      <path d="M12 7L4 21H16L12 31L26 15H15L20 7H12Z" fill="#FF6B00"/>
      <!-- Shadowfax Wordmark -->
      <text x="34" y="24" font-family="'Montserrat', 'Helvetica Neue', Arial, sans-serif" font-size="17" font-weight="900" letter-spacing="1" fill="#1A1F2C">SHADOWFAX</text>
      <text x="35" y="34" font-family="'Montserrat', sans-serif" font-size="7" font-weight="700" letter-spacing="2.5" fill="#FF6B00">EXPRESS LOGISTICS</text>
    </svg>
{%- endcase -%}
