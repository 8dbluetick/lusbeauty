{% comment %}
  Lush Beauty Mart — Brand Logo Official Cloudinary CDN Snippet
  Usage: {% render 'brand-logo', brand: 'brand-handle', class: 'custom-class', loading: 'eager' %}
{% endcomment %}
{%- assign b_class = class | default: 'brand-logo-img' -%}
{%- assign b_loading = loading | default: 'eager' -%}
{%- assign b_handle = brand | downcase | replace: ' ', '-' | replace: '&', 'and' | replace: '·', '' | replace: '.', '' | replace: "'", '' | replace: 'é', 'e' | replace: 'ē', 'e' -%}

{%- case b_handle -%}
  {%- when 'vgr' or 'vgr-india' or 'vgr-voyager' -%}
    <img src="{{ 'vgr-logo.png' | asset_url }}" alt="VGR Professional" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'skin1004' or 'centella' or 'madagascar-centella' or 'skin-1004' -%}
    <img src="{{ 'skin1004-centella-logo.png' | asset_url }}" alt="SKIN1004 Madagascar Centella" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

    {%- when 'skin-cottage' or 'skincottage' -%}
    <svg class="{{ b_class }}" viewBox="0 0 140 40" width="140" height="40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="140" height="40" rx="6" fill="#F4FBF7"/>
      <path d="M22 14C22 14 26 12 28 16C30 20 27 24 22 25C20 22 20 17 22 14Z" fill="#2D6A4F" opacity="0.85"/>
      <path d="M22 25C22 25 18 27 16 23C14 19 17 15 22 14C24 17 24 22 22 25Z" fill="#52B788" opacity="0.85"/>
      <text x="36" y="21" font-family="'Playfair Display', Georgia, serif" font-size="12" font-weight="800" letter-spacing="1.2" fill="#1B4332">SKIN COTTAGE</text>
      <text x="37" y="30" font-family="'Montserrat', sans-serif" font-size="6" font-weight="700" letter-spacing="1.8" fill="#52B788">LUXURY BODY CARE</text>
    </svg>

  {%- when 'rasasi' or 'rasasi-perfumes' -%}
    <svg class="{{ b_class }}" viewBox="0 0 140 40" width="140" height="40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="140" height="40" rx="6" fill="#14110E"/>
      <path d="M20 13L24 16L20 19L16 16L20 13Z" fill="#D4AF37"/>
      <path d="M20 16L22 23H18L20 16Z" fill="#C5A059"/>
      <text x="34" y="22" font-family="'Cinzel', 'Playfair Display', serif" font-size="14.5" font-weight="800" letter-spacing="2.8" fill="#D4AF37">RASASI</text>
      <text x="35" y="31" font-family="'Montserrat', sans-serif" font-size="5.5" font-weight="700" letter-spacing="2.2" fill="#E8D5A5">PARFUMS · DUBAI</text>
    </svg>

  {%- when 'possibility' or 'possibility-london' -%}
    <svg class="{{ b_class }}" viewBox="0 0 140 40" width="140" height="40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="140" height="40" rx="6" fill="#FFF5F7"/>
      <circle cx="20" cy="20" r="10" fill="#FF8FA3" opacity="0.25"/>
      <path d="M16 20C16 17 20 15 24 18C21 24 18 23 16 20Z" fill="#FF4D6D"/>
      <text x="35" y="22" font-family="'Playfair Display', Georgia, cursive, serif" font-size="14" font-weight="800" font-style="italic" fill="#590D22">Possibility</text>
      <text x="36" y="31" font-family="'Montserrat', sans-serif" font-size="5.5" font-weight="700" letter-spacing="1.8" fill="#A4133C">ULTRA RICH · LONDON</text>
    </svg>

  {%- when 'syoss' or 'syoss-hair' -%}
    <img src="{{ 'syoss-logo.svg' | asset_url }}" alt="Syoss Professional Performance" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40" style="object-fit: contain;">

  {%- when 'gliss' or 'gliss-kur' or 'schwarzkopf-gliss' -%}
    <svg class="{{ b_class }}" viewBox="0 0 140 40" width="140" height="40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="140" height="40" rx="6" fill="#141414"/>
      <path d="M16 20C16 15 24 15 24 20C24 25 16 25 16 20Z" stroke="#E5A93C" stroke-width="2" fill="none"/>
      <circle cx="20" cy="20" r="2.5" fill="#E5A93C"/>
      <text x="34" y="22" font-family="'Arial Black', 'Helvetica Neue', sans-serif" font-size="14.5" font-weight="900" letter-spacing="2" fill="#FFFFFF">GLISS</text>
      <text x="35" y="31" font-family="'Montserrat', sans-serif" font-size="5" font-weight="700" letter-spacing="1.2" fill="#E5A93C">HAIR REPAIR · KERATIN</text>
    </svg>

  {%- when 'dot-and-key' or 'dot-key' or 'dotandkey' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/dot-and-key.png.jpg" alt="Dot & Key" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'kay-beauty' or 'kaybeauty' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/kay-beauty.png.png" alt="Kay Beauty" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'lakme' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/lakme.png.jpg" alt="Lakmé" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'loreal-professionnel' or 'loreal-pro' or 'l_oreal_professionnel' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/loreal-pro.png.jpg" alt="L'Oréal Professionnel" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'minimalist' or 'be-minimalist' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566820/minimalist.webp" alt="Minimalist" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'cetaphil' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566820/cetaphil.png.png" alt="Cetaphil" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'mac' or 'mac-cosmetics' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566820/mac.png.png" alt="M·A·C Cosmetics" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'loreal-paris' or 'loreal' or 'l_oreal_paris' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566820/loreal-paris.png.jpg" alt="L'Oréal Paris" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'elf' or 'elf-cosmetics' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566820/elf.png.png" alt="e.l.f. Cosmetics" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'the-ordinary' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566819/the-ordinary.png.jpg" alt="The Ordinary" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'laneige' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566820/laneige.png.png" alt="Laneige" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'charlotte-tilbury' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/charlotte-tilbury.png.jpg" alt="Charlotte Tilbury" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'dove' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/dove.png.png" alt="Dove" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'kerastase' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566822/kerastase.png.png" alt="Kérastase" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'estee-lauder' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/estee-lauder.png.png" alt="Estée Lauder" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'love-beauty-planet' or 'lbp' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/love-beauty-planet.png.png" alt="Love Beauty & Planet" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'bath-and-body-works' or 'bath-body-works' or 'bbw' -%}
    <img src="https://res.cloudinary.com/hsg3gdjc/image/upload/v1792566821/bath-and-body-works.png" alt="Bath & Body Works" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- else -%}
    <span class="{{ b_class }} brand-name-fallback">{{ brand | escape }}</span>
{%- endcase -%}
