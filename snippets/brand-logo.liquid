      <rect width="140" height="40" rx="6" fill="#FFF5F7"/>
      <circle cx="20" cy="20" r="10" fill="#FF8FA3" opacity="0.25"/>
      <path d="M16 20C16 17 20 15 24 18C21 24 18 23 16 20Z" fill="#FF4D6D"/>
      <text x="35" y="22" font-family="'Playfair Display', Georgia, cursive, serif" font-size="14" font-weight="800" font-style="italic" fill="#590D22">Possibility</text>
