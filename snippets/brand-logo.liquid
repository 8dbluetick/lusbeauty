{% comment %}
  Lush Beauty Mart — Official Brand Logo Snippet
  Bulletproof local theme assets with instant SVG/PNG rendering and zero cracked images
  Usage: {% render 'brand-logo', brand: 'brand-handle', class: 'custom-class', loading: 'eager' %}
{% endcomment %}
{%- assign b_class = class | default: 'brand-logo-img' -%}
{%- assign b_loading = loading | default: 'eager' -%}
{%- assign b_handle = brand | downcase | replace: ' ', '-' | replace: '&', 'and' | replace: '·', '' | replace: '.', '' | replace: "'", '' | replace: 'é', 'e' | replace: 'ē', 'e' -%}

{%- case b_handle -%}
  {%- when 'vgr' or 'vgr-india' or 'vgr-voyager' -%}
    <img src="{{ 'vgr-logo.png' | asset_url }}" alt="VGR Professional" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40" style="object-fit: contain;" onerror="this.onerror=null; this.src='{{ 'vgr-logo.png' | asset_url }}';">

  {%- when 'skin1004' or 'centella' or 'madagascar-centella' or 'skin-1004' or 'skin1004-centella' -%}
    <img src="{{ 'skin1004-centella-logo.png' | asset_url }}" alt="SKIN1004 Madagascar Centella" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40" style="object-fit: contain;" onerror="this.onerror=null; this.src='{{ 'skin1004-centella-logo.png' | asset_url }}';">

