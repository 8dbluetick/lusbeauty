{% comment %}
  Lush Beauty Mart — Brand Logo Official Cloudinary CDN Snippet
  Usage: {% render 'brand-logo', brand: 'brand-handle', class: 'custom-class', loading: 'eager' %}
{% endcomment %}
{%- assign b_class = class | default: 'brand-logo-img' -%}
{%- assign b_loading = loading | default: 'eager' -%}
{%- assign b_handle = brand | downcase | replace: ' ', '-' | replace: '&', 'and' | replace: '·', '' | replace: '.', '' | replace: "'", '' | replace: 'é', 'e' | replace: 'ē', 'e' -%}

{%- case b_handle -%}
  {%- when 'vgr' or 'vgr-india' or 'vgr-voyager' -%}
    <img src="{{ 'vgr-logo.png' | asset_url }}" alt="VGR Professional" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

  {%- when 'skin1004' or 'centella' or 'madagascar-centella' or 'skin-1004' -%}
    <img src="{{ 'skin1004-centella-logo.png' | asset_url }}" alt="SKIN1004 Madagascar Centella" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40">

    {%- when 'skin-cottage' or 'skincottage' -%}
    <img src="{{ 'skin-cottage-logo.png' | asset_url }}" alt="Skin Cottage Luxury Body Care" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40" style="object-fit: contain;">

  {%- when '3q' or '3q-beauty' or '3qbeauty' or 'three-q' or 'three-q-beauty' -%}
    <img src="{{ '3q-beauty-logo.png' | asset_url }}" alt="3Q Beauty Cosmetics" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40" style="object-fit: contain;">

  {%- when 'rasasi' or 'rasasi-perfumes' -%}
    <img src="{{ 'rasasi-logo.png' | asset_url }}" alt="Rasasi Parfums Dubai" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40" style="object-fit: contain;">

  {%- when 'possibility' or 'possibility-london' -%}
    <svg class="{{ b_class }}" viewBox="0 0 140 40" width="140" height="40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="140" height="40" rx="6" fill="#FFF5F7"/>
      <circle cx="20" cy="20" r="10" fill="#FF8FA3" opacity="0.25"/>
      <path d="M16 20C16 17 20 15 24 18C21 24 18 23 16 20Z" fill="#FF4D6D"/>
      <text x="35" y="22" font-family="'Playfair Display', Georgia, cursive, serif" font-size="14" font-weight="800" font-style="italic" fill="#590D22">Possibility</text>
      <text x="36" y="31" font-family="'Montserrat', sans-serif" font-size="5.5" font-weight="700" letter-spacing="1.8" fill="#A4133C">ULTRA RICH · LONDON</text>
    </svg>

  {%- when 'syoss' or 'syoss-hair' -%}
    <img src="{{ 'syoss-logo.svg' | asset_url }}" alt="Syoss Professional Performance" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40" style="object-fit: contain;">

        {%- when 'versace' or 'versace-parfums' or 'versace-beauty' -%}
    <img src="{{ 'versace-logo.png' | asset_url }}" alt="Versace Milano" class="{{ b_class }}" loading="{{ b_loading }}" width="140" height="40" style="object-fit: contain;">

  {%- when 'nivea' or 'nivea-creme' or 'nivea-india' -%}
