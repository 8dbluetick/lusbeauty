{% comment %}
  Lush Beauty Mart — Blinkit Quick-Commerce Floating Cart Strip
  Provides instant 1-tap checkout bar when any item is in bag
{% endcomment %}

<div class="blinkit-floating-cart-strip" id="BlinkitFloatingCartStrip" style="display: none;">
  <div class="page-width blinkit-strip-container">
    <div class="blinkit-strip-left" data-open-cart role="button" tabindex="0">
      <div class="blinkit-strip-bag-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="blinkit-cart-qty-badge" id="BlinkitStripCount">0</span>
      </div>
      <div class="blinkit-strip-info">
        <div class="blinkit-strip-total-row">
          <span class="blinkit-strip-total" id="BlinkitStripTotal">₹0.00</span>
          <span class="blinkit-strip-savings" id="BlinkitStripSavings" style="display: none;">Saved</span>
        </div>
        <div class="blinkit-strip-sub">⚡ 2-Hr Express Delivery • Lad Sq. Nagpur</div>
      </div>
    </div>

    <button type="button" class="btn-blinkit-view-cart" data-open-cart aria-label="View Shopping Bag">
      <span>View Bag</span>
      <span class="blinkit-strip-arrow">→</span>
    </button>
  </div>
</div>
