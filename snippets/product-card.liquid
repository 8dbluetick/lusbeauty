{% comment %}
  Renders a luxury, professional product card
  Accepts:
  - product: {Object} Product Liquid object
  - show_vendor: {Boolean} Show the product vendor (default: true)
  - lazy: {Boolean} Whether to lazy load the image (default: true)
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign price = current_variant.price -%}
{%- assign compare_at_price = current_variant.compare_at_price -%}
{%- assign vendor = product.vendor | default: product.collections.first.title | default: 'LUSH' -%}
{%- assign card_img = product.featured_media | default: product.featured_image | default: product.media.first | default: product.images.first -%}
{%- assign secondary_img = product.media[1] | default: product.images[1] -%}

<div class="lush-product-card group" data-product-id="{{ product.id }}" data-category="{{ product.type | downcase }} {{ product.tags | join: ' ' | downcase }}">
  <!-- 1. Product Image Container (Consistent 4:5 Aspect Ratio) -->
  <div class="card-media-wrapper">
    <a href="{{ product.url }}" class="card-image-link" aria-label="{{ product.title | escape }}">
      {%- if card_img != blank -%}
        <img
          src="{{ card_img | image_url: width: 540 }}"
          srcset="{{ card_img | image_url: width: 320 }} 320w, {{ card_img | image_url: width: 480 }} 480w, {{ card_img | image_url: width: 640 }} 640w, {{ card_img | image_url: width: 800 }} 800w"
          sizes="(max-width: 480px) 50vw, (max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw"
          alt="{{ card_img.alt | default: product.title | escape }}"
          class="card-primary-image"
          loading="{% if lazy == false %}eager{% else %}lazy{% endif %}"
          {% if lazy == false %}fetchpriority="high"{% endif %}
          decoding="async"
          width="500"
          height="625"
        >
        {%- if secondary_img != blank -%}
          <img
            src="{{ secondary_img | image_url: width: 540 }}"
            srcset="{{ secondary_img | image_url: width: 320 }} 320w, {{ secondary_img | image_url: width: 480 }} 480w, {{ secondary_img | image_url: width: 640 }} 640w"
            sizes="(max-width: 480px) 50vw, (max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw"
            alt="{{ product.title | escape }}"
            class="card-secondary-image"
            loading="lazy"
            decoding="async"
            width="500"
            height="625"
          >
        {%- endif -%}
      {%- else -%}
        <div class="card-placeholder-wrap">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg card-primary-image' }}
        </div>
      {%- endif -%}
    </a>

    <!-- 2. Badges (Top-Left, non-overlapping) -->
    <div class="card-badges">
      <span class="badge badge-blinkit">⚡ 2-HR DELIVERY</span>
      {%- if compare_at_price > price -%}
        {%- assign discount = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round -%}
        <span class="badge badge-discount">{{ discount }}% OFF</span>
      {%- endif -%}
      {%- if product.tags contains 'Bestseller' or product.tags contains 'bestseller' or product.tags contains 'Best Seller' -%}
        <span class="badge badge-bestseller">★ BESTSELLER</span>
      {%- elsif product.tags contains 'Trending' or product.tags contains 'trending' -%}
        <span class="badge badge-trending">🔥 TRENDING</span>
      {%- elsif product.tags contains 'New' or product.tags contains 'new' or product.tags contains 'New Arrival' -%}
        <span class="badge badge-new">✨ NEW</span>
      {%- elsif product.tags contains 'Premium' or product.tags contains 'premium' or product.tags contains 'Luxury' -%}
        <span class="badge badge-premium">💎 PREMIUM</span>
      {%- endif -%}
    </div>

    <!-- 3. Top Action Buttons (Wishlist, Share & WhatsApp, Top-Right) -->
    <div class="card-top-actions">
      <button
        type="button"
        class="card-action-btn card-wishlist-btn"
        data-wishlist-toggle="{{ product.id }}"
        data-product-id="{{ product.id }}"
        data-product-title="{{ product.title | escape }}"
        data-product-url="{{ product.url }}"
        data-product-image="{{ product.featured_image | image_url: width: 300 }}"
        data-product-price="{{ product.price | money }}"
        data-product-vendor="{{ product.vendor | default: shop.name | escape }}"
        title="Add to Wishlist"
        aria-label="Add to Wishlist"
      >
        <svg class="icon-heart" viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>

      <!-- Share Action -->
      <button
        type="button"
        class="card-action-btn card-share-btn"
        data-share-btn
        data-share-title="{{ product.title | escape }}"
        data-share-url="{{ shop.url }}{{ product.url }}"
        title="Share Product"
        aria-label="Share Product"
      >
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
      </button>

      {%- assign whatsapp_msg = 'Hi Lush Beauty Mart Nagpur! I want to order ' | append: product.title | append: ' (Price: ' | append: price | money | append: '). Is this available at Nagpur store?' -%}
      <a
        href="https://wa.me/{{ settings.store_whatsapp | default: '919119595951' }}?text={{ whatsapp_msg | url_encode }}"
        target="_blank"
        rel="noopener noreferrer"
        class="card-action-btn card-whatsapp-btn"
        title="Enquire on WhatsApp"
        aria-label="WhatsApp Enquiry"
      >
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- 4. Product Details Area -->
  <div class="card-content">
    <!-- Brand / Vendor Name -->
    <div class="card-brand-wrap">
      <span class="card-brand">{{ vendor | upcase }}</span>
    </div>

    <!-- Product Title (Clamped to 2 lines) -->
    <h3 class="card-title">
      <a href="{{ product.url }}" title="{{ product.title | escape }}">{{ product.title }}</a>
    </h3>

    <!-- Short Description (Clamped to 2 lines, graceful fallback) -->
    {%- assign raw_desc = product.description | strip_html | strip -%}
    {%- if raw_desc != blank -%}
      <p class="card-description">{{ raw_desc | truncate: 85 }}</p>
    {%- else -%}
      <p class="card-description card-desc-empty">&nbsp;</p>
    {%- endif -%}

    <!-- Pricing Block -->
    <div class="card-price-block">
      <span class="price-current">{{ price | money }}</span>
      {%- if compare_at_price > price -%}
        <span class="price-mrp">{{ compare_at_price | money }}</span>
      {%- endif -%}
    </div>

    <!-- Add to Cart / Action Button (Blinkit Interactive Quick Stepper Enabled) -->
    <div class="card-cta-wrap" data-card-stepper-wrap data-variant-id="{{ current_variant.id }}">
      {%- if product.available -%}
        {%- if product.variants.size > 1 -%}
          <a href="{{ product.url }}" class="btn-card-add-to-cart" aria-label="Select Options for {{ product.title | escape }}">
            <span>Select Options</span>
          </a>
        {%- else -%}
          <form method="post" action="/cart/add" class="card-form" data-card-product-form>
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <button type="submit" class="btn-card-add-to-cart btn-blinkit-add" aria-label="Add {{ product.title | escape }} to Bag">
              <span class="btn-add-label">+ ADD</span>
            </button>
          </form>
        {%- endif -%}
      {%- else -%}
        <button type="button" class="btn-card-add-to-cart btn-sold-out" disabled>
          <span>Sold Out</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>
