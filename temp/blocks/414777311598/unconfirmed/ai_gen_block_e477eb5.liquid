    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ai-offers-promo-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
    letter-spacing: -0.02em;
  }

  .ai-offers-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-offer-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    background-color: {{ block.settings.offer_bg }};
    border: 1px solid {{ block.settings.offer_border }};
    border-radius: {{ block.settings.offer_radius }}px;
    transition: all 0.2s ease;
  }

  .ai-offer-item-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.accent_color }};
    box-shadow: 0 2px 6px rgba(197, 160, 89, 0.15);
  }

  .ai-offer-item-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-offer-icon-{{ ai_gen_id }} {
    font-size: 20px;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.card_background }};
    border-radius: 50%;
    font-weight: 600;
  }

  .ai-offer-content-{{ ai_gen_id }} {
    flex-grow: 1;
    min-width: 0;
  }

  .ai-offer-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 2px 0;
  }

  .ai-offer-desc-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.text_secondary }};
    margin: 0;
  }

  .ai-offer-code-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .ai-offer-code-{{ ai_gen_id }} {
    padding: 6px 12px;
    background-color: {{ block.settings.card_background }};
    border: 1px dashed {{ block.settings.accent_color }};
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    color: {{ block.settings.accent_color }};
    letter-spacing: 0.5px;
    font-family: monospace;
  }

  .ai-copy-btn-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    transition: opacity 0.2s ease;
    position: relative;
  }

  .ai-copy-btn-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-copy-btn-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  .ai-copy-feedback-{{ ai_gen_id }} {
    position: absolute;
    top: -28px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.text_color }};
    color: {{ block.settings.card_background }};
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 11px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .ai-copy-feedback-{{ ai_gen_id }}.show {
    opacity: 1;
  }

  .ai-view-all-{{ ai_gen_id }} {
    margin-top: 12px;
    text-align: center;
  }

  .ai-view-all-btn-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.accent_color }};
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    padding: 8px 16px;
    transition: opacity 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .ai-view-all-btn-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  @media (max-width: 749px) {
    .ai-offers-promo-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.75 }}px;
    }

    .ai-offer-item-{{ ai_gen_id }} {
      flex-wrap: wrap;
    }

    .ai-offer-code-wrapper-{{ ai_gen_id }} {
      width: 100%;
      justify-content: space-between;
      margin-top: 8px;
    }
  }
{% endstyle %}

