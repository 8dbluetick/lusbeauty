<script>
  (function() {
    class OffersPromo{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.expanded = false;
      }

      connectedCallback() {
        this.copyButtons = this.querySelectorAll('.ai-copy-btn-{{ ai_gen_id }}');
        this.viewAllButton = this.querySelector('.ai-view-all-btn-{{ ai_gen_id }}');
        this.viewAllText = this.querySelector('.ai-view-all-text-{{ ai_gen_id }}');
        this.hiddenOffers = this.querySelectorAll('.ai-offer-item-{{ ai_gen_id }}.hidden');

        this.setupCopyButtons();
        this.setupViewAll();
      }

      setupCopyButtons() {
        this.copyButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            const code = button.getAttribute('data-code');
            const feedback = button.querySelector('.ai-copy-feedback-{{ ai_gen_id }}');
            
            navigator.clipboard.writeText(code).then(() => {
              feedback.classList.add('show');
              setTimeout(() => {
                feedback.classList.remove('show');
              }, 1500);
            }).catch(() => {
              const textArea = document.createElement('textarea');
              textArea.value = code;
              textArea.style.position = 'fixed';
              textArea.style.left = '-9999px';
              document.body.appendChild(textArea);
              textArea.select();
              document.execCommand('copy');
              document.body.removeChild(textArea);
              
              feedback.classList.add('show');
              setTimeout(() => {
                feedback.classList.remove('show');
              }, 1500);
            });
          });
        });
      }

      setupViewAll() {
        this.viewAllButton.addEventListener('click', () => {
          this.expanded = !this.expanded;
          
          this.hiddenOffers.forEach((offer) => {
            if (this.expanded) {
              offer.classList.remove('hidden');
            } else {
              offer.classList.add('hidden');
            }
          });

          this.viewAllText.textContent = this.expanded ? 'Show Less' : 'View All Offers';
          this.viewAllButton.setAttribute('aria-expanded', this.expanded);
        });
      }
    }

    customElements.define('offers-promo-{{ ai_gen_id }}', OffersPromo{{ ai_gen_id }});
  })();
</script>

