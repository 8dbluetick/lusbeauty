{% doc %}
  @prompt
    Create a premium "Offers & Promo" section and an improved "Share Product" section for the product page of a luxury beauty store called Lush Beauty Mart.
    
    DESIGN AESTHETIC:
    - Warm beige/cream background
    - Elegant brown/dark text
    - Subtle gold accents
    - Rounded corners
    - Thin premium borders
    - Soft shadow
    - Clean modern typography
    - Minimal luxury beauty-store appearance (NOT generic Shopify default)
    
    --- OFFERS & PROMO SECTION ---
    
    Create a premium card titled "🔥 Offers & Promo"
    
    Use the following existing Shopify discount codes (DO NOT create new ones, DO NOT modify existing ones):
    - LUSHGIFT — 10% off entire order, minimum purchase ₹999
    - FRESHIP — Free shipping on all products for India
    - LUSH200 — ₹200 off, minimum purchase ₹1,499
    - LUSH100 — ₹100 off, minimum purchase ₹799
    - LUSH15 — 15% off, minimum purchase ₹999
    - LUSH10 — 10% off, minimum purchase ₹499
    
    Each offer card should show:
    - Small attractive icon (e.g. % for discount, 🚚 for shipping)
    - Offer title (e.g. "Get ₹200 OFF")
    - Short description (e.g. "Shop for ₹1,499 or more")
    - Discount code in a dashed/bordered pill
    - Copy icon button beside the code
    - Clicking copy → copies code to clipboard → shows "Copied!" for 1–2 seconds
    
    OFFER LOGIC:
    - Initially show only the 2 most valuable offers (LUSH200 and FRESHIP)
    - "View All Offers →" link smoothly expands to reveal all remaining offers
    - Clicking "View All Offers" changes text to "Show Less"
    - Smooth expand/collapse animation (no page reload)
    - Each offer has its own copy button
    
    --- SHARE PRODUCT SECTION ---
    
    Place directly below the Offers & Promo card.
    
    Create a clean premium "Share Product" box with three buttons in one row:
    1. [ Share ] — uses native Web Share API (product name + product URL); fallback gracefully if not supported
    2. [ WhatsApp ] — opens WhatsApp with pre-filled message: "Check out this product from Lush Beauty Mart: [Product Name] [Product URL]"
    3. [ Copy Link ] — copies current product URL to clipboard; shows "Link Copied!" feedback
    
    Use Liquid variables for product title and URL (e.g. {{ product.title }}, {{ shop.url }}{{ product.url }}).
    
    --- PLACEMENT ---
    Position after Add to Cart / Buy Now buttons:
    Product Price → Quantity → Add to Bag / Buy Now → Offers & Promo → Share Product → Delivery info
    
    --- RESPONSIVE ---
    Desktop: compact horizontal layout, no excessive vertical space
    Mobile: stack naturally, code + copy button tappable, share buttons fit in one row or wrap gracefully
    
    --- ANIMATIONS ---
    - Smooth expand/collapse for "View All Offers"
    - Slight hover effect on offer rows
    - Copy button feedback animation
    - No excessive animations, keep performance fast
    
    --- ACCESSIBILITY ---
    - aria-labels on all copy/share buttons
    - Keyboard accessible
    - Good contrast
    - Do not rely only on color for states
    
    --- IMPORTANT CONSTRAINTS ---
    - Do NOT duplicate any existing sections
    - Do NOT interfere with Add to Bag, Buy Now, cart, checkout, or Shopify discount application system
    - Do NOT change product pricing
    - Inspect existing product page layout before inserting; modify minimum necessary files
    - Production-ready, clean, reusable code
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-share-product-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.padding }}px;
    margin: {{ block.settings.margin_top }}px 0;
    box-shadow: 0 2px 8px rgba(44, 29, 17, 0.06);
    width: 100%;
  }

  .ai-share-header-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px 0;
    letter-spacing: -0.02em;
  }

  .ai-share-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .ai-share-btn-{{ ai_gen_id }} {
    flex: 1;
    min-width: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 16px;
    background-color: {{ block.settings.button_bg }};
    color: {{ block.settings.button_text }};
    border: 1px solid {{ block.settings.button_border }};
    border-radius: {{ block.settings.button_radius }}px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .ai-share-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    border-color: {{ block.settings.accent_color }};
    transform: translateY(-1px);
    box-shadow: 0 2px 6px rgba(197, 160, 89, 0.15);
  }

  .ai-share-btn-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
  }

  .ai-share-btn-{{ ai_gen_id }}.whatsapp {
    background-color: {{ block.settings.whatsapp_bg }};
    color: {{ block.settings.whatsapp_text }};
    border-color: {{ block.settings.whatsapp_border }};
  }

  .ai-share-btn-{{ ai_gen_id }}.whatsapp:hover {
    background-color: {{ block.settings.whatsapp_hover_bg }};
    border-color: #25D366;
  }

  .ai-copy-feedback-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-share-feedback-{{ ai_gen_id }} {
    position: absolute;
    top: -36px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.text_color }};
    color: {{ block.settings.card_background }};
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
    z-index: 10;
  }

  .ai-share-feedback-{{ ai_gen_id }}.show {
    opacity: 1;
  }

  @media (max-width: 749px) {
    .ai-share-product-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.75 }}px;
    }

    .ai-share-buttons-{{ ai_gen_id }} {
      gap: 8px;
    }

    .ai-share-btn-{{ ai_gen_id }} {
      min-width: 90px;
      padding: 10px 12px;
      font-size: 13px;
    }
  }
{% endstyle %}

<share-product-{{ ai_gen_id }} class="ai-share-product-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h3 class="ai-share-header-{{ ai_gen_id }}">{{ block.settings.section_title }}</h3>

  <div class="ai-share-buttons-{{ ai_gen_id }}">
    <button class="ai-share-btn-{{ ai_gen_id }} share-native" aria-label="Share product">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
      <span>Share</span>
    </button>

    <a 
      href="https://wa.me/?text=Check%20out%20this%20product%20from%20Lush%20Beauty%20Mart%3A%20{{ product.title | url_encode }}%20{{ shop.url }}{{ product.url | url_encode }}"
      target="_blank"
      rel="noopener noreferrer"
      class="ai-share-btn-{{ ai_gen_id }} whatsapp"
      aria-label="Share on WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
      <span>WhatsApp</span>
    </a>

    <div class="ai-copy-feedback-wrapper-{{ ai_gen_id }}">
      <button class="ai-share-btn-{{ ai_gen_id }} copy-link" aria-label="Copy product link">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
        <span>Copy Link</span>
      </button>
      <div class="ai-share-feedback-{{ ai_gen_id }}">Link Copied!</div>
    </div>
  </div>
</share-product-{{ ai_gen_id }}>

<script>
  (function() {
    class ShareProduct{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.shareButton = this.querySelector('.share-native');
        this.copyButton = this.querySelector('.copy-link');
        this.feedback = this.querySelector('.ai-share-feedback-{{ ai_gen_id }}');

        this.setupShare();
        this.setupCopyLink();
      }

      setupShare() {
        if (!navigator.share) {
          this.shareButton.style.display = 'none';
          return;
        }

        this.shareButton.addEventListener('click', async () => {
          try {
            const productTitle = document.querySelector('.product__title, h1[itemprop="name"]')?.textContent.trim() || '{{ product.title }}';
            const productUrl = window.location.href;

            await navigator.share({
              title: productTitle,
              text: 'Check out this product from Lush Beauty Mart',
              url: productUrl
            });
          } catch (error) {
            if (error.name !== 'AbortError') {
              console.error('Share failed:', error);
            }
          }
        });
      }

      setupCopyLink() {
        this.copyButton.addEventListener('click', () => {
          const productUrl = window.location.href;

          navigator.clipboard.writeText(productUrl).then(() => {
            this.showFeedback();
          }).catch(() => {
            const textArea = document.createElement('textarea');
            textArea.value = productUrl;
            textArea.style.position = 'fixed';
            textArea.style.left = '-9999px';
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
            this.showFeedback();
          });
        });
      }

      showFeedback() {
        this.feedback.classList.add('show');
        setTimeout(() => {
          this.feedback.classList.remove('show');
        }, 1500);
      }
    }

    customElements.define('share-product-{{ ai_gen_id }}', ShareProduct{{ ai_gen_id }});
  })();
</script>

